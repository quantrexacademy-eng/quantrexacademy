# Copy to .env locally. Never commit real values.
# Production: set the same names as Firebase Functions env / secrets.
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
# Website + Android app both call https://www.quantrexacademy.com/api/*

SITE_URL=https://www.quantrexacademy.com

# Razorpay — only KEY_ID is public (checkout). SECRET stays server-side.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Jovi (SpaceXAI / xAI) — server only
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Admin login API — server only
QX_ADMIN_PASSWORD=

# Optional Marks proxy (server only; students stay blocked)
MARKS_TOKEN=
MARKS_ADMIN_MIGRATE=
