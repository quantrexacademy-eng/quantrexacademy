lA0IlWsMv4qaMoupiu0w.original.fullsize.png?alt=media\"/><br/>", "isCorrect": null, "_id": "69de4f892ee0e063d92985b1"}, {"id": "0323d7", "text": "<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2FCwlULlKCZ7nKjVFUiu6TOsQoS1-IqApa5HTmc4rAhkE.original.fullsize.png?alt=media\"/><br/>", "isCorrect": null, "_id": "69de4f892ee0e063d92985b2"}], "questionLabels": []}, {"_id": "69de4f892ee0e063d92985b3", "type": "singleCorrect", "chapters": ["60ced5dd19d2aa2b78a3a78c"], "topics": ["60e2fbdc66f9ce3f243b5674"], "concepts": ["61ab77956fe44bfe0fe49845"], "question": {"text": "The peptide that gives positive ceric ammonium nitrate and carbylamine tests is:"}, "options": [{"id": "d5f3cb", "text": "<math><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi><mo>-</mo><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">p</mi></math>", "isCorrect": null, "_id": "69de4f892ee0e063d92985b4"}, {"id": "fd7f87", "text": "<math><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">p</mi><mo>-</mo><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi></math>", "isCorrect": null, "_id": "69de4f892ee0e063d92985b5"}, {"id": "e606de", "text": "<math><mi mathvariant=\"normal\">L</mi><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">s</mi><mo>-</mo><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">p</mi></math>", "isCorrect": null, "_id": "69de4f892ee0e063d92985b6"}, {"id": "ca6e5f", "text": "<math><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">r</mi><mo>-</mo><mi mathvariant=\"normal\">L</mi><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">s</mi></math>", "isCorrect": null, "_id": "69de4f892ee0e063d92985b7"}], "questionLabels": []}, {"_id": "69de4f892ee0e063d92985b8", "type": "singleCorrect", "chapters": ["60ced5dd19d2aa2b78a3a78c"], "topics": ["60e40fd6f1ef260f84ed1ea2"], "concepts": ["6117b608478ae845c43c6374"], "question": {"text": "Which one of the following statement is not true?"}, "options": [{"id": "ae0f72", "text": "Lactose contains&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#945;</mi><mo>-</mo></math>glycosidic linkage between&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>1</mn></msub></math>&nbsp;of galactose and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>4</mn></msub></math>&nbsp;of glucose", "isCorrect": null, "_id": "69de4f892ee0e063d92985b9"}, {"id": "68228c", "text": "Lactose is a reducing sugar and it gives Fehling&#39;s test.", "isCorrect": null, "_id": "69de4f892ee0e063d92985ba"}, {"id": "2d551d", "text": "Lactose&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><msub><mi mathvariant=\"normal\">C</mi><mn>11</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>22</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>11</mn></msub></mrow></mfenced></math>&nbsp;is a disaccharide and it contains&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn></math>&nbsp;hydroxyl groups.", "isCorrect": null, "_id": "69de4f892ee0e063d92985bb"}, {"id": "8e54f8", "text": "On acid hydrolysis, lactose gives one molecule of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">D</mi><mfenced><mo>+</mo></mfenced><mo>-</mo></math>glucose and one molecule of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">D</mi><mfenced><mo>+</mo></mfenced><mo>-</mo></math>galactose.", "isCorrect": null, "_id": "69de4f892ee0e063d92985bc"}], "questionLabels": []}, {"_id": "69de4f892ee0e063d92985bd", "type": "singleCorrect", "chapters": ["60ced5dd19d2aa2b78a3a78c"], "topics": ["60e2fb5766f9ce3f243b4f43"], "concepts": ["6162fc0b6ed13040ec855fc9"], "question": {"text": "<p>Given below are two statements: one is labelled as Assertion (A) and the other is labelled as Reason (R).</p><p><strong>Assertion (A):</strong> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math>-halocarboxylic acid on reaction with dil. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>NH</mi><mn>3</mn></msub></math> gives good yield of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math>-amino carboxylic acid whereas the yield of amines is very low when prepared from alkyl halides.</p><p><strong>Reason (R):</strong> Amino acids exist in zwitter ion form in aqueous medium.</p><p>In the light of the above statements, choose the correct answer from the options given below :</p>"}, "options": [{"id": "d17b59", "text": "Both (A) and (R) are correct and (R) is the correct explanation of (A).", "isCorrect": null, "_id": "69de4f892ee0e063d92985be"}, {"id": "b15220", "text": "Both (A) and (R) are correct but (R) is not the correct explanation of (A).", "isCorrect": null, "_id": "69de4f892ee0e063d92985bf"}, {"id": "43f3a0", "text": "(A) is correct but (R) is not correct.", "isCorrect": null, "_id": "69de4f892ee0e063d92985c0"}, {"id": "420b4f", "text": "(A) is not correct but (R) is correct.", "isCorrect": null, "_id": "69de4f892ee0e063d92985c1"}], "questionLabels": []}, {"_id": "69de4f892ee0e063d92985c2", "type": "singleCorrect", "chapters": ["60ced5dd19d2aa2b78a3a78c"], "topics": ["60e40fd6f1ef260f84ed1ea3"], "concepts": ["60e567fb499d1e49588fa034"], "question": {"text": "Hydrolysis of sucrose gives:"}, "options": [{"id": "bd3561", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>-</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><mo>(</mo><mo>+</mo><mo>)</mo><mo>-</mo></math> Glucose and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>-</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><mo>(</mo><mo>-</mo><mo>)</mo></math>-Fructose", "isCorrect": null, "_id": "69de4f892ee0e063d92985c3"}, {"id": "8adfe5", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>-</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><mo>(</mo><mo>+</mo><mo>)</mo><mo>-</mo></math> Glucose and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>-</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><mo>(</mo><mo>-</mo><mo>)</mo><mo>-</mo></math>Fructose", "isCorrect": null, "_id": "69de4f892ee0e063d92985c4"}, {"id": "1088cb", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>-</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><mo>(</mo><mo>-</mo><mo>)</mo></math>-Glucose and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>-</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><mo>(</mo><mo>-</mo><mo>)</mo></math>-Fructose", "isCorrect": null, "_id": "69de4f892ee0e063d92985c5"}, {"id": "2ec230", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>-</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><mo>(</mo><mo>-</mo><mo>)</mo><mo>-</mo><mi>Glucose</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>-</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><mo>(</mo><mo>+</mo><mo>)</mo></math>-Fructose", "isCorrect": null, "_id": "69de4f892ee0e063d92985c6"}], "questionLabels": []}, {"_id": "69de4f892ee0e063d92985c7", "type": "singleCorrect", "chapters": ["60ced5dd19d2aa2b78a3a78c"], "topics": ["60e2fb9e66f9ce3f243b52f1"], "concepts": ["60e567dd499d1e49588f9cc9"], "question": {"text": "The carbohydrate \"Ribose\" present in DNA, is\nA. A pentose sugar\nB. present in pyranose from\nC. in \"D\" configuration\nD. a reducing sugar, when free\nE. in $\\propto$-anomeric form\nChoose the correct answer from the options given below:"}, "options": [{"id": "dcbd9f", "text": "A, D and E Only", "isCorrect": null, "_id": "69de4f892ee0e063d92985c8"}, {"id": "92bd