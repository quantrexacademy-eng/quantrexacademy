isCorrect": null, "_id": "69de4f8f2ee0e063d929dd4b"}, {"id": "ccfa24", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>1</mn></math>", "isCorrect": null, "_id": "69de4f8f2ee0e063d929dd4c"}], "questionLabels": []}, {"_id": "69de4f8f2ee0e063d929dd4d", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e5678e499d1e49588f927a"], "concepts": ["60e567fa499d1e49588fa01b"], "question": {"text": "The acceleration due to gravity at height <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi></math> above the earth if&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mo>&#8810;</mo><mi>R</mi></math> (Radius of earth) is given by"}, "options": [{"id": "81bb3d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>g</mi><mo>'</mo></msup><mo>=</mo><mi>g</mi><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><msup><mi>h</mi><mn>2</mn></msup><mrow><mn>2</mn><msup><mi>R</mi><mn>2</mn></msup></mrow></mfrac></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f8f2ee0e063d929dd4e"}, {"id": "85195b", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>g</mi><mo>'</mo></msup><mo>=</mo><mi mathvariant=\"normal\">g</mi><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mi mathvariant=\"normal\">h</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">R</mi></mrow></mfrac></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f8f2ee0e063d929dd4f"}, {"id": "8bcf4e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>g</mi><mo>'</mo></msup><mo>=</mo><mi mathvariant=\"normal\">g</mi><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">h</mi></mrow><mi mathvariant=\"normal\">R</mi></mfrac></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f8f2ee0e063d929dd50"}, {"id": "215160", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>g</mi><mo>'</mo></msup><mo>=</mo><mi>g</mi><mfenced>