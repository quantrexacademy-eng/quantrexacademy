sub><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>NH</mi><mn>2</mn></msub></math> is :"}, "options": [{"id": "d8136e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>NaBH</mi><mn>4</mn></msub></math>", "isCorrect": null, "_id": "69de4f712ee0e063d9286788"}, {"id": "4ab76e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CaH</mi><mn>2</mn></msub></math>", "isCorrect": null, "_id": "69de4f712ee0e063d9286789"}, {"id": "2df1d0", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>LiAlH</mi><mn>4</mn></msub></math>", "isCorrect": null, "_id": "69de4f712ee0e063d928678a"}, {"id": "8d21d3", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Na</mi><mo>(</mo><mi>CN</mi><mo>)</mo><msub><mi>BH</mi><mn>3</mn></msub></math>", "isCorrect": null, "_id": "69de4f712ee0e063d928678b"}], "questionLabels": []}, {"_id": "69de4f712ee0e063d928678c", "type": "singleCorrect", "chapters": ["60ced3330e34b73944ddfafa"], "topics": ["60e2fbdd66f9ce3f243b5678"], "concepts": ["62516ab310d25f039b58cd6c"], "question": {"text": "<p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F9c493ace-f659-4360-8bdf-b559442abd14-362adc60-8a2a-4f68-9099-032632e613ea-image.png?alt=media\" style=\"width: 496px; height: 123px;\" /></p><p>Consider the above reaction, the compound &#39;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math>&#39; is</p>"}, "options": [{"id": "44f60b", "text": "<p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Fcc044442-fd5d-4836-a295-5dedbbabc086-image.png?alt=media\" style=\"width: 172px; height: 120px;\" /></p>", "isCorrect": null, "_id": "69de4f712ee0e063d928678d"}, {"id": "db902b", "text": "<p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebases