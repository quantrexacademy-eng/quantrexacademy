c36a88fd8ad"}, {"id": "ea4cf8", "text": "$2 \\mathrm{~V}$", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8ae"}, {"id": "8a6874", "text": "$4 \\mathrm{~V}$", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8af"}], "questionLabels": []}, {"_id": "69de4f02c677dc36a88fd8b0", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205a2"], "topics": ["60e2fada66f9ce3f243b475f"], "concepts": ["60e2fad966f9ce3f243b4715"], "question": {"text": "Proton <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">P</mi><mo>)</mo></math> and electron <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">e</mi><mo>)</mo></math> will have same de-Broglie wavelength when the ratio of their momentum is (assume, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>m</mi><mi>p</mi></msub><mo>=</mo><mn>1849</mn></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>m</mi><mi>e</mi></msub></math>)"}, "options": [{"id": "bfce34", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>1</mn></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8b1"}, {"id": "f2aa9d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>1849</mn></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8b2"}, {"id": "b5f412", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>43</mn></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8b3"}, {"id": "bbe8fb", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>43</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>1</mn></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8b4"}], "questionLabels": []}, {"_id": "69de4f02c677dc36a88fd8b5", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205a2"], "topics": ["60d2d1d1185d7a32fa320586"], "concepts": ["6117b5e3478ae845c43c5df8"], "question": {"text": "In a photoelectric effect experiment a light of frequency <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>5</mn></math> times the threshold frequency is made to fall on the surface of photosensitive material. Now if the frequency is halved and intensity is doubled, the number of photo electrons emitted will be:"}, "options": [{"id": "f130a6", "text": "Doubled", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8b6"}, {"id": "965bd0", "text": "Quadrupled", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8b7"}, {"id": "0a9080", "text": "Zero", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8b8"}, {"id": "9118dd", "text": "Halved", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8b9"}], "questionLabels": []}, {"_id": "69de4f02c677dc36a88fd8ba", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205a2"], "topics": ["60e2fada66f9ce3f243b475f"], "concepts": ["60e2fad966f9ce3f243b4715"], "question": {"text": "A particle of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mi>M</mi></math> at rest disintegrates into two particles of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>M</mi></math>, respectively, having non zero velocities. The ratio of de-Broglie wavelength of particle of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math> to that of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>M</mi></math> will be:"}, "options": [{"id": "749518", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>:</mo><mn>3</mn></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8bb"}, {"id": "a57568", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>:</mo><mn>1</mn></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8bc"}, {"id": "4c5165", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>:</mo><msqrt><mn>3</mn></msqrt></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8bd"}, {"id": "51d9e4", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>:</mo><mn>1</mn></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8be"}], "questionLabels": []}, {"_id": "69de4f02c677dc36a88fd8bf", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205a2"], "topics": ["60d2d1d1185d7a32fa320586"], "concepts": ["60e2fb1e66f9ce3f243b4b10"], "question": {"text": "A <math><mn>2</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">W</mi></math> laser operates at a wavelength of <math><mi>&#160;</mi><mn>500</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">m</mi></math> . The number of photons that will be emitted per second is:<br />[Given Planck&#39;s constant <math><mi mathvariant=\"normal\">h</mi><mo>=</mo><mn>6.6</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>34</mn></mrow></msup><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">J</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">s</mi><mo>,</mo></math> speed of light <math><mi>&#160;</mi><mi mathvariant=\"normal\">c</mi><mo>=</mo><mn>3.0</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>8</mn></mrow></msup><mi mathvariant=\"normal\">&#160;</mi><mrow><mrow><mi mathvariant=\"normal\">m</mi></mrow><mo>/</mo><mrow><mi mathvariant=\"normal\">s</mi></mrow></mrow></math> ]"}, "options": [{"id": "7e8fb5", "text": "<math><mn>1.5</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>16</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8c0"}, {"id": "640651", "text": "<math><mn>5</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>15</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f02c677dc36a88fd8c1"}, {"id": "84be60", "text": "<math><mn>2</mn><mo>×</mo><msup><mrow><mn>10</mn><