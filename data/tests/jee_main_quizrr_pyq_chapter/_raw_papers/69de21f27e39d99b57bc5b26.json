up></math>", "isCorrect": null, "_id": "69de4f722ee0e063d9286d85"}, {"id": "6d5b24", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>[</mo><mi>Kr</mi><mo>]</mo><mn>4</mn><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">d</mi></mrow><mn>10</mn></msup><mn>5</mn><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></mrow><mn>2</mn></msup><mn>5</mn><msup><mi mathvariant=\"normal\">p</mi><mn>2</mn></msup></math>", "isCorrect": null, "_id": "69de4f722ee0e063d9286d86"}], "questionLabels": []}, {"_id": "69de4f722ee0e063d9286d87", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb1"], "topics": ["6162fb5a6ed13040ec84de88"], "concepts": ["6162fb716ed13040ec84ef73"], "question": {"text": "The incorrect postulates of the Dalton's atomic theory are :\n(A) Atoms of different elements differ in mass.\n(B) Matter consists of divisible atoms.\n(C) Compounds are formed when atoms of different element combine in a fixed ratio.\n(D) All the atoms of given element have different properties including mass.\n(E) Chemical reactions involve reorganisation of atoms.\nChoose the correct answer from the options given below :"}, "options": [{"id": "9305cb", "text": "(C), (D), (E) only", "isCorrect": null, "_id": "69de4f722ee0e063d9286d88"}, {"id": "a150e1", "text": "(B), (D) only", "isCorrect": null, "_id": "69de4f722ee0e063d9286d89"}, {"id": "8449c1", "text": "(A), (B), (D) only", "isCorrect": null, "_id": "69de4f722ee0e063d9286d8a"}, {"id": "4147df", "text": "(B), (D), (E) only", "isCorrect": null, "_id": "69de4f722ee0e063d9286d8b"}], "questionLabels": []}, {"_id": "69de4f722ee0e063d9286d8c", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb1"], "topics": ["60e2fb5766f9ce3f243b4f49"], "concepts": ["6162fb756ed13040ec84f249"], "question": {"text": "Maximum number of electrons that can be accommodated in shell with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>=</mo><mn>4</mn></math> are:"}, "options": [{"id": "d1f13c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn></math>", "isCorrect": null, "_id": "69de4f722ee0e063d9286d8d"}, {"id": "f30ba1", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>32</mn></math>", "isCorrect": null, "_id": "69de4f722ee0e063d9286d8e"}, {"id": "36b39b", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn></math>", "isCorrect": null, "_id": "69de4f722ee0e063d9286d8f"}, {"id": "ab5847", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>72</mn></math>", "isCorrect": null, "_id": "69de4f722ee0e063d9286d90"}], "questionLabels": []}, {"_id": "69de4f722ee0e063d9286d91", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb1"], "topics": ["60e2fb2066f9ce3f243b4b78"], "concepts": ["6162fb766ed13040ec84f343"], "question": {"text": "For electron in ' 2 s ' and ' 2 p ' orbitals, the orbital angular momentum values, respectively are :"}, "options": [{"id": "7dfc68", "text": "$\\sqrt{2} \\frac{\\mathrm{~h}}{2 \\pi}$ and 0", "isCorrect": null, "_id": "69de4f722ee0e063d9286d92"}, {"id": "851035", "text": "$\\frac{\\mathrm{h}}{2 \\pi}$ and $\\sqrt{2} \\frac{\\mathrm{~h}}{2 \\pi}$", "isCorrect": null, "_id": "69de4f722ee0e063d9286d93"}, {"id": "b60b2f", "text": "0 and $\\sqrt{6} \\frac{\\mathrm{~h}}{2 \\pi}$", "isCorrect": null, "_id": "69de4f722ee0e063d9286d94"}, {"id": "3b81cc", "text": "0 and $\\sqrt{2} \\frac{\\mathrm{~h}}{2 \\pi}$", "isCorrect": null, "_id": "69de4f722ee0e063d9286d95"}], "questionLabels": []}, {"_id": "69de4f722ee0e063d9286d96", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb1"], "topics": ["60e2fada66f9ce3f243b478d"], "concepts": ["60e56768499d1e49588f8eee"], "question": {"text": "The orbital having two radial as well as two angular nodes is:"}, "options": [{"id": "d20f75", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mi mathvariant=\"normal\">d</mi></math>", "isCorrect": null, "_id": "69de4f722ee0e063d9286d97"}, {"id": "23209c", "