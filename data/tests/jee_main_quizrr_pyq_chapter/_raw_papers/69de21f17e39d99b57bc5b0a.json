up><mo>&#160;</mo><mi>kg</mi><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f132ee0e063d9234587"}, {"id": "151889", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>17</mn></mrow></msup><mo>&#160;</mo><mi>kg</mi><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f132ee0e063d9234588"}, {"id": "18e913", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>17</mn></mrow></msup><mo>&#160;</mo><mi>kg</mi><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f132ee0e063d9234589"}], "questionLabels": []}, {"_id": "69de4f132ee0e063d923458a", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205a2"], "topics": ["60e2fada66f9ce3f243b475f"], "concepts": ["60e40fd4f1ef260f84ed1e4c"], "question": {"text": "An electron of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> and a photon have same energy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi><mo mathvariant=\"italic\">.</mo></math>&nbsp;The ratio of wavelength of electron to that of photon is : (<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> being the velocity of light)"}, "options": [{"id": "457abb", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mi>c</mi></mfrac><msup><mfenced><mfrac><mrow><mn>2</mn><mi>m</mi></mrow><mi>E</mi></mfrac></mfenced><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></math>", "isCorrect": null, "_id": "69de4f132ee0e063d923458b"}, {"id": "a3302b", "text": "<math xmlns=\"http:/