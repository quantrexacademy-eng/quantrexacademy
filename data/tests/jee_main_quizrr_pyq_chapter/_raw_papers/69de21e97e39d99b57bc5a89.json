</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">h</mi></mrow><mrow><mn>0</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac12"}, {"id": "ac5447", "text": "<math><msup><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">h</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac13"}, {"id": "0436e0", "text": "<math><msup><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">h</mi></mrow><mrow><mn>0</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac14"}, {"id": "bfe640", "text": "<math><msup><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">h</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac15"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac16", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["6117b607478ae845c43c632f"], "question": {"text": "Match List - I with List - II.<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td>List - I</td>\t\t\t<td>&nbsp;</td>\t\t\t<td>List - II</td>\t\t</tr>\t\t<tr>\t\t\t<td>a</td>\t\t\t<td>Torque</td>\t\t\t<td>i</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>MLT</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>b</td>\t\t\t<td>Impulse</td>\t\t\t<td>ii</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>MT</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>c</td>\t\t\t<td>Tension</td>\t\t\t<td>iii</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>ML</mi><mn>2</mn></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">T</mi></mrow><mrow><mo>-</mo><mn>2</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>d</td>\t\t\t<td>Surface Tension</td>\t\t\t<td>iv</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>MLT</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math></td>\t\t</tr>\t</tbody></table><p>Choose the most appropriate answer from the option given below :</p>"}, "options": [{"id": "5fb5b6", "text": "(a)-(iii), (b)-(iv), (c)-(i), (d)-(ii)", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac17"}, {"id": "0dc81e", "text": "(a)-(iii), (b)-(i), (c)-(iv), (d)-(ii)", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac18"}, {"id": "45be9c", "text": "(a)-(i), (b)-(iii), (c)-(iv), (d)-(ii)", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac19"}, {"id": "301747", "text": "(a)-(ii), (b)-(i), (c)-(iv), (d)-(iii)", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac1a"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac1b", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e56812499d1e49588fa389"], "question": {"text": "In an electromagnetic system, the quantity representing the ratio of electric flux and magnetic flux has dimension of $\\mathrm{M}^{\\mathrm{P}} \\mathrm{L}^{\\mathrm{Q}} \\mathrm{T}^{\\mathrm{R}} \\mathrm{A}^{\\mathrm{S}}$, where value of ' Q ' and ' R ' are"}, "options": [{"id": "b4989c", "text": "$(3,-5)$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac1c"}, {"id": "61fe0e", "text": "$(-2,2)$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac1d"}, {"id": "b0fdf8", "text": "$(-2,1)$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac1e"}, {"id": "e2dae1", "text": "$(1,-1)$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac1f"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac20", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e2fb1f66f9ce3f243b4b1f"], "question": {"text": "The speed of a wave produced in water is given by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#957;</mi><mo>=</mo><msup><mi>&#955;</mi><mi>a</mi></msup><msup><mi>g</mi><mi>b</mi></msup><msup><mi>&#961;</mi><mi>c</mi></msup></math>. Where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#955;</mi><mo>,</mo><mo>&#160;</mo><mi>g</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#961;</mi></math> are wavelength of wave, acceleration due to gravity and density of water respectively. The values of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>,</mo><mo>&#160;</mo><mi>b</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> respectively, are"}, "options": [{"id": "8efd98", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>,</mo><mo>&#160;</mo><mo>-</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mn>0</mn></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac21"}, {"id": "26f788", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>,</mo><mo>&#160;</mo><mn>0</mn><mo>,</mo><mo>&#160;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac22"}, {"id": "ce592d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>,</mo><mo>&#160;</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mn>0</mn></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac23"}, {"id": "7e29f6", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>,</mo><mo>&#160;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>,</mo><mo>&#160;</mo><mn>0</mn></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac24"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac25", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["6117b607478ae845c43c632f"], "question": {"text": "An expression of energy density is given by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>u</mi><mo>=</mo><mfrac><mi>&#945;</mi><mi>&#946;</mi></mfrac><mi>sin</mi><mfenced><mfrac><mrow><mi>&#945;</mi><mi>x</mi></mrow><mrow><mi>k</mi><mi>t</mi></mrow></mfrac></mfenced></math>, where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>,</mo><mo>&#160;</mo><mi>&#946;</mi></math>&nbsp;are constants, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> is displacement, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi></math> is Boltzmann constant and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi></math> is the temperature. The dimensions of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi></math> will be"}, "options": [{"id": "43b71d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi>ML</mi><mn>2</mn></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">T</mi></mrow><mrow><mo>-</mo><mn>2</mn></mrow></msup><msup><mi>&#952;</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac26"}, {"id": "915833", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mn>0</mn></msup><msup><mi mathvariant=\"normal\">L</mi><mn>2</mn></msup><msup><mi mathvariant=\"normal\">T</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac27"}, {"id": "57fa64", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mn>0</mn></msup><msup><mi mathvariant=\"normal\">L</mi><mn>0</mn></msup><msup><mi mathvariant=\"normal\">T</mi><mn>0</mn></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac28"}, {"id": "01cb14", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mn>0</mn></msup><msup><mi mathvariant=\"normal\">L</mi><mn>2</mn></msup><msup><mi mathvariant=\"normal\">T</mi><mn>0</mn></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac29"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac2a", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e56812499d1e49588fa389"], "question": {"text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>P</mi><mo>+</mo><mfrac><mi>a</mi><msup><mi>V</mi><mn>2</mn></msup></mfrac></mrow></mfenced><mfenced><mrow><mi>V</mi><mo>-</mo><mi>b</mi></mrow></mfenced><mo>=</mo><mi>R</mi><mi>T</mi></math> represents the equation of state of some gases. Where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math> is the pressure, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>V</mi></math> is the volume, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi></math> is the temperature and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>,</mo><mo>&#160;</mo><mi>b</mi><mo>,</mo><mo>&#160;</mo><mi>R</mi></math> are the constants. The physical quantity, which has dimensional formula as that of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msup><mi>b</mi><mn>2</mn></msup><mi>a</mi></mfrac></math>&nbsp;, will be :"}, "options": [{"id": "6810f0", "text": "Bulk modulus", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac2b"}, {"id": "8b70b2", "text": "Modulus of rigidity", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac2c"}, {"id": "a96115", "text": "Compressibility", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac2d"}, {"id": "2e8527", "text": "Energy density", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac2e"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac2f", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e2fb1f66f9ce3f243b4b1f"], "question": {"text": "What is the dimensional formula of $a b^{-1}$ in the equation $\\left(\\mathrm{P}+\\frac{\\mathrm{a}}{\\mathrm{V}^2}\\right)(\\mathrm{V}-\\mathrm{b})=\\mathrm{RT}$, where letters have their usual meaning."}, "options": [{"id": "6b6074", "text": "$\\left[\\mathrm{M}^{-1} \\mathrm{~L}^5 \\mathrm{~T}^3\\right]$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac30"}, {"id": "c731b4", "text": "$\\left[\\mathrm{M}^6 \\mathrm{~L}^7 \\mathrm{~T}^4\\right]$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac31"}, {"id": "25eafd", "text": "$\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-2}\\right]$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac32"}, {"id": "9e21fe", "text": "$\\left[\\mathrm{M}^0 \\mathrm{~L}^3 \\mathrm{~T}^{-2}\\right]$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac33"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac34", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["6117b607478ae845c43c632f"], "question": {"text": "&nbsp;The quantities <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><msqrt><msub><mi>&#956;</mi><mn>0</mn></msub><msub><mo>&#8712;</mo><mn>0</mn></msub></msqrt></mfrac><mo>,</mo><mi>y</mi><mo>=</mo><mfrac><mi>E</mi><mi>B</mi></mfrac></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>=</mo><mfrac><mi>l</mi><mrow><mi>C</mi><mi>R</mi></mrow></mfrac></math> are defined where C-capacitance, R-Resistance, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#8467;</mi><mo>-</mo></math>length, E-Electric field, B-magnetic field and<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8712;</mo><mn>0</mn><mo>,</mo><mo>&#160;</mo><mi>&#956;</mi><mn>0</mn><mo>,</mo><mo>-</mo></math>free space permittivity and permeability respectively. Then:"}, "options": [{"id": "127d29", "text": "x, y and z have the same dimension.", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac35"}, {"id": "73899a", "text": "Only x and z have the same dimension", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac36"}, {"id": "be7b50", "text": "Only x and y have the same dimension", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac37"}, {"id": "4816b6", "text": "Only y and z have the same dimension.", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac38"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac39", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e56812499d1e49588fa389"], "question": {"text": "If force (F), length (L) and time (T) are taken as the fundamental quantities. Then what will be the dimension of density:"}, "options": [{"id": "33b957", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi>FL</mi><mrow><mo>-</mo><mn>4</mn></mrow></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">T</mi></mrow><mn>2</mn></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac3a"}, {"id": "1fcd79", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi>FL</mi><mrow><mo>-</mo><mn>3</mn></mrow></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">T</mi></mrow><mn>3</mn></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac3b"}, {"id": "7a9d6a", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi>FL</mi><mrow><mo>-</mo><mn>3</mn></mrow></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">T</mi></mrow><mn>2</mn></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac3c"}, {"id": "cb4a7a", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\"><mrow><msup><mi>FL</mi><mrow><mo>-</mo><mn>5</mn></mrow></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">T</mi></mrow><mn>2</mn></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac3d"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac3e", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e2fb1f66f9ce3f243b4b1f"], "question": {"text": "The dimension of mutual inductance is"}, "options": [{"id": "6d1f3c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>ML</mi><mn>2</mn></msup><msup><mi mathvariant=\"normal\">T</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup><msup><mi mathvariant=\"normal\">A</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac3f"}, {"id": "51715e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>ML</mi><mn>2</mn></msup><msup><mi mathvariant=\"normal\">T</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup><msup><mi mathvariant=\"normal\">A</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac40"}, {"id": "54dcec", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>ML</mi><mn>2</mn></msup><msup><mi mathvariant=\"normal\">T</mi><mrow><mo>-</mo><mn>3</mn></mrow></msup><msup><mi mathvariant=\"normal\">A</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac41"}, {"id": "8c19a6", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>ML</mi><mn>2</mn></msup><msup><mi mathvariant=\"normal\">T</mi><mrow><mo>-</mo><mn>3</mn></mrow></msup><msup><mi mathvariant=\"normal\">A</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac42"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac43", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["6117b607478ae845c43c632f"], "question": {"text": "Match List - I with List - II.\n<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2FQi3LXFkvEaW9b7_GVVMkdeJK96g4i7e8hb3MCDlb2Cg.original.fullsize.png?alt=media\"/><br/>"}, "options": [{"id": "319e49", "text": "(A)-(II), (B)-(I), (C)-(IV), (D)-(III)", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac44"}, {"id": "2df667", "text": "(A)-(I), (B)-(III), (C)-(IV), (D)-(II)", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac45"}, {"id": "8264ef", "text": "(A)-(III), (B)-(I), (C)-(II), (D)-(IV)", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac46"}, {"id": "531fd4", "text": "(A)-(III), (B)-(I), (C)-(IV), (D)-(II)", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac47"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac48", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e56812499d1e49588fa389"], "question": {"text": "In an electromagnetic system, a quantity defined as the ratio of electric dipole moment and magnetic dipole moment has dimension of $\\left[M^P L^{\\circ} \\mathrm{T}^{\\mathrm{R}} \\mathrm{A}^{\\mathrm{S}}\\right]$. The value of P and Q are :"}, "options": [{"id": "d47463", "text": "$-1,0$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac49"}, {"id": "0baf7d", "text": "$-1,1$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac4a"}, {"id": "bbaced", "text": "$1,-1$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac4b"}, {"id": "6f9a70", "text": "$0,-1$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac4c"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac4d", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e2fb1f66f9ce3f243b4b1f"], "question": {"text": "In <math><mi>&#160;</mi><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">I</mi></math> units, the dimensions of <math><msqrt><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">&#1013;</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">&#956;</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac></msqrt></math> is:"}, "options": [{"id": "5aba20", "text": "<math><mi> </mi><mi mathvariant=\"normal\">A</mi><msup><mrow><mi mathvariant=\"normal\">T</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">M</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac4e"}, {"id": "943cd0", "text": "<math><msup><mrow><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">T</mi></mrow><mrow><mn>3</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">M</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mo>-</mo><mn>2</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac4f"}, {"id": "ca5f00", "text": "<math><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">M</mi><msup><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mn>3</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac50"}, {"id": "699e71", "text": "<math><mi mathvariant=\"normal\">A</mi><msup><mrow><mi mathvariant=\"normal\">T</mi></mrow><mrow><mo>-</mo><mn>3</mn></mrow></msup><mi mathvariant=\"normal\">M</mi><msup><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac51"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac52", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["6117b607478ae845c43c632f"], "question": {"text": "The de-Broglie wavelength associated with a particle of mass $m$ and energy $E$ is $h / \\sqrt{2 m E}$. The dimensional formula for Planck's constant is :"}, "options": [{"id": "f00f08", "text": "$\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-1}\\right]$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac53"}, {"id": "f25cf1", "text": "$\\left[\\mathrm{ML}^{-1} \\mathrm{~T}^{-2}\\right]$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac54"}, {"id": "1692a0", "text": "$\\left[\\mathrm{MLT}^{-2}\\right]$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac55"}, {"id": "c864c9", "text": "$\\left[\\mathrm{M}^2 \\mathrm{~L}^2 \\mathrm{~T}^{-2}\\right]$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac56"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac57", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e56812499d1e49588fa389"], "question": {"text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>,</mo><mo>&#160;</mo><msub><mi>X</mi><mi>L</mi></msub><mo>&#160;</mo><mtext>and</mtext><mo>&#160;</mo><msub><mi>X</mi><mi>C</mi></msub></math> represent resistance, inductive reactance and capacitive reactance. Then which of the following is dimensionless:"}, "options": [{"id": "4a0202", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>&#160;</mo><msub><mi>X</mi><mi>L</mi></msub><mo>&#160;</mo><msub><mi>X</mi><mi>C</mi></msub><mo>&#160;</mo><mo>&#160;</mo></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac58"}, {"id": "6b52c1", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>R</mi><msqrt><msub><mi>X</mi><mi>L</mi></msub><msub><mi>X</mi><mi>c</mi></msub></msqrt></mfrac></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac59"}, {"id": "41884f", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>R</mi><mrow><msub><mi>X</mi><mi>L</mi></msub><msub><mi>X</mi><mi>c</mi></msub></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac5a"}, {"id": "4340b7", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mfrac><msub><mi>X</mi><mi>L</mi></msub><msub><mi>X</mi><mi>c</mi></msub></mfrac></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac5b"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac5c", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e2fb1f66f9ce3f243b4b1f"], "question": {"text": "A quantity <math><mi>f</mi></math> is given by <math><mi>f</mi><mo>=</mo><msqrt><mfrac><mrow><mi>h</mi><msup><mrow><mi>c</mi></mrow><mrow><mn>5</mn></mrow></msup></mrow><mrow><mi>G</mi></mrow></mfrac></msqrt></math> where <math><mi>c</mi></math> is speed of light, <math><mi>G</mi></math> univasal gravitational constant and <math><mi>h</mi></math> is the Planck&rsquo;s constant. Dimension of <math><mi>f</mi></math> is that of:"}, "options": [{"id": "2df5d5", "text": "area", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac5d"}, {"id": "271e73", "text": "energy", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac5e"}, {"id": "2ec875", "text": "momentum", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac5f"}, {"id": "4ac316", "text": "volume", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac60"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac61", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["6117b607478ae845c43c632f"], "question": {"text": "In a typical combustion engine the workdone by a gas molecule is given by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>W</mi><mo>=</mo><msup><mi>&#945;</mi><mn>2</mn></msup><mi>&#946;</mi><msup><mi>e</mi><mfrac><mrow><mo>-</mo><mi>&#946;</mi><msup><mi>x</mi><mn>2</mn></msup></mrow><mrow><mi>k</mi><mo>&#160;</mo><mi>T</mi></mrow></mfrac></msup></math>, where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> is the displacement, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi></math> is the Boltzmann constant and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi></math> is the temperature. If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi></math> are constants, dimensions of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math> will be:"}, "options": [{"id": "ebbf01", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><msup><mi>MLT</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac62"}, {"id": "60eed4", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mn>2</mn></msup><msup><mi>LT</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac63"}, {"id": "f58a62", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><msup><mi>MLT</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac64"}, {"id": "44d1ac", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mn>0</mn></msup><msup><mi>LT</mi><mn>0</mn></msup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac65"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac66", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e2fb1f66f9ce3f243b4b1f"], "question": {"text": "Identify the pair of physical quantities that have same dimensions:"}, "options": [{"id": "97d84e", "text": "Velocity gradient and decay constant", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac67"}, {"id": "33da77", "text": "Angular frequency and angular momentum", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac68"}, {"id": "455771", "text": "Wave number and Avogadro number", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac69"}, {"id": "dd9a24", "text": "Wein&#39;s constant and Stephan&#39;s constant", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac6a"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac6b", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["6117b607478ae845c43c632f"], "question": {"text": "The force of interaction between two atoms is given by $F=\\alpha \\beta \\exp \\left(-\\frac{x^{2}}{\\alpha k T}\\right) ;$ where $x$ is the distance, $\\mathrm{k}$ is the\n\nBoltzmann constant and T is temperature and $\\alpha$ and $\\beta$ are two constants. The dimensions of $\\beta$ is:"}, "options": [{"id": "3c9703", "text": "$\\mathrm{M}^{0} \\mathrm{~L}^{2} \\mathrm{~T}^{-4}$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac6c"}, {"id": "bbb041", "text": "$\\mathrm{M}^{2} \\mathrm{LT}^{-4}$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac6d"}, {"id": "9af19b", "text": "$\\mathrm{MLT}^{-2}$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac6e"}, {"id": "25c548", "text": "$\\mathrm{M}^{2} \\mathrm{~L}^{2} \\mathrm{~T}^{-2}$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac6f"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac70", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["60e2fb1f66f9ce3f243b4b1f"], "question": {"text": "The equation of stationary wave is :\n$y=2 a \\sin \\left(\\frac{2 \\pi n t}{\\lambda}\\right) \\cos \\left(\\frac{2 \\pi x}{\\lambda}\\right) \\text {. }$\nWhich of the following is NOT correct :"}, "options": [{"id": "b46b1a", "text": "The dimensions of $n / \\lambda$ is [T]", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac71"}, {"id": "f87328", "text": "The dimensions of $\\mathrm{n}$ is $\\left[\\mathrm{LT}^{-1}\\right]$", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac72"}, {"id": "7c4d08", "text": "The dimensions of $x$ is [L]", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac73"}, {"id": "a0b189", "text": "The dimensions of $\\mathrm{nt}$ is [L]", "isCorrect": null, "_id": "69de4f2e2ee0e063d924ac74"}], "questionLabels": []}, {"_id": "69de4f2e2ee0e063d924ac75", "type": "singleCorrect", "chapters": ["60e2fb2066f9ce3f243b4b86"], "topics": ["60e2fb1f66f9ce3f243b4b60"], "concepts": ["6117b607478ae845c43c632f"], "question": {"text": "The dimension of stopping potential <math><msub><mrow><mi>V</mi></mrow><mrow><mn>0</mn></mrow></msub></math> in photoelectric effect in units of Planck&rsquo;s constant &lsquo; <math><mi>h</mi></math> &rsquo;, speed of light &lsquo; <math><mi>c</mi></math> &rsquo; and Gravitational constant &lsquo; <math><mi>G</mi></math> &rsquo; and ampere <math><mi>A</mi></math> is:"}, "options": [{"id": "fbfcb1", "text": "<math><msup><mrow><mi>h</mi></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></msup><msup><mrow><mi>G</mi></mrow><mrow><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></msup><msup><mrow><mi>c</mi></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></msup><msup><mrow><mi>A</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f2e2ee0e063d924