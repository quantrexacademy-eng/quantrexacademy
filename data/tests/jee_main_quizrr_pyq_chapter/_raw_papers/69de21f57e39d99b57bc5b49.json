athML\"><msub><mi>CHCl</mi><mn>3</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><msub><mi>NH</mi><mn>2</mn></msub></math></td>\t\t\t<td>I</td>\t\t\t<td>Steam distillation</td>\t\t</tr>\t\t<tr>\t\t\t<td>(B)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>14</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>5</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>12</mn></msub></math></td>\t\t\t<td>II</td>\t\t\t<td>Differential<br />\t\t\textraction</td>\t\t</tr>\t\t<tr>\t\t\t<td>(C)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><msub><mi>NH</mi><mn>2</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math></td>\t\t\t<td>III</td>\t\t\t<td>Distillation</td>\t\t</tr>\t\t<tr>\t\t\t<td>(D)</td>\t\t\t<td>Organic compound in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math></td>\t\t\t<td>IV</td>\t\t\t<td>Fractional<br />\t\t\tdistillation</td>\t\t</tr>\t</tbody></table>"}, "options": [{"id": "c3c821", "text": "A-IV, B-I, C-III, D-II", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e408"}, {"id": "530733", "text": "A-III, B-IV, C-I, D-II", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e409"}, {"id": "75b0e2", "text": "A-II, B-I, C-III, D-IV", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e40a"}, {"id": "72bd62", "text": "A-III, B-I, C-IV, D-II", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e40b"}], "questionLabels": []}, {"_id": "69de4f6a2ee0e063d927e40c", "type": "singleCorrect", "chapters": ["60ced3330e34b73944ddfaf4"], "topics": ["60e2fada66f9ce3f243b4787"], "concepts": ["60e567c3499d1e49588f9950"], "question": {"text": "Match List I with List II\n\\(\\begin{array}{llll}\n\\text{List - I} & \\text{List - II} \\\\\n\\text{(Pair of compounds)} & \\text{(Isomerism)} \\\\\n\\text{(A) n-propanol and Isopropanol} & \\text{(I) Metamerism} \\\\\n\\text{(B) Methoxypropane and ethoxyethane} & \\text{(II) Chain Isomerism} \\\\\n\\text{(C) Propanone and propanal} & \\text{(III) Position Isomerism} \\\\\n\\text{(D) Neopentane and Isopentane} & \\text{(IV) Functional Isomerism} \\\\\n\\end{array}\\)\nChoose the correct answer from the options given below :"}, "options": [{"id": "007103", "text": "(A)-(II), (B)-(I), (C)-(IV), (D)-(III)", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e40d"}, {"id": "7e5713", "text": "(A)-(III), (B)-(I), (C)-(II), (D)-(IV)", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e40e"}, {"id": "9b2ad6", "text": "(A)-(I), (B)-(III), (C)-(IV), (D)-(II)", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e40f"}, {"id": "466e64", "text": "(A)-(III), (B)-(I), (C)-(IV), (D)-(II)", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e410"}], "questionLabels": []}, {"_id": "69de4f6a2ee0e063d927e411", "type": "singleCorrect", "chapters": ["60ced3330e34b73944ddfaf4"], "topics": ["60e2fbdc66f9ce3f243b5676"], "concepts": ["6162fbab6ed13040ec851a36"], "question": {"text": "In which pairs, the first ion is more stable than the second?<br /><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2FZNKObylp3vRoOkaX4D0E7J8wmU78WyBO1d8BWBM8dFY.original.fullsize.png?alt=media\"/><br/>"}, "options": [{"id": "6b6c0d", "text": "(B) & (D) only", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e412"}, {"id": "95c702", "text": "(A) & (B) only", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e413"}, {"id": "0ffe57", "text": "(B) & (C) only", "isCorrect": null, "_id": "69de4f6a2ee0e063d927e414"}, {"id": "dadff9", "text": "(A) & (C) only", "isCorrect": null, "_id": "69de4f6a2ee0e063d927