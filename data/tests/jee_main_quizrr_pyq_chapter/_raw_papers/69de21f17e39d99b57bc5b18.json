n></mtd></mtr></mtable></mrow></mtd></mtr></mtable></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2d2ee0e063d92499fd"}, {"id": "eed4ea", "text": "<math><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><mi mathvariant=\"normal\">A</mi></mtd><mtd><mi mathvariant=\"normal\">B</mi></mtd><mtd><mi mathvariant=\"normal\">Y</mi></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2d2ee0e063d92499fe"}, {"id": "55aa88", "text": "<math><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><mi mathvariant=\"normal\">A</mi></mtd><mtd><mi mathvariant=\"normal\">B</mi></mtd><mtd><mi mathvariant=\"normal\">Y</mi></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f2d2ee0e063d92499ff"}], "questionLabels": []}, {"_id": "69de4f2d2ee0e063d9249a00", "type": "singleCorrect", "chapters": ["60e2fadb66f9ce3f243b4798"], "topics": ["60e2fbdc66f9ce3f243b5670"], "concepts": ["6117b88f67dbe2603c3e80a9"], "question": {"text": "<p>Given below are two statements : one is labelled as Assertion A and the other is labelled as Reason R</p><p><strong>Assertion A</strong>: Photodiodes are used in forward bias usually for measuring the light intensity.</p><p><strong>Reason R:</strong> For a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mo>-</mo><mi>n</mi></math> junction diode, at applied voltage <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>V</mi></math> the current in the forward bias is more than the current in the reverse bias for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\"><msub><mi>V</mi><mi>z</mi></msub></mfenced><mo>&#62;</mo><mo>&#177;</mo><mi>V</mi><mo>&#8805;</mo><mfenced open=\"|\" close=\"|\"><msub><mi>V</mi><mn>0</mn></msub></mfenced></math>&nbsp;where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>V</mi><mn>0</mn></msub></math> is the threshold voltage and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>V</mi><mi>z</mi></msub></math> is the breakdown voltage.</p><p>In the light of the above statements, choose the correct answer from the options given below</p>"}, "options": [{"id": "e1add4", "text": "&nbsp;Both A and R are true and R&nbsp;is correct explanation A&nbsp;", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a01"}, {"id": "e482ec", "text": "Both A and R are true but R is NOT the correct explanation A", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a02"}, {"id": "4c726a", "text": "A is false but R is true", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a03"}, {"id": "87d313", "text": "A is true but R is false&nbsp;", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a04"}], "questionLabels": []}], "markingScheme": {"_id": "608283e223cf4b3ad8f125e6", "title": "JEE Single Correct", "correctAttempt": 4, "incorrectAttempt": -1, "createdAt": "2021-04-09T08:45:27.797Z", "updatedAt": "2021-07-05T05:39:15.785Z", "__v": 0, "updated_by": "6042252509c5bf34e8a2f178"}, "maximumAttemptLimit": 20, "linkedQuestions": [], "createdAt": "2026-04-14T14:29:01.089Z", "updatedAt": "2026-04-14T14:29:01.089Z", "__v": 0}, "position": 0, "_id": "69de4f2d2ee0e063d9249a5b"}, {"sectionId": {"_id": "69de4f2d2ee0e063d9249a56", "title": "Physics Numerical", "sectionType": "normal", "subject": "607018ee404ae53194e73d90", "questions": [{"_id": "69de4f2d2ee0e063d9249a30", "type": "numerical", "chapters": ["60e2fadb66f9ce3f243b4798"], "topics": ["60e2fada66f9ce3f243b4759"], "concepts": ["60e40fd4f1ef260f84ed1e39"], "question": {"text": "The circuit contains two diodes each with a forward resistance of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math> and with infinite reverse resistance. If the battery voltage is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math>, the current through the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>120</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math> resistance is _______ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>mA</mi></math><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Ffdf73a7a-e3b7-4811-b5f7-3482f83faf1d-image.png?alt=media\" style=\"width: 179px; height: 170px;\" /></p>"}, "options": [{"id": "e02e51", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a31"}, {"id": "505f7b", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a32"}, {"id": "2efb14", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a33"}, {"id": "433790", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a34"}], "questionLabels": []}, {"_id": "69de4f2d2ee0e063d9249a35", "type": "numerical", "chapters": ["60e2fadb66f9ce3f243b4798"], "topics": ["60e2fada66f9ce3f243b4759"], "concepts": ["60e2fb1f66f9ce3f243b4b1d"], "question": {"text": "<p>A <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mi mathvariant=\"normal\">V</mi></math> Zener diode along with a series resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> is connected across a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math> supply (as shown in the figure). If the maximum Zener current is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>25</mn><mo>&#160;</mo><mi>mA</mi></math>, then the minimum value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> will be _____&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#937;</mi></math>.</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F21f9da59-2641-4db6-9b82-354f5b5df9cb-image.png?alt=media\" style=\"width: 200px; height: 113px;\" /></p>"}, "options": [{"id": "e56e23", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a36"}, {"id": "b5ceea", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a37"}, {"id": "798cd9", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a38"}, {"id": "66d68b", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a39"}], "questionLabels": []}, {"_id": "69de4f2d2ee0e063d9249a3a", "type": "numerical", "chapters": ["60e2fadb66f9ce3f243b4798"], "topics": ["60e2fada66f9ce3f243b4759"], "concepts": ["60e2fad966f9ce3f243b470c"], "question": {"text": "<p>Two ideal diodes are connected in the network as shown in figure. The equivalent resistance between <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> is&nbsp;_____&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#937;</mi><mo>.</mo></math></p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F88936a04-311c-4f66-bd90-57e9192bb2f8-1.jpg?alt=media\" style=\"width: 307px; height: 172px;\" /></p>"}, "options": [{"id": "e61e2f", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a3b"}, {"id": "0979f8", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a3c"}, {"id": "2afb17", "text": "", "isCorrect": null, "_id": "69de4f2d2ee0e063d9249a3d"}, {"id": "cac222", "