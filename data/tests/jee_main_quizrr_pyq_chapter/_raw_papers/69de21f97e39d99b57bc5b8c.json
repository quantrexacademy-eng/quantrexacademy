ptions": [{"id": "28edf4", "text": "(A), (C), (E) only", "isCorrect": null, "_id": "69de4f0cc677dc36a8905876"}, {"id": "01a875", "text": "(B), (D), (E) only", "isCorrect": null, "_id": "69de4f0cc677dc36a8905877"}, {"id": "6aa671", "text": "(D) and (E) only", "isCorrect": null, "_id": "69de4f0cc677dc36a8905878"}, {"id": "bb8723", "text": "(A), (B), (D) only", "isCorrect": null, "_id": "69de4f0cc677dc36a8905879"}], "questionLabels": []}, {"_id": "69de4f0cc677dc36a890587a", "type": "singleCorrect", "chapters": ["60e2fadb66f9ce3f243b4797"], "topics": ["60e2fb9e66f9ce3f243b52f9"], "concepts": ["6162fbdf6ed13040ec853fff"], "question": {"text": "Chalcogen group elements are :"}, "options": [{"id": "d406dc", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Se</mi><mo>,</mo><mo>&#160;</mo><mi>Te</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Po</mi><mo>.</mo></math>", "isCorrect": null, "_id": "69de4f0cc677dc36a890587b"}, {"id": "6202a0", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">O</mi><mo>,</mo><mo>&#160;</mo><mi>Ti</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Po</mi><mo>.</mo></math>", "isCorrect": null, "_id": "69de4f0cc677dc36a890587c"}, {"id": "241548", "text": "Se, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Tb</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Pu</mi></math>.", "isCorrect": null, "_id": "69de4f0cc677dc36a890587d"}, {"id": "e5a33f", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">S</mi><mo>,</mo><mo>&#160;</mo><mi>Te</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Pm</mi></math>.", "isCorrect": null, "_id": "69de4f0cc677dc36a890587e"}], "questionLabels": []}, {"_id": "69de4f0cc677dc36a890587f", "type": "singleCorrect", "chapters": ["60e2fadb66f9ce3f243b4797"], "topics": ["60e2fada66f9ce3f243b478e"], "concepts": ["60d3035daf049203d853666f"], "question": 