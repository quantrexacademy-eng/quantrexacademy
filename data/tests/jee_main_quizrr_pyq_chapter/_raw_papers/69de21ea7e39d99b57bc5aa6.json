{"success": true, "message": "Test details sent successfully", "data": {"test": {"_id": "69de21ea7e39d99b57bc5aa6", "analysisVideoCdn": "yt", "exam": ["605dfcb2f226ac25a8bd5fef"], "ctype": null, "position": 0, "order": 12, "enableCalculator": false, "isContinuousQuestion": false, "reattemptAvailable": false, "singleSectionMultipleSubjects": false, "timeRestricted": false, "title": "Rotational Motion - Test 2", "description": "Previous Year Questions as Chapter Test", "syllabus": "This test contains questions from all topics of this chapter included in the JEE Main syllabus. It includes a mix of questions from PYQs of JEE Main 2019 - 2025.", "totalTime": 50, "totalQuestions": 25, "totalMarks": 100, "bonusQuestions": null, "bonusMarks": null, "startDate": "2026-04-15T03:30:00.000Z", "endDate": "2027-04-30T00:00:00.000Z", "type": "free", "class": "605df635a37b7025c438d685", "instruction": "608289ffb160b022e9442c83", "subjects": [{"subjectId": "607018ee404ae53194e73d90", "totalMarks": 100, "bonusMarks": 0, "totalQuestions": 25, "bonusQuestions": 0, "_id": "69de4f3b2ee0e063d9255fbf"}], "sections": [{"sectionId": {"_id": "69de4f3b2ee0e063d9255f70", "title": "Physics Single Correct", "sectionType": "normal", "subject": "607018ee404ae53194e73d90", "questions": [{"_id": "69de4f3b2ee0e063d9255ef5", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0df82"], "topics": ["60e2fb1f66f9ce3f243b4b5c"], "concepts": ["6117b96d67dbe2603c3e9e09"], "question": {"text": "<p>Moment of inertia of a square plate of side <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi></math> about the axis passing through one of the corner and perpendicular to the plane of square plate is given by:</p>"}, "options": [{"id": "bb8534", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>M</mi><msup><mi>l</mi><mn>2</mn></msup></mrow><mn>6</mn></mfrac></math>", "isCorrect": null, "_id": "69de4f3b2ee0e063d9255ef6"}, {"id": "4af265", "text": "<math xmlns=\"http://www.w