.org/1998/Math/MathML\"><mn>2</mn></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b94c"}, {"id": "b5fda2", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b94d"}, {"id": "2bbfae", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b94e"}, {"id": "ff669f", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b94f"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b950", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e2fada66f9ce3f243b4772"], "concepts": ["6162fba46ed13040ec85155e"], "question": {"text": "The Lewis acid character of boron tri halides follows the order:"}, "options": [{"id": "e92f8f", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BCl</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>BF</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>BBr</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>Bl</mi><mn>3</mn></msub></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b951"}, {"id": "1ae33b", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Bl</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>BBr</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>BCl</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>BF</mi><mn>3</mn></msub></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b952"}, {"id": "9dbfcf", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BBr</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>Bl</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>BCl</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>BF</mi><