w.w3.org/1998/Math/MathML\"><mi>Si</mi><mo>-</mo><mi>Si</mi><mo>&#62;</mo><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi>Sn</mi><mo>-</mo><mi>Sn</mi><mo>&#62;</mo><mi>Ge</mi><mo>-</mo><mi>Ge</mi></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b90b"}, {"id": "72745b", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Si</mi><mo>-</mo><mi>Si</mi><mo>&#62;</mo><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi>Ge</mi><mo>-</mo><mi>Ge</mi><mo>&#62;</mo><mi>Sn</mi><mo>-</mo><mi>Sn</mi></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b90c"}, {"id": "da29ce", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi>Si</mi><mo>-</mo><mi>Si</mi><mo>&#62;</mo><mi>Sn</mi><mo>-</mo><mi>Sn</mi><mo>&#62;</mo><mi>Ge</mi><mo>-</mo><mi>Ge</mi></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b90d"}, {"id": "94a9ec", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi>Si</mi><mo>-</mo><mi>Si</mi><mo>&#62;</mo><mi>Ge</mi><mo>-</mo><mi>Ge</mi><mo>&#62;</mo><mi>Sn</mi><mo>-</mo><mi>Sn</mi></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b90e"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b90f", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e567ac499d1e49588f95f3"], "concepts": ["60e567ab499d1e49588f95e1"], "question": {"text": "The correct order of catenation is:"}, "options": [{"id": "18888c", "text": "<math><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">e</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">n</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">i</mi><mo>&gt;</mo><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\"> </mi></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b910"}, {"id": "ced94b", "text": "<math><mi mathvariant=\"normal\">C</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">n</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">i</mi><mo>≈</mo><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">e</mi></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b911"}, {"id": "90180a", "text": "<math><mi mathvariant=\"normal\">C</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">i</mi><mo>&gt;</mo><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">e</mi><mo>≈</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">n</mi></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b912"}, {"id": "e3ebe1", "text": "<math><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">i</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">n</mi><mo>&gt;</mo><mi mathvariant=\"normal\">C</mi><mo>&gt;</mo><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">e</mi></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b913"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b914", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e2fada66f9ce3f243b4772"], "concepts": ["60e2fb1f66f9ce3f243b4b51"], "question": {"text": "The incorrect statement about <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math> is :"}, "options": [{"id": "72d375", "text": "All <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>-</mo><mi mathvariant=\"normal\">H</mi><mo>-</mo><mi mathvariant=\"normal\">B</mi></math> angles are of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>120</mn><mo>&#176;</mo></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b915"}, {"id": "9794d3", "text": "The two <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>-</mo><mi mathvariant=\"normal\">H</mi><mo>-</mo><mi mathvariant=\"normal\">B</mi></math> bonds&nbsp;(bridged and terminal)&nbsp;are not of same length.", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b916"}, {"id": "2ddf6a", "text": "Terminal <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>-</mo><mi mathvariant=\"normal\">H</mi></math> bonds have less <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">p</mi></math> -character when compared to bridging bonds.", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b917"}, {"id": "8879f7", "text": "Its fragment, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BH</mi><mn>3</mn></msub><mo>,</mo></math>&nbsp;behaves as a Lewis acid.", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b918"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b919", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e2fb2066f9ce3f243b4b7c"], "concepts": ["60e567ab499d1e49588f95d7"], "question": {"text": "<p>Given below are two statements : one is labelled as Assertion (A) and the other is labelled as Reason (R).</p><p><strong>Assertion (A):</strong> In expensive scientific instruments, silica gel is kept in watch-glasses or in semipermeable membrane bags.</p><p><strong>Reason (R):</strong> Silica gel adsorbs moisture from air via adsorption, thus protects the instrument from water corrosion (rusting) and / or prevents malfunctioning.</p><p>In the light of the above statements, choose the correct answer from the options given below:</p>"}, "options": [{"id": "fbaec4", "text": "(A) is false but (R) is true", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b91a"}, {"id": "31afd2", "text": "(A) is true but (R) is false", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b91b"}, {"id": "e6e3fe", "text": "Both (A) and (R) are true and (R) is the correct explanation of (A)", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b91c"}, {"id": "130b98", "text": "Both (A) and (R) are true but (R) is not the correct explanation of (A)", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b91d"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b91e", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e2fb9e66f9ce3f243b52f2"], "concepts": ["60e2fbdc66f9ce3f243b5672"], "question": {"text": "Given below are two statements :</p><p>Statement I: Group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>13</mn></math> trivalent halides get easily hydrolysed by water due to their covalent nature.</p><p>Statement II: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>AlCl</mi><mn>3</mn></msub></math> upon hydrolysis in acidified aqueous solution forms octahedral <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Al</mi><msub><mfenced><mrow><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> ion.</p><p>In the light of the above statements, choose the correct answer from the options given below :"}, "options": [{"id": "93612e", "text": "Statement I is true but statement II is false", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b91f"}, {"id": "e685be", "text": "Statement I is false but statement II is true", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b920"}, {"id": "b8e667", "text": "Both statement I and statement II are false", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b921"}, {"id": "967360", "text": "Both statement I and statement II are true", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b922"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b923", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e567ac499d1e49588f95f3"], "concepts": ["60e567ab499d1e49588f95e1"], "question": {"text": "Match List - I with List - II.<br><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\"> <tbody> <tr> <td colspan=\"2\" rowspan=\"1\">List - I Compound</td> <td colspan=\"2\" rowspan=\"1\">List-II Use</td> </tr> <tr> <td>(A)</td> <td>Carbon tetrachloride</td> <td>(I)</td> <td>Paint remover</td> </tr> <tr> <td>(B)</td> <td>Methylene chloride</td> <td>(II)</td> <td>Refrigerators and air conditioners</td> </tr> <tr> <td>(C)</td> <td>DDT</td> <td>(III)</td> <td>Fire extinguisher</td> </tr> <tr> <td>(D)</td> <td>Freons</td> <td>(IV)</td> <td>Non Biodegradable insecticide</td> </tr> </tbody></table>Choose the correct answer from the options given below:"}, "options": [{"id": "c44322", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext> (A)-(I), (B), (II), (C)-(III), (D)-(IV) </mtext></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b924"}, {"id": "4de246", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext> (A)-(III), (B)-(I), (C)-(IV), (D)-( II) </mtext></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b925"}, {"id": "985d49", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext> (A)-(IV), (B)-(III), (C)-(II), (D)-(I) </mtext></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b926"}, {"id": "a78b1c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext> (A)-( II), (B)-(III), (C)-(I), (D)-(IV) </mtext></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b927"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b928", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e2fada66f9ce3f243b4772"], "concepts": ["6210e00e59c631201791ca0f"], "question": {"text": "<p>Identify the correct statement for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math> from those given below.</p><p>(A) In <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math>, all <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>-</mo><mi mathvariant=\"normal\">H</mi></math> bonds are equivalent.</p><p>(B) In <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math>, there are four <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math>-centre- <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>-electron bonds.</p><p>(C) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math> is a Lewis acid.</p><p>(D) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math> can be synthesized from both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BF</mi><mn>3</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>NaBH</mi><mn>4</mn></msub></math>.</p><p>(E) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math> is a planar molecule.</p><p>Choose the most appropriate answer from the options given below :</p>"}, "options": [{"id": "e4ef83", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">A</mi></mfenced></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">E</mi></mfenced></math>&nbsp;only", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b929"}, {"id": "0d349e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">B</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">E</mi></mfenced></math> only", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b92a"}, {"id": "5a3832", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">C</mi></mfenced></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">D</mi></mfenced></math>&nbsp;only", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b92b"}, {"id": "af336b", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">C</mi></mfenced></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">E</mi></mfenced></math>&nbsp;only", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b92c"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b92d", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e2fb2066f9ce3f243b4b7c"], "concepts": ["6162fba86ed13040ec85184d"], "question": {"text": "<p>Given below are two statements :</p><p>Statement I : The electronegativity of group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>14</mn></math> elements from <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Si</mi></math> to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Pb</mi></math> gradually decreases.</p><p>Statement II : Group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>14</mn></math> contains non-metallic, metallic, as well as metalloid elements.</p><p>In the light of the above statements, choose the most appropriate from the options given below :</p>"}, "options": [{"id": "33312e", "text": "Statement I is false but Statement II is true", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b92e"}, {"id": "f72fdf", "text": "Statement I is true but Statement II is false", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b92f"}, {"id": "bbe92a", "text": "Both Statement I and Statement II are true", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b930"}, {"id": "06112b", "text": " Both Statement I and Statement II are false", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b931"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b932", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e2fb9e66f9ce3f243b52f2"], "concepts": ["60e2fbdc66f9ce3f243b5672"], "question": {"text": "The correct statements from the following are :\n(A) The decreasing order of atomic radii of group 13 elements is \\(\\mathrm{Tl}>\\) In \\(>\\mathrm{Ga}>\\mathrm{Al}>\\mathrm{B}\\).\n(B) Down the group 13 electronegativity decreases from top to bottom.\n(C) \\(\\mathrm{Al}\\) dissolves in dil. \\(\\mathrm{HCl}\\) and liberates \\(\\mathrm{H}_2\\) but conc. \\(\\mathrm{HNO}_3\\) renders \\(\\mathrm{Al}\\) passive by forming a protective oxide layer on the surface.\n(D) All elements of group 13 exhibits highly stable +1 oxidation state.\n(E) Hybridisation of \\(\\mathrm{Al}\\) in \\(\\left[\\mathrm{Al}\\left(\\mathrm{H}_2 \\mathrm{O}\\right)_6\\right]^{3+}\\) ion is \\(\\mathrm{sp}^3 \\mathrm{~d}^2\\).\nChoose the correct answer from the options given below :"}, "options": [{"id": "e814c4", "text": "(A), (C) and (E) only", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b933"}, {"id": "b8533f", "text": "(A) and (C) only", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b934"}, {"id": "9ae0a5", "text": "(C) and (E) only", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b935"}, {"id": "a3e410", "text": "(A), (B), (C) and (E) only", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b936"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b937", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e567ac499d1e49588f95f3"], "concepts": ["60e567ab499d1e49588f95e1"], "question": {"text": "Given below are two statements:</p><p>Statement (I) : <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>SiO</mi><mn>2</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>GeO</mi><mn>2</mn></msub></math> are acidic while <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>SnO</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>PbO</mi></math> are amphoteric in nature.<br/>Statement (II) : Allotropic forms of carbon are due to property of catenation and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>pπ</mi><mo>-</mo><mi>dπ</mi></math> bond formation.</p><p>In the light of the above statements, choose the most appropriate answer from the options given below:"}, "options": [{"id": "08db09", "text": "Both Statement I and Statement II are false", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b938"}, {"id": "8b191f", "text": "Both Statement I and Statement II are true", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b939"}, {"id": "dddd7f", "text": "Statement I is true but Statement II is false", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b93a"}, {"id": "34733d", "text": "Statement I is true but Statement II is true", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b93b"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b93c", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e2fada66f9ce3f243b4772"], "concepts": ["6162fba46ed13040ec85155c"], "question": {"text": "Aqueous solution of which of the following boron compounds will be strongly basic in nature?"}, "options": [{"id": "8cd1e9", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>NaBH</mi><mn>4</mn></msub></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b93d"}, {"id": "ac5722", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>LiBH</mi><mn>4</mn></msub></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b93e"}, {"id": "acf7f4", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b93f"}, {"id": "717a90", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Na</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">B</mi><mn>4</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>7</mn></msub></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b940"}], "questionLabels": []}, {"_id": "69de4f2f2ee0e063d924b941", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205b3"], "topics": ["60e567ac499d1e49588f95f3"], "concepts": ["60e567ab499d1e49588f95e1"], "question": {"text": "Consider the oxides of group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>14</mn></math> elements <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mi>i</mi><msub><mi>O</mi><mn>2</mn></msub><mo>,</mo><mo> </mo><mi>G</mi><mi>e</mi><msub><mi>O</mi><mn>2</mn></msub><mo>,</mo><mo> </mo><mi>S</mi><mi>n</mi><msub><mi>O</mi><mn>2</mn></msub><mo>,</mo><mo> </mo><mi>P</mi><mi>b</mi><msub><mi>O</mi><mn>2</mn></msub><mo>,</mo><mo> </mo><mi>C</mi><mi>O</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>G</mi><mi>e</mi><mi>O</mi></math>. The amphoteric oxides are"}, "options": [{"id": "b7f75c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>GeO</mi><mo>,</mo><mo> </mo><msub><mi>GeO</mi><mn>2</mn></msub></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b942"}, {"id": "56c53e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>SiO</mi><mn>2</mn></msub><mo>,</mo><mo> </mo><msub><mi>GeO</mi><mn>2</mn></msub></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b943"}, {"id": "bb9526", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>SnO</mi><mn>2</mn></msub><mo>,</mo><mo> </mo><msub><mi>PbO</mi><mn>2</mn></msub></math>", "isCorrect": null, "_id": "69de4f2f2ee0e063d924b944"}, {"id": "23c899", "text": "