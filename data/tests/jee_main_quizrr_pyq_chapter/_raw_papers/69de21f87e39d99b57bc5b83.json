d2d1d2185d7a32fa3205c0"], "topics": ["60e2fb5766f9ce3f243b4f45"], "concepts": ["6117b96e67dbe2603c3e9e62"], "question": {"text": "The amphoteric oxide among $\\mathrm{V}_2 \\mathrm{O}_3, \\mathrm{~V}_2 \\mathrm{O}_4$ and $\\mathrm{V}_2 \\mathrm{O}_5$, upon reaction with alkali leads to formation of an oxide anion. The oxidation state of V in the oxide anion is :"}, "options": [{"id": "1ba8c5", "text": "$+3$", "isCorrect": null, "_id": "69de4f352ee0e063d925077a"}, {"id": "408510", "text": "$+4$", "isCorrect": null, "_id": "69de4f352ee0e063d925077b"}, {"id": "b8d478", "text": "$+7$", "isCorrect": null, "_id": "69de4f352ee0e063d925077c"}, {"id": "0f920a", "text": "$+5$", "isCorrect": null, "_id": "69de4f352ee0e063d925077d"}], "questionLabels": []}, {"_id": "69de4f352ee0e063d925077e", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205c0"], "topics": ["60e2fada66f9ce3f243b478a"], "concepts": ["617aaa05ef3fe65ad8e851e5"], "question": {"text": "The pair that has similar atomic radii is:"}, "options": [{"id": "7cd492", "text": "<math><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">o</mi></math> and <math><mi mathvariant=\"normal\">W</mi></math>", "isCorrect": null, "_id": "69de4f352ee0e063d925077f"}, {"id": "a2462c", "text": "<math><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">c</mi></math> and <math><mi mathvariant=\"normal\">N</mi><mi mathvariant=\"normal\">i</mi></math>", "isCorrect": null, "_id": "69de4f352ee0e063d9250780"}, {"id": "f2726b", "text": "<math><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">n</mi></math> and <math><mi mathvariant=\"normal\">R</mi><mi mathvariant=\"normal\">e</mi></math>", "isCorrect": null, "_id": "69de4f352ee0e063d9250781"}, {"id": "74d73a", "text": "<math><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">i</mi></math> and <math><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">f</mi></math>", "isCorrect": null, "_id": "69de4f352ee0e063d9250782"}], "questionLabels": []}, 