/www.w3.org/1998/Math/MathML\"><mi>II</mi></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(a)</td>\t\t\t<td><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Fd25a9af9-a4b5-4899-81c1-56eef1eec907-image.png?alt=media\" style=\"width: 312px; height: 79px;\" /></td>\t\t\t<td>(i)</td>\t\t\t<td>Wurtz reaction</td>\t\t</tr>\t\t<tr>\t\t\t<td>(b)</td>\t\t\t<td><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Fe8fe2604-80bb-4611-a19e-3d75e4eaad8e-image.png?alt=media\" style=\"width: 312px; height: 79px;\" /></td>\t\t\t<td>(ii)</td>\t\t\t<td>Sandmeyer reaction</td>\t\t</tr>\t\t<tr>\t\t\t<td>(c)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mi>Cl</mi><mo>+</mo><mn>2</mn><mi>Na</mi><mover><mo>&#10230;</mo><mi>Ether</mi></mover><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><mo>-</mo><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><mo>+</mo><mn>2</mn><mi>NaCl</mi></math></td>\t\t\t<td>(iii)</td>\t\t\t<td>Fittig reaction</td>\t\t</tr>\t\t<tr>\t\t\t<td>(d)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><mi>Cl</mi><mo>+</mo><mn>2</mn><mi>Na</mi><mover><mo>&#10230;</mo><mi>Ether</mi></mover><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><mo>-</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><mo>+</mo><mn>2</mn><mi>NaCl</mi></math></td>\t\t\t<td>(iv)</td>\t\t\t<td>Gatterman reaction</td>\t\t</tr>\t</tbody></table><p>Choose the correct answer from the options given below:</p>"}, "options": [{"id": "58a6d2", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">a</mi></mfenced><mo>&#8594;</mo><mfenced><mi>iii</mi></mfenced><mo>,</mo><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">b</mi></mfenced><mo>&#8594;</mo><mfenced><mi>iv</mi></mfenced><mo>,</mo><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">c</mi></mfenced><mo>&#8594;</mo><mfenced><mi mathvariant=\"normal\">i</mi></mfenced><mo>,</mo><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">d</mi></mfenced><mo>&#8594;</mo><mfenced><mi>ii</mi></mfenced></math>", "isCorrect": null, "_id": "69de4f3d5dcf815cd79d25d3"}, {"id": "b58337", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">a</mi></mfenced><mo>&#8594;</mo><mfenced><mi>ii</mi></mfenced><mo>,</mo><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">b</mi></mfenced><mo>&#8594;</mo><mfenced><mi mathvariant=\"normal\">i</mi></mfenced><mo>,</mo><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">c</mi></mfenced><mo>&#8594;</mo><mfenced><mi>iv</mi></mfenced><mo>,</mo><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">d</mi></mfenced><mo>&#8594;</mo><mfenced><mi>iii</mi></mfenced></math>", "isCorrect": null, "_id": "69de4f3d5dcf815cd79d25d4"}, {"id": "41bc1f", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">a</mi></mfenced><mo>&#8594;</mo><mfenced><mi>iii</mi></mfenced><mo>,</mo><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">b</mi></mfenced><mo>&#8594;</mo><mfenced><mi mathvariant=\"normal\">i</mi></mfenced><mo>,</mo><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">c</mi></mfenced><mo>&#8594;</mo><mfenced><mi>iv</mi></mfenced><mo>,</mo><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">d</mi></mfenced><mo>&#8594;</mo><mfenced><mi>ii</mi></mfenced></math>", "isCorrect": null, "_id": "69de4f3d5dcf815cd79d25d5"}, {"id": "d1ecb8", "text": "<math xmlns=\"http://www.w3.