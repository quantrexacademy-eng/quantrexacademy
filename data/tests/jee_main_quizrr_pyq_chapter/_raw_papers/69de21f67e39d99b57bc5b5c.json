\">J</mi><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mrow><mo>&#160;</mo><mi>mol</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>]</p>"}, "options": [{"id": "4fa82f", "text": "", "isCorrect": null, "_id": "69de4f97e3e37d7ebba3bccf"}, {"id": "ba3bdf", "text": "", "isCorrect": null, "_id": "69de4f97e3e37d7ebba3bcd0"}, {"id": "57a3dd", "text": "", "isCorrect": null, "_id": "69de4f97e3e37d7ebba3bcd1"}, {"id": "fb33b9", "text": "", "isCorrect": null, "_id": "69de4f97e3e37d7ebba3bcd2"}], "questionLabels": []}, {"_id": "69de4f97e3e37d7ebba3bcd3", "type": "numerical", "chapters": ["60c9e849ea076dc381c0df8c"], "topics": ["60e2fb2066f9ce3f243b4b70"], "concepts": ["6117b8e067dbe2603c3e8ad2"], "question": {"text": "<p>Data given for the following reaction is as follows :</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>FeO</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo></mrow></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mrow><mo>(</mo><mi>graphite</mi><mo>)</mo></mrow></msub><mo>&#10230;</mo><msub><mi>Fe</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo></mrow></msub><mo>+</mo><msub><mi>CO</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">g</mi><mo>)</mo></mrow></msub></math></p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>Substance</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#916;</mi><mi mathvariant=\"normal\">f</mi></msub><mi mathvariant=\"normal\">H</mi><mo>&#176;</mo><mfenced><msup><mi>kJmol</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></mfenced></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#916;</mi><mi mathvariant=\"normal\">S</mi><mo>&#176;</mo><mfenced><mrow><msup><mi>Jmol</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi></mrow><mrow><mo>-</mo><mn>1</mn></mro