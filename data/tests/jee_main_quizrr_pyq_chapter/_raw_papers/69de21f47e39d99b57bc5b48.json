n>3</mn></msub><msub><mi>COCH</mi><mn>3</mn></msub></mrow></mfenced></math> exists in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#60;</mo><mn>0</mn><mo>.</mo><mn>1</mn><mo>%</mo></math> quantity. However, the enol form of acetyl acetone <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\"><mrow><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>COCH</mi><mn>2</mn></msub><msub><mi>OCCH</mi><mn>3</mn></msub></mrow></mfenced></math> exists in approximately&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo>%</mo></math>quantity.</p><p>Reason R :&nbsp;enol form of acetyl acetone is stabilized by intramolecular hydrogen bonding, which is not possible in enol form of acetone.</p><p>Choose the correct statement:</p>"}, "options": [{"id": "ac1d08", "text": "A is false but R is true", "isCorrect": null, "_id": "69de4f682ee0e063d927bab2"}, {"id": "e3d56c", "text": "Both A&nbsp;and R&nbsp;are true and R&nbsp;is the correct explanation of A", "isCorrect": null, "_id": "69de4f682ee0e063d927bab3"}, {"id": "6e71ca", "text": "Both A&nbsp;and R&nbsp;are true but R&nbsp;is not the correct explanation of A", "isCorrect": null, "_id": "69de4f682ee0e063d927bab4"}, {"id": "8995ee", "text": "A is true but R&nbsp;is false", "isCorrect": null, "_id": "69de4f682ee0e063d927bab5"}], "questionLabels": []}, {"_id": "69de4f682ee0e063d927bab6", "type": "singleCorrect", "chapters": ["60ced3330e34b73944ddfaf4"], "topics": ["60e567fc499d1e49588fa045"], "concepts": ["6117b608478ae845c43c637b"], "question": {"text": "<p>Match items of column I and II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>Column I (Mixture of compounds)</td>\t\t\t<td>Column II (Separation Technique)</td>\t\t</tr>\t\t<tr>\t\t\t<td>A.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi><mo>/</mo><msub><mi>CH</mi><mn>2</mn