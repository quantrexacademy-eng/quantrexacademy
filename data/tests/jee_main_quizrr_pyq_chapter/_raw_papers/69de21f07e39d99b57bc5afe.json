{"success": true, "message": "Test details sent successfully", "data": {"test": {"_id": "69de21f07e39d99b57bc5afe", "analysisVideoCdn": "yt", "exam": ["605dfcb2f226ac25a8bd5fef"], "ctype": null, "position": 0, "order": 12, "enableCalculator": false, "isContinuousQuestion": false, "reattemptAvailable": false, "singleSectionMultipleSubjects": false, "timeRestricted": false, "title": "Ray Optics - Test 2", "description": "Previous Year Questions as Chapter Test", "syllabus": "This test contains questions from all topics of this chapter included in the JEE Main syllabus. It includes a mix of questions from PYQs of JEE Main 2019 - 2025.", "totalTime": 50, "totalQuestions": 25, "totalMarks": 100, "bonusQuestions": null, "bonusMarks": null, "startDate": "2026-04-15T03:30:00.000Z", "endDate": "2027-04-30T00:00:00.000Z", "type": "free", "class": "605df635a37b7025c438d685", "instruction": "608289ffb160b022e9442c83", "subjects": [{"subjectId": "607018ee404ae53194e73d90", "totalMarks": 100, "bonusMarks": 0, "totalQuestions": 25, "bonusQuestions": 0, "_id": "69de4f5d2ee0e063d9272b82"}], "sections": [{"sectionId": {"_id": "69de4f5d2ee0e063d9272b3d", "title": "Physics Single Correct", "sectionType": "normal", "subject": "607018ee404ae53194e73d90", "questions": [{"_id": "69de4f5d2ee0e063d9272ad5", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb5766f9ce3f243b4f3b"], "concepts": ["617aa9daef3fe65ad8e829f4"], "question": {"text": "<p>The light rays from an object have been reflected towards an observer from a standard flat mirror, the image observed by the observer are :-</p><p>A. Real</p><p>B. Erect</p><p>C. Smaller in size than object</p><p>D. Laterally inverted</p><p>Choose the most appropriate answer from the options given below:</p>"}, "options": [{"id": "4bf58d", "text": "B and D only", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ad6"}, {"id": "18a173", "text": "B and C only", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ad7"}, {"id": "4aff82", "text": "A and D only", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ad8"}, {"id": "075b89", "text": "A, C and D only", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ad9"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272ada", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb5766f9ce3f243b4f39"], "concepts": ["6162fb486ed13040ec84d13d"], "question": {"text": "<p>An object is placed beyond the centre of curvature <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math> of the given concave mirror. If the distance of the object is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>d</mi><mn>1</mn></msub></math> from <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math> and the distance of the image formed is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>d</mi><mn>2</mn></msub></math> from <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi><mo>,</mo></math> the radius of curvature of this mirror is:</p>"}, "options": [{"id": "acc489", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>1</mn></msub><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>2</mn></msub></mrow><mrow><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272adb"}, {"id": "493ef5", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>1</mn></msub><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>2</mn></msub></mrow><mrow><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>1</mn></msub><mo>-</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272adc"}, {"id": "f9fac3", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>d</mi><mn>1</mn></msub><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>2</mn></msub></mrow><mrow><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272add"}, {"id": "370bc3", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>d</mi><mn>1</mn></msub><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>2</mn></msub></mrow><mrow><msub><mrow><mo>&#160;</mo><mi>d</mi></mrow><mn>1</mn></msub><mo>-</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ade"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272adf", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fada66f9ce3f243b4756"], "concepts": ["60e56768499d1e49588f8eda"], "question": {"text": "A light wave travelling linearly in a medium of dielectric constant <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math>, incidents on the horizontal interface separating medium with air. The angle of incidence for which the total intensity of incident wave will be reflected back into the same medium will be :<br />(Given : relative permeability of medium <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#956;</mi><mi mathvariant=\"normal\">r</mi></msub><mo>=</mo><mn>1</mn></math>)"}, "options": [{"id": "bf3c74", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#176;</mo></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ae0"}, {"id": "e12d0f", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>&#176;</mo></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ae1"}, {"id": "afcd47", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>&#176;</mo></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ae2"}, {"id": "fd2a91", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>60</mn><mo>&#176;</mo></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ae3"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272ae4", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fbdc66f9ce3f243b5677"], "concepts": ["60e56739499d1e49588f8b4f"], "question": {"text": "At the interface between two materials having refractive indices \\(n_1\\) and \\(n_2\\), the critical angle for reflection of an em wave is \\(\\theta_{1 C}\\). The \\(n_2\\) material is replaced by another material having refractive index \\(n_3\\) such that the critical angle at the interface between \\(n_1\\) and \\(n_3\\) materials is \\(\\theta_{2 \\mathrm{C}}\\). If \\(\\mathrm{n}_3\\gt\\mathrm{n}_2\\gt\\mathrm{n}_1 ; \\frac{\\mathrm{n}_2}{\\mathrm{n}_3}=\\frac{2}{5}\\) and \\(\\sin \\theta_{2 \\mathrm{C}}-\\sin \\theta_{1 \\mathrm{C}}=\\frac{1}{2}\\), then \\(\\theta_{1 \\mathrm{C}}\\) is"}, "options": [{"id": "0d216b", "text": "\\(\\sin ^{-1}\\left(\\frac{1}{6}\\right)\\)", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ae5"}, {"id": "f0124f", "text": "\\(\\sin ^{-1}\\left(\\frac{1}{3}\\right)\\)", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ae6"}, {"id": "35a126", "text": "\\(\\sin ^{-1}\\left(\\frac{-5}{6}\\right)\\)", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ae7"}, {"id": "25e352", "text": "\\(\\sin ^{-1}\\left(\\frac{2}{3}\\right)\\)", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272ae8"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272ae9", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fada66f9ce3f243b4755"], "concepts": ["60e5678c499d1e49588f9250"], "question": {"text": "A point like object is placed at distance of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mi mathvariant=\"normal\">m</mi></math> in front of a convex lens of focal length&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>5</mn><mi mathvariant=\"normal\">m</mi></math>. A plane mirror is placed at a distance of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi mathvariant=\"normal\">m</mi></math> behind the lens. The position and nature of the image formed by the system is"}, "options": [{"id": "519f77", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>6</mn><mi mathvariant=\"normal\">m</mi></math> from the mirror, real", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272aea"}, {"id": "7b4e65", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mi mathvariant=\"normal\">m</mi></math> from the mirror, virtual", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272aeb"}, {"id": "fe61cf", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mi mathvariant=\"normal\">m</mi></math> from the mirror, real", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272aec"}, {"id": "5ea58b", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>6</mn><mi mathvariant=\"normal\">m</mi></math> from the mirror, virtual", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272aed"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272aee", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60da9b4f62f042332c538326"], "concepts": ["60e5678c499d1e49588f925c"], "question": {"text": "The refractive index of a prism with apex angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mi>o</mi><mi>t</mi><mfrac><mi>A</mi><mn>2</mn></mfrac></math>. The angle of minimum deviation is :"}, "options": [{"id": "5f5828", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>δ</mi><mi>m</mi></msub><mo>=</mo><mn>180</mn><mo>°</mo><mo>-</mo><mi>A</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272aef"}, {"id": "9c30ce", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>δ</mi><mi>m</mi></msub><mo>=</mo><mn>180</mn><mo>°</mo><mo>-</mo><mn>3</mn><mi>A</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272af0"}, {"id": "f8e425", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>δ</mi><mi>m</mi></msub><mo>=</mo><mn>180</mn><mo>°</mo><mo>-</mo><mn>4</mn><mi>A</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272af1"}, {"id": "1dd88c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>δ</mi><mi>m</mi></msub><mo>=</mo><mn>180</mn><mo>°</mo><mo>-</mo><mn>2</mn><mi>A</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272af2"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272af3", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fada66f9ce3f243b474f"], "concepts": ["60da9b4f62f042332c5382ed"], "question": {"text": "Calculate the limit of resolution of a telescope objective having a diameter of <math><mn>200</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi></math> , if it has to detect light of wavelength <math><mn>500</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">m</mi></math> coming from a star."}, "options": [{"id": "07c9d9", "text": "<math><mn>305</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>9</mn></mrow></msup></math> radian", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272af4"}, {"id": "3b6f16", "text": "<math><mn>610</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>9</mn></mrow></msup></math> radian", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272af5"}, {"id": "7e02f2", "text": "<math><mn>152.5</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>9</mn></mrow></msup></math> radian", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272af6"}, {"id": "5b6473", "text": "<math><mn>457.5</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>9</mn></mrow></msup></math> radian", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272af7"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272af8", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb9d66f9ce3f243b52e1"], "concepts": ["60e2fb9d66f9ce3f243b52a3"], "question": {"text": "A thin plano convex lens made of glass of refractive index 1.5 is immersed in a liquid of refractive index 1.2. When the plane side of the lens is silver coated for complete reflection, the lens immersed in the liquid behaves like a concave mirror of focal length 0.2 m . The radius of curvature of the curved surface of the lens is"}, "options": [{"id": "ae81d3", "text": "0.20 m", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272af9"}, {"id": "030ab7", "text": "0.25 m", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272afa"}, {"id": "205d17", "text": "0.15 m", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272afb"}, {"id": "183dd4", "text": "0.10 m", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272afc"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272afd", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb5766f9ce3f243b4f39"], "concepts": ["6176f3f76581241c7072b25c"], "question": {"text": "<p>Region <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi></math> are separated by a spherical surface of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>25</mn><mo>&#160;</mo><mi>cm</mi></math>. An object is kept in region <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi></math> at a distance of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>40</mn><mo>&#160;</mo><mi>cm</mi></math> from the surface. The distance of<br />the image from the surface is:</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F0ebb0c75-2365-45d1-84b7-85be025c1124-image.png?alt=media\" style=\"width: 328px; height: 170px;\" /></p>"}, "options": [{"id": "219b26", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>55</mn><mo>.</mo><mn>44</mn><mo>&#160;</mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272afe"}, {"id": "307848", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>.</mo><mn>52</mn><mo>&#160;</mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272aff"}, {"id": "e3f16a", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>18</mn><mo>.</mo><mn>23</mn><mo>&#160;</mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b00"}, {"id": "8905ea", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>37</mn><mo>.</mo><mn>58</mn><mo>&#160;</mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b01"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b02", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fada66f9ce3f243b4755"], "concepts": ["6162fb4c6ed13040ec84d408"], "question": {"text": "A person has been using spectacles of power&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>1</mn><mo>.</mo><mn>0</mn></math>&nbsp;diopter for distant vision and a separate reading glass of power <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>0</mn></math> diopters. What is the least distance of distinct vision for this person:"}, "options": [{"id": "879e71", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mn>10</mn><mo>&#160;</mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b03"}, {"id": "6c26bf", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>40</mn><mo>&#160;</mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b04"}, {"id": "4fb1d3", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>&#160;</mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b05"}, {"id": "08d76d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn><mo>&#160;</mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b06"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b07", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60da9b4f62f042332c538326"], "concepts": ["60e2fbdc66f9ce3f243b565e"], "question": {"text": "Which of the following statement is correct?"}, "options": [{"id": "f306bc", "text": "In primary rainbow, observer sees red colour on the top and violet on the bottom", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b08"}, {"id": "ee6132", "text": "In primary rainbow, observer sees violet colour on the top and red on the bottom", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b09"}, {"id": "406a96", "text": "In primary rainbow, light wave suffers total internal reflection twice before coming out of water drops", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b0a"}, {"id": "6e851d", "text": "Primary rainbow is less bright than secondary rainbow.", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b0b"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b0c", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fada66f9ce3f243b474f"], "concepts": ["60e2fb1f66f9ce3f243b4b22"], "question": {"text": "If we need a magnification of <math><mn>375</mn></math> from a compound microscope of tube length <math><mn>150</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">m</mi></math> and an objective of focal length <math><mn>5</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">m</mi><mo>,</mo><mi mathvariant=\"normal\"></mi></math> the focal length of the eye-piece, should be close to:"}, "options": [{"id": "88ee37", "text": "<math><mn>22</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">m</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b0d"}, {"id": "741818", "text": "<math><mn>2</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">m</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b0e"}, {"id": "30422e", "text": "<math><mn>4</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">m</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b0f"}, {"id": "1e0ee1", "text": "<math><mn>33</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">m</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b10"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b11", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb5766f9ce3f243b4f3b"], "concepts": ["6162fb466ed13040ec84d055"], "question": {"text": "Two plane mirrors are inclined to each other such that a ray of light incident on the first mirror <math><mfenced separators=\"|\"><mrow><msub><mrow><mi>M</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></math> and parallel to the second mirror <math><mo>(</mo><msub><mrow><mi>M</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>)</mo></math> is finally reflected from the second mirror <math><mo>(</mo><msub><mrow><mi>M</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>)</mo></math> and parallel to the first mirror <math><mfenced separators=\"|\"><mrow><msub><mrow><mi>M</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mo>.</mo></math> The angle between the two mirrors will be:"}, "options": [{"id": "fe1557", "text": "<math><msup><mrow><mn>60</mn></mrow><mrow><mi>o</mi></mrow></msup></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b12"}, {"id": "cebd99", "text": "<math><msup><mrow><mn>45</mn></mrow><mrow><mi>o</mi></mrow></msup></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b13"}, {"id": "4470d3", "text": "<math><msup><mrow><mn>90</mn></mrow><mrow><mi>o</mi></mrow></msup></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b14"}, {"id": "d16547", "text": "<math><msup><mrow><mn>75</mn></mrow><mrow><mi>o</mi></mrow></msup></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b15"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b16", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fbdc66f9ce3f243b5677"], "concepts": ["6162fb496ed13040ec84d24f"], "question": {"text": "In finding out refractive index of glass slab the following observations were made through travelling microscope 50 vernier scale division $=49 \\mathrm{MSD} ; 20$ divisions on main scale in each $\\mathrm{cm}$\nFor mark on paper\n$\\mathrm{MSR}=8.45 \\mathrm{~cm}, \\mathrm{VC}=26$\nFor mark on paper seen through slab\nMSR $=7.12 \\mathrm{~cm}, V C=41$\nFor powder particle on the top surface of the glass slab\n$\\mathrm{MSR}=4.05 \\mathrm{~cm}, \\mathrm{VC}=1$\n(MSR $=$ Main Scale Reading, VC $=$ Vernier Coincidence)\nRefractive index of the glass slab is :"}, "options": [{"id": "95ee56", "text": "1.52", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b17"}, {"id": "e00d44", "text": "1.35", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b18"}, {"id": "0d1096", "text": "1.42", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b19"}, {"id": "03e4cf", "text": "1.24", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b1a"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b1b", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fada66f9ce3f243b4756"], "concepts": ["60e56768499d1e49588f8eda"], "question": {"text": "<p>Three rays of light, namely red <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>R</mi></mfenced></math>,&nbsp;green <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>G</mi><mo>)</mo></math> and blue <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>B</mi><mo>)</mo></math> are incident on the face <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mi>Q</mi></math> of a right angled prism <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mi>Q</mi><mi>R</mi></math>&nbsp;as shown in figure.</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Fced3db70-d3eb-4121-a996-ca3d025ed244-image.png?alt=media\" style=\"width: 288px; height: 189px;\" /></p><p>The refractive indices of the material of the&nbsp;prism for red, green and blue wavelength are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>27</mn><mo>,</mo><mn>1</mn><mo>.</mo><mn>42</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>49</mn></math> respectively. The colour of the ray(s) emerging out of the face <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mi>R</mi></math> is :</p>"}, "options": [{"id": "ae41ff", "text": "green", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b1c"}, {"id": "156dbc", "text": "red", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b1d"}, {"id": "c7f84d", "text": "blue and green", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b1e"}, {"id": "19077c", "text": "blue", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b1f"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b20", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb9d66f9ce3f243b52e1"], "concepts": ["60e2fb9d66f9ce3f243b52a3"], "question": {"text": "An upright object is placed at a distance of <math><mn>40</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi></math> in front of a convergent lens of focal length <math><mn>20</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi><mo>.</mo><mi mathvariant=\"normal\">&#160;</mi></math> A convergent mirror of focal length <math><mi mathvariant=\"normal\">&#160;</mi><mn>10</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi></math> is placed at a distance of <math><mn>60</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi></math> on the other side of the lens. The position and size of the final image will be:"}, "options": [{"id": "abded8", "text": "<math><mi mathvariant=\"normal\"> </mi><mn>40</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\"> </mi></math> from the convergent lens, twice the size of the object", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b21"}, {"id": "e64aa5", "text": "<math><mn>20</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi></math> from the convergent mirror, twice the size of the object", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b22"}, {"id": "c19191", "text": "<math><mi mathvariant=\"normal\"> </mi><mn>40</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\"> </mi></math> from the convergent lens, same size of the object", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b23"}, {"id": "05c555", "text": "<math><mn>20</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\"> </mi></math> from the convergent mirror, same size of the object", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b24"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b25", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fada66f9ce3f243b4755"], "concepts": ["60e2fb1f66f9ce3f243b4b30"], "question": {"text": "A photograph of a landscape is captured by a drone camera at a height of 18 km . The size of the camera film is $2 \\mathrm{~cm} \\times 2 \\mathrm{~cm}$ and the area of the landscape photographed is $400 \\mathrm{~km}^2$. The focal length of the lens in the drone camera is :"}, "options": [{"id": "05b14f", "text": "1.8 cm", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b26"}, {"id": "f0779f", "text": "0.9 cm", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b27"}, {"id": "c29253", "text": "2.8 cm", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b28"}, {"id": "62d9e8", "text": "2.5 cm", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b29"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b2a", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb5766f9ce3f243b4f39"], "concepts": ["60e5671a499d1e49588f87c2"], "question": {"text": "If the distance between object and its two times magnified virtual image produced by a curved mirror is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo> </mo><mi>cm</mi></math>, the focal length of the mirror must be :"}, "options": [{"id": "0a05af", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo> </mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b2b"}, {"id": "630205", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>12</mn><mo> </mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b2c"}, {"id": "49e4c4", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>10</mn><mo> </mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b2d"}, {"id": "2f9a93", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>10</mn><mn>3</mn></mfrac><mo> </mo><mi>cm</mi></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b2e"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b2f", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fbdc66f9ce3f243b5677"], "concepts": ["60e2fbdc66f9ce3f243b565d"], "question": {"text": "<p>A vessel of depth <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi></math> is half filled with oil of refractive index <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>n</mi><mn>1</mn></msub></math>&nbsp;and the other half is filled with water of refractive index <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>n</mi><mn>2</mn></msub><mo>.</mo></math> The apparent depth of this vessel when viewed from above will be-</p>"}, "options": [{"id": "a1094e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><mi>d</mi><mfenced><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></mfenced></mrow><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b30"}, {"id": "cd0d01", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mfenced><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></mfenced></mrow><mrow><mn>2</mn><msub><mi>n</mi><mn>1</mn></msub><msub><mi>n</mi><mn>2</mn></msub></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b31"}, {"id": "0c59be", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><msub><mi>n</mi><mn>1</mn></msub><msub><mi>n</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mfenced><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></mfenced></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b32"}, {"id": "d2edb6", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><msub><mi>n</mi><mn>1</mn></msub><msub><mi>n</mi><mn>2</mn></msub></mrow><mfenced><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></mfenced></mfrac></math>", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b33"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b34", "type": "singleCorrect", "chapters": ["60da9b5062f042332c538358"], "topics": ["60da9b4f62f042332c538326"], "concepts": ["6117b96e67dbe2603c3e9e36"], "question": {"text": "The expected graphical representation of the variation of angle of deviation &#39; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#948;</mi></math> &#39; with angle of incidence &#39;i&#39; in a prism is :"}, "options": [{"id": "d88766", "text": "<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F43da3379-46a3-468a-9878-4d0f4acb7183-image.png?alt=media\" style=\"width: 162px; height: 158px;\" />", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b35"}, {"id": "260dc2", "text": "<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Ffea8d568-2cde-4d52-8e41-a528e985ec35-image.png?alt=media\" style=\"width: 167px; height: 168px;\" />", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b36"}, {"id": "bbabc6", "text": "<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Fca9fc679-f9cf-4a62-b885-ab3a7823c91f-image.png?alt=media\" style=\"width: 166px; height: 165px;\" />", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b37"}, {"id": "a79ae2", "text": "<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F5baf540d-b671-44be-99d6-146fe3cfa3fb-image.png?alt=media\" style=\"width: 162px; height: 164px;\" />", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b38"}], "questionLabels": []}], "markingScheme": {"_id": "608283e223cf4b3ad8f125e6", "title": "JEE Single Correct", "correctAttempt": 4, "incorrectAttempt": -1, "createdAt": "2021-04-09T08:45:27.797Z", "updatedAt": "2021-07-05T05:39:15.785Z", "__v": 0, "updated_by": "6042252509c5bf34e8a2f178"}, "maximumAttemptLimit": 20, "linkedQuestions": [], "createdAt": "2026-04-14T14:29:49.710Z", "updatedAt": "2026-04-14T14:29:49.710Z", "__v": 0}, "position": 0, "_id": "69de4f5d2ee0e063d9272b80"}, {"sectionId": {"_id": "69de4f5d2ee0e063d9272b7e", "title": "Physics Numerical", "sectionType": "normal", "subject": "607018ee404ae53194e73d90", "questions": [{"_id": "69de4f5d2ee0e063d9272b62", "type": "numerical", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fada66f9ce3f243b4755"], "concepts": ["6162fb4c6ed13040ec84d408"], "question": {"text": "The radius of curvature of each surface of a convex lens having refractive index <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>8</mn></math>&nbsp;is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>&#160;</mo><mi>cm</mi></math>. The lens is now immersed in a liquid of refractive index <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>5</mn></math>. The ratio of power of lens in air to its power in the liquid will be <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>:</mo><mo>&#160;</mo><mn>1</mn></math>. The value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> is"}, "options": [{"id": "48e5eb", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b63"}, {"id": "46cceb", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b64"}, {"id": "f1ce7e", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b65"}, {"id": "f08482", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b66"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b67", "type": "numerical", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb9d66f9ce3f243b52e1"], "concepts": ["60e2fb9d66f9ce3f243b52a3"], "question": {"text": "Two identical thin biconvex lenses of focal length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo>&#160;</mo><mi>cm</mi></math> and refractive index <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>5</mn></math>&nbsp;are in contact with each other. The space between the lenses is filled with a liquid of refractive index <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>25</mn></math>. The focal length of the combination is _____&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cm</mi><mo>.</mo></math>"}, "options": [{"id": "4a326e", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b68"}, {"id": "d223f0", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b69"}, {"id": "376e9b", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b6a"}, {"id": "bf0db5", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b6b"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b6c", "type": "numerical", "chapters": ["60da9b5062f042332c538358"], "topics": ["60da9b4f62f042332c538326"], "concepts": ["60e5678c499d1e49588f925c"], "question": {"text": "The refractive index of prism is $\\mu=\\sqrt{3}$ and the ratio of the angle of minimum deviation to the angle of prism is one. The value of angle of prism is _______."}, "options": [{"id": "05d165", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b6d"}, {"id": "db86be", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b6e"}, {"id": "6ccd4c", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b6f"}, {"id": "aea217", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b70"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b71", "type": "numerical", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb5766f9ce3f243b4f3b"], "concepts": ["617aa9daef3fe65ad8e829f4"], "question": {"text": "<p>A point source of light <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi></math>, placed at a distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>60</mn><mo>&#160;</mo><mi>cm</mi></math> infront of the centre of a plane mirror of width <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn><mo>&#160;</mo><mi>cm</mi></math>, hangs vertically on a wall. A man walks infront of the mirror along a line parallel to the mirror at a distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>2</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>&nbsp;from it (see in the figure). The distance between the extreme points where he can see the image of the light source in the mirror is__<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cm</mi></math></p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Fef11d240-f90b-4964-b644-0fe2b8e11f91-image.png?alt=media\" style=\"width: 269px; height: 143px;\" /></p>"}, "options": [{"id": "26937b", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b72"}, {"id": "0490e4", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b73"}, {"id": "5edc13", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b74"}, {"id": "5cf571", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b75"}], "questionLabels": []}, {"_id": "69de4f5d2ee0e063d9272b76", "type": "numerical", "chapters": ["60da9b5062f042332c538358"], "topics": ["60e2fb5766f9ce3f243b4f39"], "concepts": ["6176f3f76581241c7072b25c"], "question": {"text": "The driver sitting inside a parked car is watching vehicles approaching from behind with the help of his side view mirror, which is a convex mirror with radius of curvature $\\mathrm{R}=2 \\mathrm{~m}$. Another car approaches him from behind with a uniform speed of $90 \\mathrm{~km} / \\mathrm{hr}$. When the car is at a distance of 24 m from him, the magnitude of the acceleration of the image of the car in the side view mirror is ' a '. The value of 100 a is _______ $\\mathrm{m} / \\mathrm{s}^2$."}, "options": [{"id": "0f284f", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b77"}, {"id": "6cf7a5", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b78"}, {"id": "691679", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b79"}, {"id": "27246e", "text": "", "isCorrect": null, "_id": "69de4f5d2ee0e063d9272b7a"}], "questionLabels": []}], "markingScheme": {"_id": "608283c623cf4b3ad8f125e5", "title": "JEE Numerical", "correctAttempt": 4, "incorrectAttempt": -1, "createdAt": "2021-04-09T08:45:27.797Z", "updatedAt": "2021-07-05T05:39:27.056Z", "__v": 0, "updated_by": "6042252509c5bf34e8a2f178"}, "maximumAttemptLimit": 5, "linkedQuestions": [], "createdAt": "2026-04-14T14:29:49.791Z", "updatedAt": "2026-04-14T14:29:49.791Z", "__v": 0}, "position": 1, "_id": "69de4f5d2ee0e063d9272b81"}], "bonusSections": [], "packDetails": [], "paidFeatures": [], "tags": [], "timeRestrictionSlots": [], "createdAt": "2026-04-14T11:16:00.364Z", "updatedAt": "2026-04-17T04:58:00.823Z", "testType": "PYQs as Chapter Tests", "isResumeBufferAllowed": true, "enableAccessibility": true, "maxAttemptableQuestion": 25, "analysisVideoThumbnail": "", "analysisVideoThumbnailDark": "", "shortTitle": "", "subjectDetails": [{"subjectId": "607018ee404ae53194e73d90", "title": "Physics", "shortName": "Phy"}], "testTimerType": "mm", "isMarkForReviewAvailable": true}, "temporaryTestDetail": {"_id": "6a4a1e6f9cbf3c6513044afc", "testId": "69de21f07e39d99b57bc5afe", "userId": "6914cc9c4d7566258ee3a8fd", "startedAt": "2026-07-05T09:05:51.725Z", "lastAttemptedSection": null, "totalTimeLeft": 50, "bonusAttempt": false, "sections": [{"sectionId": "69de4f5d2ee0e063d9272b3d", "questions": [{"questionId": "69de4f5d2ee0e063d9272ad5", "markedOptions": [], "inputValue": null, "timeTaken": 0, "timeLeftWhenAttempted": null, "status": "notVisited", "_id": "6a4a1e6f9cbf3c6513044afe", "uid": "6a4a1e6f9cbf3c6513044aff"}, {"questionId": "69de4f5d2ee0e063d9272ada", "markedOptions": [], "inputValue": null, "timeTaken": 0, "timeLeftWhenAttempted": null, "status": "notVisited", "_id": "6a4a1e6f9cbf3c6513044b00", "uid": "6a4a1e6f9cbf3c6513044b01"}, {"questionId": "69de4f5d2ee0e063d9272adf", "markedOptio