</mo></mrow></msup></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Tm</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>", "isCorrect": null, "_id": "69de4f372ee0e063d9252906"}, {"id": "01de88", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Tb</mi><mrow><mn>4</mn><mo>+</mo></mrow></msup></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Yb</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>", "isCorrect": null, "_id": "69de4f372ee0e063d9252907"}, {"id": "50c5a8", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Dy</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Yb</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>", "isCorrect": null, "_id": "69de4f372ee0e063d9252908"}], "questionLabels": []}, {"_id": "69de4f372ee0e063d9252909", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205c0"], "topics": ["60e2fb5766f9ce3f243b4f45"], "concepts": ["60e2fb9d66f9ce3f243b52be"], "question": {"text": "A first row transition metal in its +2 oxidation state has a spin-only magnetic moment value of \\(3.86 \\mathrm{BM}\\). The atomic number of the metal is"}, "options": [{"id": "74df88", "text": "26", "isCorrect": null, "_id": "69de4f372ee0e063d925290a"}, {"id": "bc8219", "text": "25", "isCorrect": null, "_id": "69de4f372ee0e063d925290b"}, {"id": "8bc8ef", "text": "23", "isCorrect": null, "_id": "69de4f372ee0e063d925290c"}, {"id": "da2bd0", "text": "22", "isCorrect": null, "_id": "69de4f372ee0e063d925290d"}], "questionLabels": []}, {"_id": "69de4f372ee0e063d925290e", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205c0"], "topics": ["60e2fb2066f9ce3f243b4b73"], "concepts": ["60d3035daf049203d853666b"], "question": {"text": "During the qualitative analysis of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>SO</mi><mn>3</mn><mrow><mn>2</mn><mo>-</mo></mrow></msubsup></math> using dilute <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi>SO</mi><mn>4</mn></msub><mo>,</mo><msub><mi>SO</mi><mn>2</mn></msub></math>&nbsp;gas is evolved which turns <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">K</mi><mn>2</mn></msub><msub><mi>Cr</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>7</mn></msub></math>&nbsp;solution (acidified with dilute <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi>SO</mi><mn>4</mn></msub></math>):"}, "options": [{"id": "e190fc", "text": "Black", "isCorrect": null, "_id": "69de4f372ee0e063d925290f"}, {"id": "d8735d", "text": "Red", "isCorrect": null, "_id": "69de4f372ee0e063d9252910"}, {"id": "c210df", "text": "Green", "isCorrect": null, "_id": "69de4f372ee0e063d9252911"}, {"id": "685496", "text": "Blue", "isCorrect": null, "_id": "69de4f372ee0e063d9252912"}], "questionLabels": []}, {"_id": "69de4f372ee0e063d9252913", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205c0"], "topics": ["60e2fada66f9ce3f243b478a"], "concepts": ["60e2fad966f9ce3f243b4742"], "question": {"text": "<p>Given below are two statements :</p><p>Statement I : The <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">E</mi><mo>&#176;</mo></math> value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ce</mi><mrow><mn>4</mn><mo>+</mo></mrow></msup><mo>/</mo><msup><mi>Ce</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>+</mo><mn>1</mn><mo>.</mo><mn>74</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math></p><p>Statement II : Ce is more stable in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ce</mi><mrow><mn>4</mn><mo>+</mo></mrow></msup></math> state than <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ce</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> state.</p><p>In the light of the above statements, choose the most appropriate answer from the options given below:</p>"}, "options": [{"id": "f63e14", "text": "Both statement I and statement II are correct", "isCorrect": null, "_id": "69de4f372ee0e063d9252914"}, {"id": "1a5835", "text": "Statement I is incorrect but statement II is correct", "isCorrect": null, "_id": "69de4f372ee0e063d9252915"}, {"id": "9eb107", "text": "Both statement I and statement II are incorrect", "isCorrect": null, "_id": "69de4f372ee0e063d9252916"}, {"id": "b7d79e", "text": "Statement I is correct but statement II is incorrect", "isCorrect": null, "_id": "69de4f372ee0e063d9252917"}], "questionLabels": []}, {"_id": "69de4f372ee0e063d9252918", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205c0"], "topics": ["60e2fb5766f9ce3f243b4f45"], "concepts": ["60e567ab499d1e49588f95dc"], "question": {"text": "The set that contains atomic numbers of only transition elements, is :"}, "options": [{"id": "d5e211", "text": "37,42,50,64", "isCorrect": null, "_id": "69de4f372ee0e063d9252919"}, {"id": "04c388", "text": "21,25,42,72", "isCorrect": null, "_id": "69de4f372ee0e063d925291a"}, {"id": "915887", "text": "9,17,34,38", "isCorrect": null, "_id": "69de4f372ee0e063d925291b"}, {"id": "8316f3", "text": "21,32,53,64", "isCorrect": null, "_id": "69de4f372ee0e063d925291c"}], "questionLabels": []}, {"_id": "69de4f372ee0e063d925291d", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205c0"], "topics": ["60e2fb2066f9ce3f243b4b73"], "concepts": ["6162fbe76ed13040ec8545cf"], "question": {"text": "Which element is not present in Nessler&rsquo;s reagent?"}, "options": [{"id": "584aab", "text": "Mercury", "isCorrect": null, "_id": "69de4f372ee0e063d925291e"}, {"id": "726e71", "text": "Potassium", "isCorrect": null, "_id": "69de4f372ee0e063d925291f"}, {"id": "062c94", "text": "Iodine", "isCorrect": null, "_id": "69de4f372ee0e063d9252920"}, {"id": "900cf4", "text": "Oxygen", "isCorrect": null, "_id": "69de4f372ee0e063d9252921"}], "questionLabels": []}, {"_id": "69de4f372ee0e063d9252922", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205c0"], "topics": ["60e2fada66f9ce3f243b478a"], "concepts": ["617aaa05ef3fe65ad8e851e5"], "question": {"text": "The effect of lanthanoid contraction in the lanthanoid series of elements by and large means"}, "options": [{"id": "d968f9", "text": "increase in atomic radii and decrease in ionic radii,", "isCorrect": null, "_id": "69de4f372ee0e063d9252923"}, {"id": "7ddaf1", "text": "decrease in atomic radii and increase in ionic radii.", "isCorrect": null, "_id": "69de4f372ee0e063d9252924"}, {"id": "579d9e", "text": "increase in both atomic and ionic radii.", "isCorrect": null, "_id": "69de4f372ee0e063d9252925"}, {"id": "17556e", "text": "decrease in both atomic and ionic radii.", "isCorrect": null, "_id": "69de4f372ee0e063d9252926"}], "questionLabels": []}, {"_id": "69de4f372ee0e063d9252927", "type": "singleCorrect", "chapters": ["60d2d1d2185d7a32fa3205c0"], "topics": ["60e2fb5766f9ce3f243b4f45"], "concepts": ["6117b96e67dbe2603c3e9e62"], "question": {"text": "<p>The correct order of following <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi mathvariant=\"normal\">d</mi></math> metal oxides, according to their oxidation numbers is :</p><p>(a) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CrO</mi><mn>3</mn></msub></math></p><p>(b) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Fe</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>3</mn></msub></math></p><p>(c) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>MnO</mi><mn>2</mn></msub></math></p><p>(d) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">V</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>5</mn></msub></math></p><p>(e) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Cu</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math></p>"}, "options": [{"id": "a1a5fb", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">d</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">c</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">e</mi><mo>)</mo></math>", "isCorrect": null, "_id": "69de4f372ee0e063d9252928"}, {"id": "149634", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">c</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">d</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">e</mi><mo>)</mo></math>", "isCorrect": null, "_id": "69de4f372ee0e063d9252929"}, {"id": "72c710", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">d</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">c</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">e</mi><mo>)</mo></math>", "isCorrect": null, "_id": "69de4f372ee0e063d925292a"}, {"id": "cf348d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">c</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">d</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">e</mi><mo>)</mo><mo>&#62;</mo><mo>(</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo></math>", "isCorrect": null, "_id": "69de4f372ee0e063d925292b"}], "questionLabels": []}, {"_id": "69de4f372ee0e063d925292c", "type": "singleCorrect", "chapters": ["60