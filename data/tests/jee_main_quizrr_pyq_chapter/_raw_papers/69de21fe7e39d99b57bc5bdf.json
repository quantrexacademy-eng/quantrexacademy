3.org/1998/Math/MathML\"><mn>1216</mn></math>", "isCorrect": null, "_id": "69de4f6b2ee0e063d927ff87"}, {"id": "5930a1", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1456</mn></math>", "isCorrect": null, "_id": "69de4f6b2ee0e063d927ff88"}], "questionLabels": []}, {"_id": "69de4f6b2ee0e063d927ff89", "type": "singleCorrect", "chapters": ["60e2faad66f9ce3f243b4573"], "topics": ["6162fcbe6ed13040ec85d918"], "concepts": ["6162fcbe6ed13040ec85d8eb"], "question": {"text": "The mean and the standard deviation (s.d.) of <math><mn>10</mn></math> observations are <math><mn>20</mn></math> and <math><mn>2</mn></math> respectively. Each of these <math><mn>10</mn></math> observations is multiplied by <math><mi>p</mi></math> and then reduced by <math><mi>q</mi><mo>,</mo></math> where <math><mi>p</mi><mo>&#8800;</mo><mn>0</mn></math> and <math><mi>q</mi><mo>&#8800;</mo><mn>0</mn><mo>.</mo></math> If the new mean and new s.d. become half of their original values, then <math><mi>q</mi></math> is equal to"}, "options": [{"id": "32e2af", "text": "<math><mo>-</mo><mn>5</mn></math>", "isCorrect": null, "_id": "69de4f6b2ee0e063d927ff8a"}, {"id": "efc3d0", "text": "<math><mn>10</mn></math>", "isCorrect": null, "_id": "69de4f6b2ee0e063d927ff8b"}, {"id": "3e7cbd", "text": "<math><mo>-</mo><mn>20</mn></math>", "isCorrect": null, "_id": "69de4f6b2ee0e063d927ff8c"}, {"id": "f4e141", "text": "<math><mo>-</mo><mn>10</mn></math>", "isCorrect": null, "_id": "69de4f6b2ee0e063d927ff8d"}], "questionLabels": []}, {"_id": "69de4f6b2ee0e063d927ff8e", "type": "singleCorrect", "chapters": ["60e2faad66f9ce3f243b4573"], "topics": ["6162fcbe6ed13040ec85d918"], "concepts": ["6162fcbe6ed13040ec85d8f9"], "question": {"text": "The mean of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn></math> distinct observations is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>.</mo><mn>5</mn></math>&nbsp;and their variance is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><