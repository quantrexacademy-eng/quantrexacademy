nt=\"normal\">B</mi></mfenced><mo>-</mo><mfenced><mi>III</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced><mo>-</mo><mfenced><mi mathvariant=\"normal\">I</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">D</mi></mfenced><mo>-</mo><mfenced><mi>II</mi></mfenced></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882ee"}, {"id": "6547f3", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">A</mi></mfenced><mo>-</mo><mfenced><mi>IV</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">B</mi></mfenced><mo>-</mo><mfenced><mi>II</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced><mo>-</mo><mfenced><mi mathvariant=\"normal\">I</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">D</mi></mfenced><mo>-</mo><mfenced><mi>III</mi></mfenced></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882ef"}, {"id": "36a141", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">A</mi></mfenced><mo>-</mo><mfenced><mi>II</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">B</mi></mfenced><mo>-</mo><mfenced><mi>IV</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced><mo>-</mo><mfenced><mi>III</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">D</mi></mfenced><mo>-</mo><mfenced><mi mathvariant=\"normal\">I</mi></mfenced></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882f0"}, {"id": "d9dd1a", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">A</mi></mfenced><mo>-</mo><mfenced><mi mathvariant=\"normal\">I</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">B</mi></mfenced><mo>-</mo><mfenced><mi>II</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced><mo>-</mo><mfenced><mi>III</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">D</mi></mfenced><mo>-</mo><mfenced><mi>IV</mi></mfenced></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882f1"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d92882f2", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e5678c499d1e49588f926d"], "question": {"text": "The electron gain enthalpy (in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>kJ</mi><mrow><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">l</mi></mrow></mfrac></math> ) of fluorine, chlorine, bromine and iodine, respectively, are"}, "options": [{"id": "ad19c1", "text": "<math><mo>-</mo><mn>296</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>325</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>333</mn></math> and <math><mo>-</mo><mn>349</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882f3"}, {"id": "bf7d7e", "text": "<math><mo>-</mo><mn>349</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>333</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>325</mn></math> and <math><mo>-</mo><mn>296</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882f4"}, {"id": "5949e0", "text": "<math><mo>-</mo><mn>333</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>349</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>325</mn></math> and <math><mo>-</mo><mn>296</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882f5"}, {"id": "243a5f", "text": "<math><mo>-</mo><mn>333</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>325</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>349</mn></math> and <math><mo>-</mo><mn>296</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882f6"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d92882f7", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e567c3499d1e49588f994c"], "question": {"text": "Given below are two statements:<br/>Statement I: Fluorine has most negative electron gain enthalpy in its group.<br/>Statement II: Oxygen has least negative electron gain enthalpy in its group.<br/>In the light of the above statements, choose the most appropriate from the options given below."}, "options": [{"id": "06634a", "text": "Both Statement I and Statement II are true ", "isCorrect": null, "_id": "69de4f762ee0e063d92882f8"}, {"id": "eb8195", "text": " Statement I is true but Statement II is false", "isCorrect": null, "_id": "69de4f762ee0e063d92882f9"}, {"id": "a8fca3", "text": "Both Statement I and Statement II are false ", "isCorrect": null, "_id": "69de4f762ee0e063d92882fa"}, {"id": "0839d9", "text": " Statement I is false but Statement II is true ", "isCorrect": null, "_id": "69de4f762ee0e063d92882fb"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d92882fc", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fad966f9ce3f243b4734"], "question": {"text": "Electronic configuration of four elements $\\mathrm{A}, \\mathrm{B}, \\mathrm{C}$ and D are given below :<br />(A) $1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^3$<br />(B) $1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^4$<br />(C) $1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^5$<br />(D) $1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^2$<br />Which of the following is the correct order of increasing electronegativity (Pauling's scale)?"}, "options": [{"id": "b3d167", "text": "A &lt; D &lt; B &lt; C", "isCorrect": null, "_id": "69de4f762ee0e063d92882fd"}, {"id": "4e59b9", "text": "A &lt; C &lt; B &lt; D", "isCorrect": null, "_id": "69de4f762ee0e063d92882fe"}, {"id": "82d12c", "text": "A &lt; B &lt; C &lt; D", "isCorrect": null, "_id": "69de4f762ee0e063d92882ff"}, {"id": "56ebec", "text": "D &lt; A &lt; B &lt; C", "isCorrect": null, "_id": "69de4f762ee0e063d9288300"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288301", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb1f66f9ce3f243b4b41"], "question": {"text": "The ionic radius of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Na</mi><mo>+</mo></msup></math> ions is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>02</mn><mover><mi mathvariant=\"normal\">A</mi><mo>&#176;</mo></mover><mo>.</mo></math>&nbsp;The ionic radii (in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi mathvariant=\"normal\">A</mi><mo>&#176;</mo></mover></math>) of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Mg</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Al</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup><mo>,</mo></math>&nbsp;respectively, are"}, "options": [{"id": "b9076a", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>05</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>99</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288302"}, {"id": "dc4396", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>72</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>54</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288303"}, {"id": "9f9b85", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>85</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>99</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288304"}, {"id": "dbb205", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>68</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>72</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288305"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288306", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "The element having the greatest difference between its first and second ionization energies, is"}, "options": [{"id": "95ee46", "text": "<math><mi mathvariant=\"normal\">B</mi><mi mathvariant=\"normal\">a</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288307"}, {"id": "249478", "text": "<math><mi mathvariant=\"normal\">K</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288308"}, {"id": "7a9a27", "text": "<math><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">a</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288309"}, {"id": "9365b2", "text": "<math><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">c</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928830a"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d928830b", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e40fd4f1ef260f84ed1e56"], "question": {"text": "The correct order of metallic character is"}, "options": [{"id": "dca42e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">K</mi><mo>&#160;</mo><mo>&#62;</mo><mo>&#160;</mo><mi>Be</mi><mo>&#160;</mo><mo>&#62;</mo><mo>&#160;</mo><mi>Ca</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928830c"}, {"id": "8c1024", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Be</mi><mo>&#160;</mo><mo>&#62;</mo><mo>&#160;</mo><mi>Ca</mi><mo>&#160;</mo><mo>&#62;</mo><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928830d"}, {"id": "b2591c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Ca</mi><mo>&#160;</mo><mo>&#62;</mo><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi><mo>&#160;</mo><mo>&#62;</mo><mo>&#160;</mo><mi>Be</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928830e"}, {"id": "99276d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">K</mi><mo>&#160;</mo><mo>&#62;</mo><mo>&#160;</mo><mi>Ca</mi><mo>&#160;</mo><mo>&#62;</mo><mo>&#160;</mo><mi>Be</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928830f"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288310", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e5678c499d1e49588f926d"], "question": {"text": "The correct order of electron gain enthalpy is:"}, "options": [{"id": "1b23b2", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">S</mi><mo>&#62;</mo><mi mathvariant=\"normal\">O</mi><mo>&#62;</mo><mi>Se</mi><mo>&#62;</mo><mi>Te</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288311"}, {"id": "1f1b4e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">O</mi><mo>&#62;</mo><mi mathvariant=\"normal\">S</mi><mo>&#62;</mo><mi>Se</mi><mo>&#62;</mo><mi>Te</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288312"}, {"id": "c8cb18", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">S</mi><mo>&#62;</mo><mi>Se</mi><mo>&#62;</mo><mi>Te</mi><mo>&#62;</mo><mi mathvariant=\"normal\">O</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288313"}, {"id": "430ba1", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Te</mi><mo>&#62;</mo><mi>Se</mi><mo>&#62;</mo><mi mathvariant=\"normal\">S</mi><mo>&#62;</mo><mi mathvariant=\"normal\">O</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288314"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288315", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e567c3499d1e49588f994c"], "question": {"text": "Given below are two statements:<br/>Statement - I: Along the period, the chemical reactivity of the element gradually increases from group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math> to group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>18</mn></math> .<br/>Statement - II: The nature of oxides formed by group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math> element is basic while that of group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>17</mn></math> elements is acidic.<br/>In the the light above statements, choose the most appropriate from the questions given below:"}, "options": [{"id": "72d4c3", "text": "Both statement I and Statement II are true.", "isCorrect": null, "_id": "69de4f762ee0e063d9288316"}, {"id": "df5266", "text": "Statement I is true but Statement II is False.", "isCorrect": null, "_id": "69de4f762ee0e063d9288317"}, {"id": "c5922e", "text": "Statement I is false but Statement II is true.", "isCorrect": null, "_id": "69de4f762ee0e063d9288318"}, {"id": "42c961", "text": "Both Statement I and Statement II is false.", "isCorrect": null, "_id": "69de4f762ee0e063d9288319"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d928831a", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fad966f9ce3f243b4734"], "question": {"text": "Which of the following statements are correct?<br />A. The process of the addition an electron to a neutral gaseous atom is always exothermic<br />B. The process of removing an electron from an isolated gaseous atom is always endothermic<br />C. The $1^{\\text {st }}$ ionization energy of the boron is less than that of the beryllium<br />D. The electronegativity of C is 2.5 in $\\mathrm{CH}_4$ and $\\mathrm{CCl}_4$<br />E. Li is the most electropositive among elements of group I<br />Choose the correct answer from the options gives below"}, "options": [{"id": "21457b", "text": "B & C only", "isCorrect": null, "_id": "69de4f762ee0e063d928831b"}, {"id": "5790cf", "text": "A, C and d only", "isCorrect": null, "_id": "69de4f762ee0e063d928831c"}, {"id": "3caa1e", "text": "B and D only", "isCorrect": null, "_id": "69de4f762ee0e063d928831d"}, {"id": "2f6cb9", "text": "B,C and E only", "isCorrect": null, "_id": "69de4f762ee0e063d928831e"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d928831f", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb1f66f9ce3f243b4b41"], "question": {"text": "The increasing order of the atomic radii of the following elements is:<br /><math><mfenced separators=\"|\"><mrow><mi>a</mi></mrow></mfenced><mi></mi><mi>C</mi></math><br /><math><mfenced separators=\"|\"><mrow><mi>b</mi></mrow></mfenced><mi></mi><mi>O</mi></math><br /><math><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced><mi></mi><mi>F</mi></math><br /><math><mfenced separators=\"|\"><mrow><mi>d</mi></mrow></mfenced><mi></mi><mi>C</mi><mi>l</mi></math><br /><math><mfenced separators=\"|\"><mrow><mi>e</mi></mrow></mfenced><mi></mi><mi>B</mi><mi>r</mi></math>"}, "options": [{"id": "08d72b", "text": "<math><mfenced separators=\"|\"><mrow><mi>b</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>d</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>a</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>e</mi></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288320"}, {"id": "483314", "text": "<math><mfenced separators=\"|\"><mrow><mi>d</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>b</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>a</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>e</mi></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288321"}, {"id": "b94abe", "text": "<math><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>b</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>a</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>d</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>e</mi></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288322"}, {"id": "75b42c", "text": "<math><mfenced separators=\"|\"><mrow><mi>a</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>b</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>d</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>e</mi></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288323"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288324", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "The first ionization enthalpy of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Na</mi><mo>,</mo><mi>Mg</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Si</mi></math>, respectively, are: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>496</mn><mo>,</mo><mn>737</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>786</mn><mo>&#160;</mo><mi>kJ</mi><msup><mrow><mi>mo</mi><mn>1</mn></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>. The first ionization enthalpy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><msup><mi>kJmol</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></mfenced></math> of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Al</mi></math> is"}, "options": [{"id": "9e8342", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>487</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288325"}, {"id": "c5b0bb", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>768</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288326"}, {"id": "87596b", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>577</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288327"}, {"id": "c53e38", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>856</mn></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288328"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288329", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e40fd4f1ef260f84ed1e56"], "question": {"text": "<p>Consider the following elements.</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F0ba10fd1-2991-4eb9-9972-0d900218840d.png?alt=media\" style=\"width: 237px; height: 74px;\"/></p><p>Which of the following is/are true about <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">A</mi><mo>'</mo></msup><mo>,</mo><mo> </mo><msup><mi mathvariant=\"normal\">B</mi><mo>'</mo></msup><mo>,</mo><mo> </mo><msup><mi mathvariant=\"normal\">C</mi><mo>'</mo></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">D</mi><mo>'</mo></msup></math> ?</p><p>A. Order of atomic radii: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">B</mi><mo>'</mo></msup><mo>&lt;</mo><msup><mi mathvariant=\"normal\">A</mi><mo>'</mo></msup><mo>&lt;</mo><msup><mi mathvariant=\"normal\">D</mi><mo>'</mo></msup><mo>&lt;</mo><msup><mi mathvariant=\"normal\">C</mi><mo>'</mo></msup></math></p><p>B. Order of metallic character : <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">B</mi><mo>'</mo></msup><mo>&lt;</mo><msup><mi mathvariant=\"normal\">A</mi><mo>'</mo></msup><mo>&lt;</mo><msup><mi mathvariant=\"normal\">D</mi><mo>'</mo></msup><mo>&lt;</mo><msup><mi mathvariant=\"normal\">C</mi><mo>'</mo></msup></math></p><p>C. Size of the element : <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">D</mi><mo>'</mo></msup><mo>&lt;</mo><msup><mi mathvariant=\"normal\">C</mi><mo>'</mo></msup><mo>&lt;</mo><msup><mi mathvariant=\"normal\">B</mi><mo>'</mo></msup><mo>&lt;</mo><msup><mi mathvariant=\"normal\">A</mi><mo>'</mo></msup></math></p><p>D. Order of ionic radii : <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><msup><mi mathvariant=\"normal\">B</mi><mo>'</mo></msup><mo>+</mo></msup><mo>&lt;</mo><msup><msup><mi mathvariant=\"normal\">A</mi><mo>'</mo></msup><mo>+</mo></msup><mo>&lt;</mo><msup><msup><mi mathvariant=\"normal\">D</mi><mo>'</mo></msup><mo>+</mo></msup><mo>&lt;</mo><msup><msup><mi mathvariant=\"normal\">C</mi><mo>'</mo></msup><mo>+</mo></msup></math></p><p>Choose the correct answer from the options given below:</p>"}, "options": [{"id": "c6dd8b", "text": "A only", "isCorrect": null, "_id": "69de4f762ee0e063d928832a"}, {"id": "f628d9", "text": "A, B and D only", "isCorrect": null, "_id": "69de4f762ee0e063d928832b"}, {"id": "96e913", "text": "A and B only", "isCorrect": null, "_id": "69de4f762ee0e063d928832c"}, {"id": "70bd51", "text": "B, C and D only", "isCorrect": null, "_id": "69de4f762ee0e063d928832d"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d928832e", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e5678c499d1e49588f926d"], "question": {"text": "The absolute value of the electron gain enthalpy of halogens satisfies:"}, "options": [{"id": "910832", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>&#62;</mo><mi>Br</mi><mo>&#62;</mo><mi>Cl</mi><mo>&#62;</mo><mi mathvariant=\"normal\">F</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928832f"}, {"id": "5ee2f6", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Cl</mi><mo>&#62;</mo><mi>Br</mi><mo>&#62;</mo><mi mathvariant=\"normal\">F</mi><mo>&#62;</mo><mi mathvariant=\"normal\">I</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288330"}, {"id": "5b247f", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Cl</mi><mo>&#62;</mo><mi mathvariant=\"normal\">F</mi><mo>&#62;</mo><mi>Br</mi><mo>&#62;</mo><mi mathvariant=\"normal\">I</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288331"}, {"id": "f4a4a2", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">F</mi><mo>&#62;</mo><mi>Cl</mi><mo>&#62;</mo><mi>Br</mi><mo>&#62;</mo><mi mathvariant=\"normal\">I</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288332"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288333", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e567c3499d1e49588f994c"], "question": {"text": "<p>What is the correct oder of electron gain enthalpy of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Cl</mi><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">F</mi><mo>,</mo><mo>&#160;</mo><mi>Te</mi><mo>,</mo><mo>&#160;</mo><mi>Po</mi></math></p>"}, "options": [{"id": "d5e55c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mi mathvariant=\"normal\">F</mi><mo>&#62;</mo><mi>Cl</mi><mo>&#62;</mo><mi>Te</mi><mo>&#62;</mo><mi>Po</mi><mo>&#160;</mo></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288334"}, {"id": "6b11c5", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Cl</mi><mo>&#62;</mo><mi mathvariant=\"normal\">F</mi><mo>&#62;</mo><mi>Te</mi><mo>&#160;</mo><mo>&#62;</mo><mi>Po</mi><mo>&#160;</mo></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288335"}, {"id": "872c8c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Te</mi><mo>&#62;</mo><mi>Po</mi><mo>&#62;</mo><mi>Cl</mi><mo>&#62;</mo><mi mathvariant=\"normal\">F</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288336"}, {"id": "f170e7", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Po</mi><mo>&#62;</mo><mi>Te</mi><mo>&#62;</mo><mi mathvariant=\"normal\">F</mi><mo>&#62;</mo><mi>Cl</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288337"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288338", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fad966f9ce3f243b4734"], "question": {"text": "The correct order of electronegativity for given elements is"}, "options": [{"id": "061965", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">P</mi><mo>&#62;</mo><mi>Br</mi><mo>&#62;</mo><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi>At</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288339"}, {"id": "7f47c3", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Br</mi><mo>&#62;</mo><mi mathvariant=\"normal\">P</mi><mo>&#62;</mo><mi>At</mi><mo>&#62;</mo><mi mathvariant=\"normal\">C</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928833a"}, {"id": "ee0f28", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Br</mi><mo>&#62;</mo><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi>At</mi><mo>&#62;</mo><mi mathvariant=\"normal\">P</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928833b"}, {"id": "9d4eeb", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi mathvariant=\"normal\">P</mi><mo>&#62;</mo><mi>At</mi><mo>&#62;</mo><mi>Br</mi></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928833c"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d928833d", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb1f66f9ce3f243b4b41"], "question": {"text": "The correct order of the atomic radii of $\\mathrm{C}, \\mathrm{Cs}, \\mathrm{Al},$ and $\\mathrm{S}$ is:"}, "options": [{"id": "c9a127", "text": "$\\mathrm{C}  < \\mathrm{S} < \\mathrm{A} 1 < \\mathrm{Cs}$", "isCorrect": null, "_id": "69de4f762ee0e063d928833e"}, {"id": "b4a396", "text": "$\\mathrm{S}  < \\mathrm{C} < \\mathrm{Cs} < \\mathrm{Al}$", "isCorrect": null, "_id": "69de4f762ee0e063d928833f"}, {"id": "290c13", "text": "$\\mathrm{S}  < \\mathrm{C} < \\mathrm{Al} < \\mathrm{Cs}$", "isCorrect": null, "_id": "69de4f762ee0e063d9288340"}, {"id": "26ae28", "text": "$\\mathrm{C}  < \\mathrm{S} < \\mathrm{Cs} < \\mathrm{Al}$", "isCorrect": null, "_id": "69de4f762ee0e063d9288341"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288342", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "The five successive ionization enthalpies of an element are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>800</mn><mo>,</mo><mo>&#160;</mo><mn>2427</mn><mo>,</mo><mo>&#160;</mo><mn>3658</mn><mo>,</mo><mo>&#160;</mo><mn>35024</mn><mo>&#160;</mo><mo>&#160;</mo><mn>32824</mn><mo>&#160;</mo><mi>kJ</mi><mo>&#160;</mo><msup><mi>mol</mi><mrow><mo>&#8211;</mo><mn>1</mn></mrow></msup></math> . The number of valence electrons in the element is:"}, "options": [{"id": "747521", "text": "5", "isCorrect": null, "_id": "69de4f762ee0e063d9288343"}, {"id": "8c4a1f", "text": "4", "isCorrect": null, "_id": "69de4f762ee0e063d9288344"}, {"id": "f9c870", "text": "3", "isCorrect": null, "_id": "69de4f762ee0e063d9288345"}, {"id": "4b2e31", "text": "2", "isCorrect": null, "_id": "69de4f762ee0e063d9288346"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288347", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e40fd4f1ef260f84ed1e56"], "question": {"text": "Given below are two statements :\nStatement (I) : An element in the extreme left of the periodic table forms acidic oxides.\nStatement (II) : Acid is formed during the reaction between water and oxide of a reactive element present in the extreme right of the periodic table.\nIn the light of the above statements, choose the correct answer from the options given below :"}, "options": [{"id": "bbd71b", "text": "Statement I is true but Statement II is false", "isCorrect": null, "_id": "69de4f762ee0e063d9288348"}, {"id": "4023fb", "text": "Both Statement I and Statement II are true", "isCorrect": null, "_id": "69de4f762ee0e063d9288349"}, {"id": "b2b20d", "text": "Both Statement I and Statement II are false", "isCorrect": null, "_id": "69de4f762ee0e063d928834a"}, {"id": "84edb6", "text": "Statement I is false but Statement II is true", "isCorrect": null, "_id": "69de4f762ee0e063d928834b"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d928834c", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e5678c499d1e49588f926d"], "question": {"text": "The electron affinity value are negative for\nA. \\(\\mathrm{Be} \\rightarrow \\mathrm{Be}^{-}\\)\nB. \\(\\mathrm{N} \\rightarrow \\mathrm{N}^{-}\\)\nC. \\(\\mathrm{O} \\rightarrow \\mathrm{O}^{2-}\\)\nD. \\(\\mathrm{Na} \\rightarrow \\mathrm{Na}^{-}\\)\nE. \\(\\mathrm{Al} \\rightarrow \\mathrm{Al}^{-}\\)\nChoose the most appropriate answer from the options given below :"}, "options": [{"id": "96f051", "text": "D and E only", "isCorrect": null, "_id": "69de4f762ee0e063d928834d"}, {"id": "bcc176", "text": "A, B and C only", "isCorrect": null, "_id": "69de4f762ee0e063d928834e"}, {"id": "76f59e", "text": "A and D only", "isCorrect": null, "_id": "69de4f762ee0e063d928834f"}, {"id": "e86ab2", "text": "A, B, D and E only", "isCorrect": null, "_id": "69de4f762ee0e063d9288350"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288351", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e567c3499d1e49588f994c"], "question": {"text": "<p>The correct sequence of electron gain enthalpy of the elements listed below is</p><p>A. Ar&nbsp;&nbsp;B. Br&nbsp;&nbsp;C. F&nbsp;&nbsp;D. S</p><p>Choose the most appropriate from the options given below:</p>"}, "options": [{"id": "600cbe", "text": "C &gt; B &gt; D &gt; A", "isCorrect": null, "_id": "69de4f762ee0e063d9288352"}, {"id": "7b70fa", "text": "A &gt; D &gt; B &gt; C", "isCorrect": null, "_id": "69de4f762ee0e063d9288353"}, {"id": "209053", "text": "A &gt; D &gt; C &gt; B", "isCorrect": null, "_id": "69de4f762ee0e063d9288354"}, {"id": "ef151d", "text": "D &gt; C &gt; B &gt; A", "isCorrect": null, "_id": "69de4f762ee0e063d9288355"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d9288356", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb1f66f9ce3f243b4b41"], "question": {"text": "The correct order of atomic radii is:"}, "options": [{"id": "d90891", "text": "<math > <mrow>  <mtext>Ce&#x003E;Eu&#x003E;Ho&#x003E;N</mtext></mrow></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288357"}, {"id": "8289ae", "text": "<math > <mrow>  <mtext>N&#x003E;Ce&#x003E;Eu&#x003E;Ho</mtext></mrow></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288358"}, {"id": "6a0f8e", "text": "<math > <mrow>  <mtext>Ho&#x003E;N&#x003E;Eu&#x003E;Ce</mtext></mrow></math>", "isCorrect": null, "_id": "69de4f762ee0e063d9288359"}, {"id": "f3d8bb", "text": "<math > <mrow>  <mtext>Eu&#x003E;Ce&#x003E;Ho&#x003E;N</mtext></mrow></math>", "isCorrect": null, "_id": "69de4f762ee0e063d928835a"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d928835b", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "The first ionization energy of magnesium is smaller, as compared to that of elements <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">Y</mi></math>,&nbsp;but higher than that of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">Z</mi></math>. The elements <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">Y</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">Z</mi></math>, respectively, are :"}, "options": [{"id": "39d3ac", "text": "chlorine, lithium and sodium", "isCorrect": null, "_id": "69de4f762ee0e063d928835c"}, {"id": "a846b7", "text": "argon, lithium and sodium", "isCorrect": null, "_id": "69de4f762ee0e063d928835d"}, {"id": "bc652a", "text": "argon, chlorine and sodium", "isCorrect": null, "_id": "69de4f762ee0e063d928835e"}, {"id": "7d848b", "text": "neon, sodium and chlorine", "isCorrect": null, "_id": "69de4f762ee0e063d928835f"}], "questionLabels": []}], "markingScheme": {"_id": "608283e223cf4b3ad8f125e6", "title": "JEE Single Correct", "correctAttempt": 4, "incorrectAttempt": -1, "createdAt": "2021-04-09T08:45:27.797Z", "updatedAt": "2021-07-05T05:39:15.785Z", "__v": 0, "updated_by": "6042252509c5bf34e8a2f178"}, "maximumAttemptLimit": 25, "linkedQuestions": [], "createdAt": "2026-04-14T14:30:14.221Z", "updatedAt": "2026-04-14T14:30:14.221Z", "__v": 0}, "position": 0, "_id": "69de4f762ee0e063d9288365"}], "bonusSections": [], "packDetails": [], "paidFeatures": [], "tags": [], "timeRestrictionSlots": [], "createdAt": "2026-04-14T11:16:03.304Z", "updatedAt": "2026-04-17T04:58:02.505Z", "testType": "PYQs as Chapter Tests", "isResumeBufferAllowed": true, "enableAccessibility": true, "maxAttemptableQuestion": 25, "analysisVideoThumbnail": "", "analysisVideoThumbnailDark": "", "shortTitle": "", "subjectDetails": [{"subjectId": "607018ee404ae53194e73d91", "title": "Chemistry", "shortName": "Ch