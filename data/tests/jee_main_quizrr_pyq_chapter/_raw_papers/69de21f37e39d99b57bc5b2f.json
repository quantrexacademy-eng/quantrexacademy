id": "91554e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">K</mi><mo>+</mo></msup><mo>&#60;</mo><msup><mi mathvariant=\"normal\">S</mi><mrow><mn>2</mn><mo>-</mo></mrow></msup><mo>&#60;</mo><msup><mi>Ca</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mi>Cl</mi><mo>-</mo></msup></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882e5"}, {"id": "a2e9ea", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">S</mi><mrow><mn>2</mn><mo>-</mo></mrow></msup><mo>&#60;</mo><msup><mi>Cl</mi><mo>-</mo></msup><mo>&#60;</mo><msup><mi>Ca</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mi mathvariant=\"normal\">K</mi><mo>+</mo></msup></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882e6"}, {"id": "58c6fa", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ca</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mi mathvariant=\"normal\">K</mi><mo>+</mo></msup><mo>&#60;</mo><msup><mi>Cl</mi><mo>-</mo></msup><mo>&#60;</mo><msup><mi mathvariant=\"normal\">S</mi><mrow><mn>2</mn><mo>-</mo></mrow></msup></math>", "isCorrect": null, "_id": "69de4f762ee0e063d92882e7"}], "questionLabels": []}, {"_id": "69de4f762ee0e063d92882e8", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "First ionisation enthalpy values of first four group 15 elements are given below. Choose the correct value for the element that is a main component of apatite family :"}, "options": [{"id": "56ba7a", "text": "$1402 \\mathrm{~kJ} \\mathrm{~mol}^{-1}$", "isCorrect": null, "_id": "69de4f762ee0e063d92882e9"}, {"id": "333f35", "text": "$834 \\mathrm{~kJ} \\mathrm{~mol}^{-1}$", "isCorrect": null, "_id": "69de4f762ee0e063d92882ea"}, {"id": "8d477f", "text": "$1012 \\mathrm{~kJ} \\mathrm{~mol}^{-1}$", "isCorrect": null, "_id": "69de4f762ee0e06