eight: 128px;\" /></p>"}, "options": [{"id": "f6b6a7", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>,</mo><mi mathvariant=\"normal\">B</mi><mo>,</mo><mi mathvariant=\"normal\">C</mi><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi mathvariant=\"normal\">D</mi></math>", "isCorrect": null, "_id": "69de4f74c677dc36a8922365"}, {"id": "eafabc", "text": "Only&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi mathvariant=\"normal\">B</mi></math>", "isCorrect": null, "_id": "69de4f74c677dc36a8922366"}, {"id": "8ec24a", "text": "Only&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi mathvariant=\"normal\">C</mi></math>", "isCorrect": null, "_id": "69de4f74c677dc36a8922367"}, {"id": "cc24e8", "text": "Only&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>,</mo><mi mathvariant=\"normal\">C</mi><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi mathvariant=\"normal\">D</mi></math>", "isCorrect": null, "_id": "69de4f74c677dc36a8922368"}], "questionLabels": []}, {"_id": "69de4f74c677dc36a8922369", "type": "singleCorrect", "chapters": ["60ced3330e34b73944ddfaf4"], "topics": ["617aa9f6ef3fe65ad8e8445b"], "concepts": ["617aa9f6ef3fe65ad8e8441e"], "question": {"text": "<p>Match the following :</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td>Test/Method</td>\t\t\t<td>&nbsp;</td>\t\t\t<td>Reagent</td>\t\t</tr>\t\t<tr>\t\t\t<td>(i)</td>\t\t\t<td>Lucas Test</td>\t\t\t<td>(a)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><msub><mi>SO</mi><mn>2</mn></msub><mi>Cl</mi><mo>/</mo><mi>aq</mi><mo>.</mo><mo>&#160;</mo><mi>KOH</mi></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(ii)</td>\t\t\t<td>&nbsp;Dumas method</td>\t\t\t<td>(b)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>HNO</mi><mn>3</mn></msub><mo>/</mo><msub><mi>AgNO</mi><mn>3</mn></msub></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(iii)</td>\t\t\t<td>Kjeldahl&#39;s method</td>\t\t\t<td>(c)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CuO</mi><mo>/</mo><msub><mi>CO</mi><mn>3</mn></msub></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(iv)</td>\t\t\t<td>Hinsberg Test</td>\t\t\t<td>(d)</td>\t\t\t<td>Conc.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>HCl</mi></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>ZnCl</mi><mn>2</mn></msub></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td>&nbsp;</td>\t\t\t<td>(e)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi>SO</mi><mn>4</mn></msub></math></td>\t\t</tr>\t</tbody></table><p>&nbsp;</p>"}, "options": [{"id": "418de8", "text": "(i)-(d), (ii)-(c), (iii)-(b), (iv)-(e)", "isCorrect": null, "_id": "69de4f74c677dc36a892236a"}, {"id": "68642c", "text": "(i)-(b), (ii)-(d), (iii)-(e), (iv)-(a)", "isCorrect": null, "_id": "69de4f74c677dc36a892236b"}, {"id": "4879cd", "text": "(i)-(d), (ii)-(c), (iii)-(e), (iv)-(a)", "isCorrect": null, "_id": "69de4f74c677dc36a892236c"}, {"id": "add441", "text": "(i)-(b), (ii)-(a), (iii)-(c), (iv)-(d)", "isCorrect": null, "_id": "69de4f74c677dc36a892236d"}], "questionLabels": []}, {"_id": "69de4f74c677dc36a892236e", "type": "singleCorrect", "chapters": ["60ced3330e34b73944ddfaf4"], "topics": ["60e5678e499d1e49588f927d"], "concepts": ["60e5678c499d1e49588f925b"], "question": {"text": "Bond line formula of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>HOCH</mi><mo>(</mo><mi>CN</mi><msub><mo>)</mo><mn>2</mn></msub></math> is:"}, "options": [{"id": "0acf30", "text": "<img src=\"https://firebases