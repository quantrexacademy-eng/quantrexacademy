pp.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2FsGxv5FrnhkvpyW0OSXU3y1vSAJybQ7hjewCTyPRPURA.original.fullsize.png?alt=media\"/>"}, "options": [{"id": "1ef725", "text": "24 mA", "isCorrect": null, "_id": "69de4f282ee0e063d9245cff"}, {"id": "681b8e", "text": "80 mA", "isCorrect": null, "_id": "69de4f282ee0e063d9245d00"}, {"id": "56e5ff", "text": "10 mA", "isCorrect": null, "_id": "69de4f282ee0e063d9245d01"}, {"id": "5f6fd8", "text": "60 mA", "isCorrect": null, "_id": "69de4f282ee0e063d9245d02"}], "questionLabels": []}, {"_id": "69de4f282ee0e063d9245d03", "type": "singleCorrect", "chapters": ["60e2fadb66f9ce3f243b4798"], "topics": ["60e567c5499d1e49588f9963"], "concepts": ["60e567c3499d1e49588f9942"], "question": {"text": "<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2FUM9y_LSXZ1iSJo00z9lHxoDSyH7xZxOHkiyrnNIU3pU.original.fullsize.png?alt=media\"><br />In the truth table of the above circuit the value of $\\mathrm{X}$ and $\\mathrm{Y}$ are :"}, "options": [{"id": "b3033c", "text": "0,0", "isCorrect": null, "_id": "69de4f282ee0e063d9245d04"}, {"id": "0a0baa", "text": "1,1", "isCorrect": null, "_id": "69de4f282ee0e063d9245d05"}, {"id": "80c0ce", "text": "1,0", "isCorrect": null, "_id": "69de4f282ee0e063d9245d06"}, {"id": "28bb39", "text": "0,1", "isCorrect": null, "_id": "69de4f282ee0e063d9245d07"}], "questionLabels": []}, {"_id": "69de4f282ee0e063d9245d08", "type": "singleCorrect", "chapters": ["60e2fadb66f9ce3f243b4798"], "topics": ["60e567c5499d1e49588f9963"], "concepts": ["60e56813499d1e49588fa392"], "question": {"text": "<p>A logic gate circuit has two inputs <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> and output <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math>. The voltage waveforms of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>,</mo><mi>B</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math> are shown below</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Fe9c504d7-1da4-4703-aa00-baf2dbe5341b-image.png?alt=media\" style=\"width: 250px; height: 150px;\" /></p><p>The logic gate circuit is</p>"}, "options": [{"id": "71c898", "text": "AND gate", "isCorrect": null, "_id": "69de4f282ee0e063d9245d09"}, {"id": "bbc570", "text": "OR gate", "isCorrect": null, "_id": "69de4f282ee0e063d9245d0a"}, {"id": "cc42f8", "text": "NOR gate", "isCorrect": null, "_id": "69de4f282ee0e063d9245d0b"}, {"id": "6cb5e4", "text": "NAND gate", "isCorrect": null, "_id": "69de4f282ee0e063d9245d0c"}], "questionLabels": []}, {"_id": "69de4f282ee0e063d9245d0d", "type": "singleCorrect", "chapters": ["60e2fadb66f9ce3f243b4798"], "topics": ["60e2fada66f9ce3f243b4759"], "concepts": ["60e40fd4f1ef260f84ed1e39"], "question": {"text": "When a diode is forward biased, it has a voltage drop of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>5</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math> . the safe limit of current through the diode is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi>mA</mi></math>. If a battery of emf&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>5</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math> is used in the circuit, the value of minimum resistance to be connected in series with the diode so that the current does not exceed the safe limit is :"}, "options": [{"id": "dec81d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>300</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math>", "isCorrect": null, "_id": "69de4f282ee0e063d9245d0e"}, {"id": "95ee2a", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math>", "isCorrect": null, "_id": "69de4f282ee0e063d9245d0f"}, {"id": "b39768", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math>", "isCorrect": null, "_id": "69de4f282ee0e063d9245d10"}, {"id": "410603", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>200</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math>", "isCorrect": null, "_id": "69de4f282ee0e063d9245d11"}], "questionLabels": []}, {"_id": "69de4f282ee0e063d9245d12", "type": "singleCorrect", "chapters": ["60e2fadb66f9ce3f243b4798"], "topics": ["60e2fada66f9ce3f243b4759"], "concepts": ["60e2fb1f66f9ce3f243b4b1d"], "question": {"text": "The figure represents a voltage regulator circuit using a Zener diode. The breakdown voltage of the Zener diode is <math><mn>6</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">V</mi></math> and the load resistance is, <math><msub><mrow><mi mathvariant=\"normal\">R</mi></mrow><mrow><mi mathvariant=\"normal\">L</mi></mrow></msub><mo>=</mo><mn>4</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">&#937;</mi></math> . The series resistance of the circuit is <math><mi>&#160;</mi><msub><mrow><mi mathvariant=\"normal\">R</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi></mrow></msub><mo>=</mo><mn>1</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">&#937;</mi></math> . If the battery voltage <math><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow></msub></math> varies from <math><mn>8</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">V</mi><mi mathvariant=\"normal\">&#160;</mi></math> to <math><mi mathvariant=\"normal\">&#160;</mi><mn>16</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">V</mi></math> , what are the minimum and maximum values of the current through Zener diode?<br /><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F02d4a28e-c453-4769-9701-db0d02a487bb-image.png?alt=media\" style=\"width: 314px; height: 204px;\" />"}, "options": [{"id": "e7915b", "text": "<math><mn>0.5</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi><mo>;</mo><mi mathvariant=\"normal\"> </mi><mn>6</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi></math>", "isCorrect": null, "_id": "69de4f282ee0e063d9245d13"}, {"id": "f6457b", "text": "<math><mn>1</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi><mo>;</mo><mi mathvariant=\"normal\"> </mi><mn>8.5</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi></math>", "isCorrect": null, "_id": "69de4f282ee0e063d9245d14"}, {"id": "48f5fe", "text": "<math><mn>0.5</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi><mo>;</mo><mi mathvariant=\"normal\"> </mi><mn>8.5</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi></math>", "isCorrect": null, "_id": "69de4f282ee0e063d9245d15"}, {"id": "dccd02", "text": "<math><mn>1.5</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi><mo>;</mo><mi mathvariant=\"normal\"> </mi><mn>8.5</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi></math>", "isCorrect": null, "_id": "69de4f282ee0e063d9245d16"}], "questionLabels": []}], "markingScheme": {"_id": "608283e223cf4b3ad8f125e6", "title": "JEE Single Correct", "correctAttempt": 4, "incorrectAttempt": -1, "createdAt": "2021-04-09T08:45:27.797Z", "updatedAt": "2021-07-05T05:39:15.785Z", "__v": 0, "updated_by": "604