wavelengths <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>.</mo><mn>08</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>.</mo><mn>16</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math> produce <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>40</mn></math> beats in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></math>, will be"}, "options": [{"id": "bab359", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>282</mn><mo>.</mo><mn>8</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4eefc677dc36a88ecf49"}, {"id": "28e7a0", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>175</mn><mo>.</mo><mn>5</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4eefc677dc36a88ecf4a"}, {"id": "223300", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>353</mn><mo>.</mo><mn>6</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4eefc677dc36a88ecf4b"}, {"id": "5ef2a7", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>707</mn><mo>.</mo><mn>2</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4eefc677dc36a88ecf4c"}], "questionLabels": []}, {"_id": "69de4eefc677dc36a88ecf4d", "type": "singleCorrect", "chapters": ["60e08408faa0944a2c3d491b"], "topics": ["6162fb156ed13040ec84ade8"], "concepts": ["6162fb176ed13040ec84aeb2"], "quest