/mi><mi>m</mi></mrow></mfrac></msqrt></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ada"}, {"id": "72545e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>&#960;</mi><msqrt><mfrac><mrow><mn>3</mn><mi>G</mi><mi>m</mi></mrow><msup><mi>d</mi><mn>3</mn></msup></mfrac></msqrt></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4adb"}, {"id": "fbc325", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><mn>2</mn><mi>&#960;</mi></mrow></mfrac><msqrt><mfrac><mrow><mn>3</mn><mi>G</mi><mi>m</mi></mrow><msup><mi>d</mi><mn>3</mn></msup></mfrac></msqrt></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4adc"}, {"id": "c5e77d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><mn>2</mn><mi>&#960;</mi></mrow></mfrac><msqrt><mfrac><msup><mi>d</mi><mn>3</mn></msup><mrow><mn>3</mn><mi>G</mi><mi>m</mi></mrow></mfrac></msqrt></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4add"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4ade", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e5678e499d1e49588f927a"], "concepts": ["6162faf16ed13040ec849361"], "question": {"text": "Assuming the earth to be a sphere of uniform mass density, the weight of a body at a depth <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi><mo>=</mo><mfrac><mi>R</mi><mn>2</mn></mfrac></math> from the surface of earth, if its weight on the surface of earth is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>200</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math>, will be : (Given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo></math> radius of earth)"}, "options": [{"id": "296792", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>300</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4adf"}, {"id": "b72dc8", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ae0"}, {"id": "333635", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>400</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ae1"}, {"id": "57cc3e", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>500</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ae2"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4ae3", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fb1f66f9ce3f243b4b6b"], "concepts": ["60e2fb1f66f9ce3f243b4b2f"], "question": {"text": "The escape velocity of a body on a planet <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>&#160;</mo><mi>km</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>. The escape velocity of the body on another planet <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>, whose density is four times and radius is half of the planet <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>, is&nbsp;"}, "options": [{"id": "c08db9", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>&#160;</mo><mi>km</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ae4"}, {"id": "376bd6", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn><mo>&#160;</mo><mi>km</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ae5"}, {"id": "2405da", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>36</mn><mo>&#160;</mo><mi>km</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ae6"}, {"id": "cf0359", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>&#160;</mo><mi>km</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ae7"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4ae8", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e5671c499d1e49588f87fd"], "concepts": ["60e5671a499d1e49588f87c5"], "question": {"text": "A satellite is revolving in a circular orbit at a height h from the carth surface, such that $\\mathrm{h}< < \\mathrm{R}$ where $\\mathrm{R}$ is the radius of the earth. Assuming that the effect of earth\"s atmosphere can be neglected the minimum increase in the speed required so that the satellite could escape from the gravitational field of earth is"}, "options": [{"id": "65bc15", "text": "$\\sqrt{2 g R}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ae9"}, {"id": "3ec5ca", "text": "$\\sqrt{g R}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4aea"}, {"id": "42b599", "text": "$\\sqrt{\\frac{g R}{2}}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4aeb"}, {"id": "884184", "text": "$\\sqrt{g R}(\\sqrt{2}-1)$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4aec"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4aed", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fada66f9ce3f243b4763"], "concepts": ["60e5671a499d1e49588f87cb"], "question": {"text": "Given below are two statements: one is labelled as Assertion (A) and the other is labelled as Reason (R).<br/>Assertion (A) : The radius vector from the Sun to a planet sweeps out equal areas in equal intervals of time and thus areal velocity of planet is constant.<br/>Reason (R) : For a central force field the angular momentum is a constant.<br/>In the light of the above statements, choose the most appropriate answer from the options given below :"}, "options": [{"id": "df4b8e", "text": "Both $(\\mathrm{A})$ and $(\\mathrm{R})$ are correct and $(\\mathrm{R})$ is the correct explanation of $\\mathrm{( A)}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4aee"}, {"id": "04f87d", "text": "Both $(\\mathrm{A})$ and $(\\mathrm{R})$ are correct but $(\\mathrm{R})$ is not the correct explanation of (A)", "isCorrect": null, "_id": "69de4f962ee0e063d92a4aef"}, {"id": "3f8890", "text": "(A) is correct but $(\\mathrm{R})$ is not correct", "isCorrect": null, "_id": "69de4f962ee0e063d92a4af0"}, {"id": "f4916f", "text": "(A) is not correct but (R) is correct", "isCorrect": null, "_id": "69de4f962ee0e063d92a4af1"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4af2", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fb5766f9ce3f243b4f3e"], "concepts": ["6162faee6ed13040ec849243"], "question": {"text": "<p>Consider two solid spheres of radii <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub><mo>=</mo><mn>2</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math> and masses <math><msub><mrow><mi>M</mi></mrow><mrow><mn>1</mn></mrow></msub></math> and <math><msub><mrow><mi>M</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>,</mo></math> respectively. The gravitational field due to sphere <math><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced></math> and <math><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced></math> are shown. The value of <math><mfrac><mrow><msub><mrow><mi>M</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>M</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math> is:</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F7d4a9bc3-6db6-4301-becd-b6d2a4ee2d68-image.png?alt=media\" /></p>"}, "options": [{"id": "c75bd0", "text": "<math><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4af3"}, {"id": "7b6308", "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>6</mn></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4af4"}, {"id": "712dde", "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4af5"}, {"id": "0ecc19", "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4af6"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4af7", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e5678e499d1e49588f927a"], "concepts": ["60e567fa499d1e49588fa01b"], "question": {"text": "A $90 \\mathrm{~kg}$ body placed at $2 \\mathrm{R}$ distance from surface of earth experiences gravitational pull of : $\\text { ( } \\mathrm{R}=\\text { Radius of earth, } \\mathrm{g}=10 \\mathrm{~m} \\mathrm{~s}^{-2} \\text { ) }$"}, "options": [{"id": "c13a09", "text": "$100 \\mathrm{~N}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4af8"}, {"id": "542ec9", "text": "$300 \\mathrm{~N}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4af9"}, {"id": "3e3af0", "text": "$225 \\mathrm{~N}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4afa"}, {"id": "b42a67", "text": "$120 \\mathrm{~N}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4afb"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4afc", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fb1f66f9ce3f243b4b6b"], "concepts": ["60e2fb9d66f9ce3f243b52bb"], "question": {"text": "For a body projected at an angle with the horizontal from the ground, choose the correct statement"}, "options": [{"id": "ad3eaa", "text": "Gravitational potential energy is maximum at the highest point.", "isCorrect": null, "_id": "69de4f962ee0e063d92a4afd"}, {"id": "97409a", "text": "The horizontal component of velocity is zero at highest point.", "isCorrect": null, "_id": "69de4f962ee0e063d92a4afe"}, {"id": "834eda", "text": "The vertical component of momentum is maximum at the highest point.", "isCorrect": null, "_id": "69de4f962ee0e063d92a4aff"}, {"id": "c4b27b", "text": "The kinetic energy (K.E.) is zero at the highest point of projectile motion.", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b00"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b01", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e5671c499d1e49588f87fd"], "concepts": ["60e56812499d1e49588fa38a"], "question": {"text": "Two planets <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> of equal mass are having their period of revolutions <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mi>A</mi></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mi>B</mi></msub></math> such that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mi>A</mi></msub><mo>=</mo><mn>2</mn><msub><mi>T</mi><mi>B</mi></msub></math>. These planets are revolving in the circular orbits of radii <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>r</mi><mi>A</mi></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>r</mi><mi>B</mi></msub></math> respectively. Which out of the following would be the correct relationship of their orbits?"}, "options": [{"id": "b949ef", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msubsup><mi>r</mi><mi>A</mi><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>r</mi><mi>B</mi><mn>3</mn></msubsup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b02"}, {"id": "18579d", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>r</mi><mi>A</mi><mn>3</mn></msubsup><mo>=</mo><mn>2</mn><msubsup><mi>r</mi><mi>B</mi><mn>3</mn></msubsup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b03"}, {"id": "171d2c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>r</mi><mi>A</mi><mn>3</mn></msubsup><mo>=</mo><mn>4</mn><msubsup><mi>r</mi><mi>B</mi><mn>3</mn></msubsup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b04"}, {"id": "b550e1", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>T</mi><mi>A</mi><mn>2</mn></msubsup><mo>-</mo><msubsup><mi>T</mi><mi>B</mi><mn>2</mn></msubsup><mo>=</mo><mfrac><msup><mi>&#960;</mi><mn>2</mn></msup><mrow><mi>G</mi><mi>M</mi></mrow></mfrac><mfenced><mrow><msubsup><mi>r</mi><mi>B</mi><mn>3</mn></msubsup><mo>-</mo><mn>4</mn><msubsup><mi>r</mi><mi>A</mi><mn>3</mn></msubsup></mrow></mfenced></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b05"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b06", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fada66f9ce3f243b4763"], "concepts": ["60e40fd4f1ef260f84ed1e41"], "question": {"text": "A planet takes <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>200</mn></math> days to complete one revolution around the Sun. If the distance of the planet from Sun is reduced to one fourth of the original distance, how many days will it take to complete one revolution?"}, "options": [{"id": "af91c6", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>25</mn></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b07"}, {"id": "d6f27c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b08"}, {"id": "6a73b2", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b09"}, {"id": "706fcf", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b0a"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b0b", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["6117b60a478ae845c43c63f1"], "concepts": ["6117b8bd67dbe2603c3e85a2"], "question": {"text": "<p>Four particles each of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi><mo>,</mo></math>&nbsp;move along a circle of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> under the action of their mutual gravitational attraction as shown in figure. The speed of each particle is :</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Fac46a33d-e963-4232-bcef-daa213e73a78-image.png?alt=media\" style=\"width: 242px; height: 236px;\" /></p>"}, "options": [{"id": "4224a7", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><msqrt><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><mi>R</mi></mfrac><mfenced><mrow><mn>2</mn><msqrt><mn>2</mn></msqrt><mo>+</mo><mn>1</mn></mrow></mfenced></msqrt></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b0c"}, {"id": "c9c49b", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><msqrt><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><mrow><mi>R</mi><mo>(</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><mo>+</mo><mn>1</mn><mo>)</mo></mrow></mfrac></msqrt></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b0d"}, {"id": "b164a0", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><msqrt><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><mi>R</mi></mfrac><mfenced><mrow><mn>2</mn><msqrt><mn>2</mn></msqrt><mo>-</mo><mn>1</mn></mrow></mfenced></msqrt></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b0e"}, {"id": "cf1654", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><mi>R</mi></mfrac></msqrt></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b0f"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b10", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fb5766f9ce3f243b4f3e"], "concepts": ["6162faee6ed13040ec849245"], "question": {"text": "A solid sphere of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">M</mi></math> and radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> is surrounded by a uniform concentric spherical shell of thickness <math><mn>2</mn><mi mathvariant=\"normal\">a</mi></math> and mass <math><mn>2</mn><mi mathvariant=\"normal\">M</mi><mo>.</mo></math> The gravitational field at distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi mathvariant=\"normal\">a</mi></math> from the centre will be:"}, "options": [{"id": "8291b5", "text": "<math><mfrac><mrow><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">M</mi></mrow><mrow><mn>9</mn><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b11"}, {"id": "abe12b", "text": "<math><mfrac><mrow><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">M</mi></mrow><mrow><mn>3</mn><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b12"}, {"id": "b2b969", "text": "<math><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">M</mi></mrow><mrow><mn>3</mn><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b13"}, {"id": "045bfa", "text": "<math><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">M</mi></mrow><mrow><mn>9</mn><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b14"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b15", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e5678e499d1e49588f927a"], "concepts": ["60e5678c499d1e49588f9251"], "question": {"text": "A box weighs <math><mn>196</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">N</mi></math> on a spring balance at the north pole. Its weight recorded on the same balance if it is shifted to the equator is close to (Take <math><mi mathvariant=\"normal\">g</mi><mo>=</mo><mn>10</mn><mi mathvariant=\"normal\"></mi><msup><mrow><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>2</mn></mrow></msup></math> at the north pole and the radius of the earth <math><mo>=</mo><mn>6400</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">m</mi></math> ):"}, "options": [{"id": "57d5b7", "text": "<math><mn>195.66</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">N</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b16"}, {"id": "176214", "text": "<math><mn>194.32</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">N</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b17"}, {"id": "449f7e", "text": "<math><mn>194.66</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">N</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b18"}, {"id": "ce7d1b", "text": "<math><mn>195.32</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">N</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b19"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b1a", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fb1f66f9ce3f243b4b6b"], "concepts": ["60e56768499d1e49588f8ed7"], "question": {"text": "An object is kept at rest at a distance of 3 R above the earth's surface where R is earth's radius. The minimum speed with which it must be projected so that it does not return to earth is :<br/>(Assume $\\mathrm{M}=$ mass of earth, $\\mathrm{G}=$ Universal gravitational constant)"}, "options": [{"id": "1872ea", "text": "$\\sqrt{\\frac{\\mathrm{GM}}{2 \\mathrm{R}}}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b1b"}, {"id": "8d8ede", "text": "$\\sqrt{\\frac{\\mathrm{GM}}{\\mathrm{R}}}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b1c"}, {"id": "00592d", "text": "$\\sqrt{\\frac{3 \\mathrm{GM}}{\\mathrm{R}}}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b1d"}, {"id": "70fb86", "text": "$\\sqrt{\\frac{2 \\mathrm{GM}}{\\mathrm{R}}}$", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b1e"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b1f", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e5671c499d1e49588f87fd"], "concepts": ["60f34752eff4df09e43c25d2"], "question": {"text": "A satellite is moving with a constant speed <math><mi>v</mi></math> in circular orbit around the earth. An object of mass &#39;<em>m</em>&#39; is ejected from the satellite such that it just escapes from the gravitational pull of the earth. At the time of ejection, the kinetic energy of the object is:"}, "options": [{"id": "5b3440", "text": "<math><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><mi> </mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b20"}, {"id": "8f6ea5", "text": "<math><mi>m</mi><mi> </mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b21"}, {"id": "df4059", "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><mi> </mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b22"}, {"id": "f997d3", "text": "<math><mi> </mi><mn>2</mn><mi> </mi><mi>m</mi><mi> </mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b23"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b24", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["6117b60a478ae845c43c63f1"], "concepts": ["617aa9c2ef3fe65ad8e813c5"], "question": {"text": "Three identical particle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>,</mo><mi>B</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math> of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn><mo>&#160;</mo><mi>kg</mi></math> each are placed in a straight line with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mo>=</mo><mi>B</mi><mi>C</mi><mo>=</mo><mn>13</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>. The gravitational force on a fourth particle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math> of the same mass is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>F</mi></math>, when placed at a distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>13</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math> from the particle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> on the perpendicular bisector of the line <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>C</mi></math>. The value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>F</mi></math> will be approximately"}, "options": [{"id": "cb821c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>21</mn><mi mathvariant=\"normal\">G</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b25"}, {"id": "fd95ec", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn><mi mathvariant=\"normal\">G</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b26"}, {"id": "6b4bac", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>59</mn><mi mathvariant=\"normal\">G</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b27"}, {"id": "0e4651", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>42</mn><mi mathvariant=\"normal\">G</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b28"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b29", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fb5766f9ce3f243b4f3e"], "concepts": ["6162faf16ed13040ec84936c"], "question": {"text": "<p>Find the gravitational force of attraction between the ring and sphere as shown in the diagram, where the plane of the ring is perpendicular to the line joining the centres. If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>8</mn></msqrt><mi>R</mi></math> is the distance between the centres of a ring (of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math>) and a sphere (mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math>) where both have equal radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math></p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F70040da5-f662-43fd-a575-38696a7f8c79-image.png?alt=media\" style=\"width: 251px; height: 133px;\" /></p>"}, "options": [{"id": "a9a8f0", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><msqrt><mn>2</mn></msqrt></mrow><mn>3</mn></mfrac><mfrac><mrow><mi>G</mi><mi>M</mi><mi>m</mi></mrow><msup><mi>R</mi><mn>2</mn></msup></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b2a"}, {"id": "1b4ee8", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msqrt><mn>8</mn></msqrt><mn>9</mn></mfrac><mfrac><mrow><mi>G</mi><mi>m</mi><mi>M</mi></mrow><mi>R</mi></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b2b"}, {"id": "c53d00", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><mn>3</mn><msqrt><mn>8</mn></msqrt></mrow></mfrac><mfrac><mrow><mi>G</mi><mi>M</mi><mi>m</mi></mrow><msup><mi>R</mi><mn>2</mn></msup></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b2c"}, {"id": "3f5945", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msqrt><mn>8</mn></msqrt><mn>27</mn></mfrac><mfrac><mrow><mi>G</mi><mi>m</mi><mi>M</mi></mrow><msup><mi>R</mi><mn>2</mn></msup></mfrac></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b2d"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b2e", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fada66f9ce3f243b4763"], "concepts": ["60e2fad966f9ce3f243b4719"], "question": {"text": "Choose the incorrect statement from the following:"}, "options": [{"id": "896a9d", "text": "The speed of satellite in a given circular orbit remains constant", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b2f"}, {"id": "a04399", "text": "For a planet revolving around the sun in an elliptical orbit, the total energy of the planet&nbsp;remains constant", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b30"}, {"id": "004961", "text": "The linear speed of a planet revolving around the sun remains constant", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b31"}, {"id": "2a0fbe", "text": "When a body falls towards earth, the displacement of earth towards the body is negligible", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b32"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b33", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["6117b60a478ae845c43c63f1"], "concepts": ["6162faed6ed13040ec84916e"], "question": {"text": "The planet Mars has two moons, if one of them has a period <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn></math> hours, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn></math> minutes and an orbital radius of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>.</mo><mn>0</mn><mo>&#215;</mo><msup><mn>10</mn><mn>3</mn></msup><mo>&#160;</mo><mi>km</mi><mo>.</mo></math> Find the mass of Mars.<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"\" open=\"{\"><mrow></mrow></mfenced></math> Given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"\" close=\"}\"><mrow><mfrac><mrow><mn>4</mn><msup><mi>&#960;</mi><mn>2</mn></msup></mrow><mi>G</mi></mfrac><mo>=</mo><mn>6</mn><mo>&#215;</mo><msup><mn>10</mn><mn>11</mn></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></mrow><mrow><mo>-</mo><mn>2</mn></mrow></msup><msup><mrow><mo>&#160;</mo><mi>kg</mi></mrow><mn>2</mn></msup></mrow></mfenced></math>"}, "options": [{"id": "abf924", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>.</mo><mn>96</mn><mo>&#215;</mo><msup><mn>10</mn><mn>19</mn></msup><mo>&#160;</mo><mi>kg</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b34"}, {"id": "53b020", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>.</mo><mn>25</mn><mo>&#215;</mo><msup><mn>10</mn><mn>21</mn></msup><mo>&#160;</mo><mi>kg</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b35"}, {"id": "e767f5", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn><mo>.</mo><mn>02</mn><mo>&#215;</mo><msup><mn>10</mn><mn>25</mn></msup><mo>&#160;</mo><mi>kg</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b36"}, {"id": "574e6c", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>.</mo><mn>00</mn><mo>&#215;</mo><msup><mn>10</mn><mn>23</mn></msup><mo>&#160;</mo><mi>kg</mi></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b37"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4b38", "type": "singleCorrect", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fb5766f9ce3f243b4f3e"], "concepts": ["60e2fb5666f9ce3f243b4f07"], "question": {"text": "If the radius of earth shrinks by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>%</mo></math> while its mass remains same. The acceleration due to gravity on the earth&#39;s surface will approximately"}, "options": [{"id": "7cc4e5", "text": "decrease by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>%</mo></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b39"}, {"id": "dc2bf8", "text": "decrease by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>%</mo></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b3a"}, {"id": "7f9b10", "text": "increase by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>%</mo></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b3b"}, {"id": "88b532", "text": "increase by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>%</mo></math>", "isCorrect": null, "_id": "69de4f962ee0e063d92a4b3c"}], "questionLabels": []}], "markingScheme": {"_id": "608283e223cf4b3ad8f125e6", "title": "JEE Single Correct", "correctAttempt": 4, "incorrectAttempt": -1, "createdAt": "2021-04-09T08:45:27.797Z", "updatedAt": "2021-07-05T05:39:15.785Z", "__v": 0, "updated_by": "6042252509c5bf34e8a2f178"}, "maximumAttemptLimit": 20, "linkedQuestions": [], "createdAt": "2026-04-14T14:30:46.652Z", "updatedAt": "2026-04-14T14:30:46.652Z", "__v": 0}, "position": 0, "_id": "69de4f962ee0e063d92a4cc4"}, {"sectionId": {"_id": "69de4f962ee0e063d92a4cc2", "title": "Physics Numerical", "sectionType": "normal", "subject": "607018ee404ae53194e73d90", "questions": [{"_id": "69de4f962ee0e063d92a4ca4", "type": "numerical", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fb1f66f9ce3f243b4b6b"], "concepts": ["60e2fb1f66f9ce3f243b4b2f"], "question": {"text": "The initial velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>v</mi><mi>i</mi></msub></math> required to project a body vertically upward from the surface of the earth to reach a height of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mi>R</mi></math>,&nbsp;where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> is the radius of the earth, may be described in terms&nbsp;of escape velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>v</mi><mi mathvariant=\"normal\">e</mi></msub></math> such that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><msqrt><mfrac><mi>x</mi><mi>y</mi></mfrac></msqrt><mo>&#215;</mo><msub><mi>v</mi><mi mathvariant=\"normal\">e</mi></msub></math>. The value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> will be"}, "options": [{"id": "84db35", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ca5"}, {"id": "bf31c2", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ca6"}, {"id": "d4e9da", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ca7"}, {"id": "72f00f", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4ca8"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4ca9", "type": "numerical", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e5671c499d1e49588f87fd"], "concepts": ["60e5671a499d1e49588f87c5"], "question": {"text": "A satellite of mass $\\frac{M}{2}$ is revolving around earth in a circular orbit at a height of $\\frac{R}{3}$ from earth surface. The angular momentum of the satellite is $M \\sqrt{\\frac{G M R}{x}}$. The value of $x$ is ______ , where $M$ and $R$ are the mass and radius of earth, respectively. ( G is the gravitational constant)"}, "options": [{"id": "bc98df", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4caa"}, {"id": "edd9ea", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cab"}, {"id": "3c4672", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cac"}, {"id": "90c2ba", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cad"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4cae", "type": "numerical", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e5678e499d1e49588f927a"], "concepts": ["60e567fa499d1e49588fa01b"], "question": {"text": "<p>If the acceleration due to gravity experienced by a point mass at a height <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi></math>&nbsp;above the surface of earth is same as that of the acceleration due to gravity at a depth <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mi>h</mi><mfenced><mrow><mi>h</mi><mo>&#8810;</mo><msub><mi>R</mi><mi>e</mi></msub></mrow></mfenced></math> ) from the earth surface. The value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math> will be _____ .</p><p>(use&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mi>e</mi></msub><mo>=</mo><mn>6400</mn><mo>&#160;</mo><mi>km</mi></math>)</p>"}, "options": [{"id": "ccf5c6", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4caf"}, {"id": "b9b93f", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cb0"}, {"id": "364462", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cb1"}, {"id": "60efe4", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cb2"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4cb3", "type": "numerical", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["60e2fada66f9ce3f243b4763"], "concepts": ["60e40fd4f1ef260f84ed1e41"], "question": {"text": "If the earth suddenly shrinks to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>64</mn></mfrac><mi>th</mi></math> of its original volume with its mass remaining the same, the period of rotation of earth becomes <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>24</mn><mi>x</mi></mfrac><mi>h</mi></math>. The value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> is ________"}, "options": [{"id": "2257ac", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cb4"}, {"id": "c379f6", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cb5"}, {"id": "906706", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cb6"}, {"id": "ad5296", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cb7"}], "questionLabels": []}, {"_id": "69de4f962ee0e063d92a4cb8", "type": "numerical", "chapters": ["60c9e849ea076dc381c0dfb0"], "topics": ["6117b60a478ae845c43c63f1"], "concepts": ["6117b607478ae845c43c62fb"], "question": {"text": "Three identical spheres of mass m , are placed at the vertices of an equilateral triangle of length a. When released, they interact only through gravitational force and collide after a time $\\mathrm{T}=4$ seconds. If the sides of the triangle are increased to length 2 a and also the masses of the spheres are made 2 m , then they will collide after _____ seconds."}, "options": [{"id": "01551a", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cb9"}, {"id": "208925", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cba"}, {"id": "165368", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cbb"}, {"id": "fdaabe", "text": "", "isCorrect": null, "_id": "69de4f962ee0e063d92a4cbc"}], "questionLabels": []}], "markingScheme": {"_id": "608283c623cf4b3ad8f125e5", "title": "JEE Numerical", "correctAttempt": 4, "incorrectAttempt": -1, "createdAt": "2021-04-09T08:45:27.797Z", "updatedAt": "2021-07-05T05:39:27.056Z", "__v": 0, "updated_by": "6042252509c5bf34e8a2f178"}, "maximumAttemptLimit": 5, "linkedQuestions": [], "createdAt": "2026-04-14T14:30:46.721Z", "updatedAt": "2026-04-14T14:30:46.721Z", "__v": 0}, "position": 1, "_id": "69de4f962ee0e063d92a4cc5"}], "bonusSections": [], "packDetails": [], "paidFeatures": [], "tags": [], "timeRestrict