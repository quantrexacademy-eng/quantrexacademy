uantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Facda6ddd-da60-4de0-b61f-beb3af34b32a.png?alt=media\" style=\"width: 150px; height: 77px;\" /></p><p>(D)&nbsp;<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Fda92c9f4-3a01-480a-b6e5-6fe908e6c085.png?alt=media\" style=\"width: 200px; height: 74px;\" /></p><p>(E)&nbsp;<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2Ffa617c4b-0a3d-41ce-a1b4-e4b4b99bd4fb.png?alt=media\" style=\"width: 200px; height: 78px;\" /></p><p>Choose the correct answer from the options given below:</p>"}, "options": [{"id": "df3aeb", "text": "C &gt; E &gt; D &gt; B &gt; A", "isCorrect": null, "_id": "69de4f392ee0e063d9253bf7"}, {"id": "6eacb5", "text": "E &gt; D &gt; C &gt; B &gt; A", "isCorrect": null, "_id": "69de4f392ee0e063d9253bf8"}, {"id": "a0ddd4", "text": "D &gt; E &gt; C &gt; A &gt; B", "isCorrect": null, "_id": "69de4f392ee0e063d9253bf9"}, {"id": "423c16", "text": "E &gt; C &gt; D &gt; A &gt; B", "isCorrect": null, "_id": "69de4f392ee0e063d9253bfa"}], "questionLabels": []}, {"_id": "69de4f392ee0e063d9253bfb", "type": "singleCorrect", "chapters": ["60ced3330e34b73944ddfaf4"], "topics": ["60e567fc499d1e49588fa045"], "concepts": ["6117b9d167dbe2603c3eacf0"], "question": {"text": "The correct match between items I and II is :\n\n<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2FJZKj3Bt0ahGoMVCv9ZF08z3Y68EW2HdOJy6XsxzyavE.original.fullsize.png?alt=media\">"}, "options": [{"id": "201198", "text": "$(\\mathrm{A}) \\rightarrow(\\mathrm{S}) ;(\\mathrm{B}) \\rightarrow(\\mathrm{R}) ;(\\mathrm{C}) \\rightarrow(\\mathrm{P})$", "isCorrect": null, "_id": "69de4f392ee0e063d9253bfc"}, {"id": "35fb21", "text": "(A) $\\rightarrow(\\mathrm{Q}) ;(\\mathrm{B}) \\rightarrow(\\mathrm{R}) ;(\\mathrm{C}) \\rightarrow(\\mathrm{S})$", "isCorrect": null, "_id": "69de4f392ee0e063d9253bfd"}, {"id": "94c477", "text": "(A) $\\rightarrow$ (R); (B) $\\rightarrow$ (P); (C) $\\rightarrow$ (S)", "isCorrect": null, "_id": "69de4f392ee0e063d9253bfe"}, {"id": "8fa019", "text": "(A) $\\rightarrow(\\mathrm{Q}) ;(\\mathrm{B}) \\rightarrow(\\mathrm{R}) ;(\\mathrm{C}) \\rightarrow(\\mathrm{P})$", "isCorrect": null, "_id": "69de4f392ee0e063d9253bff"}], "questionLabels": []}, {"_id": "69de4f392ee0e063d9253c00", "type": "singleCorrect", "chapters": ["60ced3330e34b73944ddfaf4"], "topics": ["60e56814499d1e49588fa3a9"], "concepts": ["61ab78a66fe44bfe0fe4a346"], "question": {"text": "Which of the following compounds does not exhibit resonance ?"}, "options": [{"id": "60224a", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mi>OCH</mi><mo>=</mo><msub><mi>CH</mi><mn>2</mn></msub></math>", "isCorrect": null, "_id": "69de4f392ee0e063d9253c01"}, {"id": "6dba07", "text": "<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjee_main%2F763d32ce-9eb5-4120-a1f9-1eaf2008cab9-image.png?alt=media\" style=\"width: 200px; height: 124px;\" />", "isCorrect": null, "_id": "69de4f392ee0e063d9253c02"}, {"id": "9799e4", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>CONH</mi><mn>2</mn></msub></math>", "isCorrect": null, "_id": "69de4f392ee0e063d9253c03"}, {"id": "b43228", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mi>CH</mi><mo>=</mo><msub><mi>CHCH</mi><mn>2</mn></msub><msub><mi>NH</mi><mn>2</mn></msub></math>", "isCorrect": null, "_id": "69de4f392ee0e063d9253c04"}], "questionLabels": []}, {"_id": "69de4f392ee0e063d9253c05", "type": "singleCor