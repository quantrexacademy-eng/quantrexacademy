ML\"><mi mathvariant=\"normal\">B</mi><mo>&#60;</mo><mi mathvariant=\"normal\">A</mi><mo>&#60;</mo><mi mathvariant=\"normal\">D</mi><mo>&#60;</mo><mi mathvariant=\"normal\">C</mi></math>", "isCorrect": null, "_id": "69de4f592ee0e063d926f157"}, {"id": "ac5fa0", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>&#60;</mo><mi mathvariant=\"normal\">D</mi><mo>&#60;</mo><mi mathvariant=\"normal\">A</mi><mo>&#60;</mo><mi mathvariant=\"normal\">C</mi></math>", "isCorrect": null, "_id": "69de4f592ee0e063d926f158"}, {"id": "84baa9", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>&#60;</mo><mi mathvariant=\"normal\">A</mi><mo>&#60;</mo><mi mathvariant=\"normal\">C</mi><mo>&#60;</mo><mi mathvariant=\"normal\">D</mi></math>", "isCorrect": null, "_id": "69de4f592ee0e063d926f159"}], "questionLabels": []}, {"_id": "69de4f592ee0e063d926f15a", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb1f66f9ce3f243b4b41"], "question": {"text": "The type of oxide formed by the element among $\\mathrm{Li}, \\mathrm{Na}, \\mathrm{Be}, \\mathrm{Mg}, \\mathrm{B}$ and Al that has the least atomic radius is :"}, "options": [{"id": "712fbb", "text": "$\\mathrm{A}_2 \\mathrm{O}$", "isCorrect": null, "_id": "69de4f592ee0e063d926f15b"}, {"id": "7ba1da", "text": "$\\mathrm{A}_2 \\mathrm{O}_3$", "isCorrect": null, "_id": "69de4f592ee0e063d926f15c"}, {"id": "2180a0", "text": "$\\mathrm{AO}_2$", "isCorrect": null, "_id": "69de4f592ee0e063d926f15d"}, {"id": "0a2a82", "text": "$\\mathrm{AO}$", "isCorrect": null, "_id": "69de4f592ee0e063d926f15e"}], "questionLabels": []}, {"_id": "69de4f592ee0e063d926f15f", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "The process that is NOT endothermic in nature is :"}, "options":