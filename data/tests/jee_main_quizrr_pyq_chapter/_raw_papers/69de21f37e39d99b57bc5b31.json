m{Si}\\gt\\mathrm{P}\\gt\\mathrm{Cl}\\gt\\mathrm{F}$", "isCorrect": null, "_id": "69de4f592ee0e063d926f16f"}, {"id": "5311df", "text": "$\\mathrm{Be}\\gt\\mathrm{Mg}\\gt\\mathrm{Al}\\gt\\mathrm{Si}$", "isCorrect": null, "_id": "69de4f592ee0e063d926f170"}, {"id": "4e2f22", "text": "$\\mathrm{Al}\\gt\\mathrm{B}\\gt\\mathrm{N}\\gt\\mathrm{F}$", "isCorrect": null, "_id": "69de4f592ee0e063d926f171"}, {"id": "08a21a", "text": "$\\mathrm{Mg}\\gt\\mathrm{Al}\\gt\\mathrm{C}\\gt\\mathrm{O}$", "isCorrect": null, "_id": "69de4f592ee0e063d926f172"}], "questionLabels": []}, {"_id": "69de4f592ee0e063d926f173", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "<p>Identify the elements <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">Y</mi></math> using the ionization energy values given below :</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable><mtr><mtd/><mtd><mi>Ionization</mi><mo>&#160;</mo><mi>energy</mi></mtd><mtd><mo>(</mo><mi>kJ</mi><mo>/</mo><mi>mol</mi><mo>)</mo></mtd></mtr><mtr><mtd/><mtd><msup><mn>1</mn><mi>st</mi></msup></mtd><mtd><msup><mn>2</mn><mi>nd</mi></msup></mtd></mtr><mtr><mtd><mi mathvariant=\"normal\">X</mi></mtd><mtd><mn>495</mn></mtd><mtd><mn>4563</mn></mtd></mtr><mtr><mtd><mi mathvariant=\"normal\">Y</mi></mtd><mtd><mn>731</mn></mtd><mtd><mn>1450</mn></mtd></mtr></mtable></math></p>"}, "options": [{"id": "75c3d9", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi><mo>=</mo><mi>Na</mi><mo>;</mo><mi mathvariant=\"normal\">Y</mi><mo>=</mo><mi>Mg</mi></math>", "isCorrect": null, "_id": "69de4f592ee0e063d926f174"}, {"id": "9cf2eb", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi><mo>=</mo><mi>Mg</mi><mo>;</mo><mi mathvariant=\"normal\">Y</mi><mo>=</mo><mi mathvariant=\"normal\">F</mi></math>", "isCorrect": null, "_id": "69de4f592ee0e063d926f175"}, {"id": "23c30b", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi><mo>=</mo><mi>Mg</mi><mo>;</mo><mi mathvariant=\"normal\">Y</mi><mo>=</mo><mi>Na</mi></math>", "isCorrect": null, "_id": "69de4f592ee0e063d926f176"}, {"id": "27aa6f", "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi><mo>=</mo><mi mathvariant=\"normal\">F</mi><mo>;</mo><mi mathvariant=\"normal\">Y</mi><mo>=</mo><mi>Mg</mi></math>", "isCorrect": null, "_id": "69de4f592ee0e063d926f177"}], "questionLabels": []}, {"_id": "69de4f592ee0e063d926f178", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "The successive 5 ionisation energies of an element are $800,2427,3658,25024$ and $32824 \\mathrm{~kJ} / \\mathrm{mol}$, respectively. By using the above values predict the group in which the above element is present :"}, "options": [{"id": "20a136", "text": "Group 13", "isCorrect": null, "_id": "69de4f592ee0e063d926f179"}, {"id": "10f3a8", "text": "Group 14", "isCorrect": null, "_id": "69de4f592ee0e063d926f17a"}, {"id": "f5118a", "text": "Group 2", "isCorrect": null, "_id": "69de4f592ee0e063d926f17b"}, {"id": "d8ea91", "text": "Group 4", "isCorrect": null, "_id": "69de4f592ee0e063d926f17c"}], "questionLabels": []}, {"_id": "69de4f592ee0e063d926f17d", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "Given below are two statements :<br/>Statement (I) : Both metal and non-metal exist in $\\mathrm{p}$ and d-block elements.<br/>Statement (II) : Non-metals have higher ionisation enthalpy and higher electronegativity than the metals.<br/>In the light of the above statements, choose the most appropriate answer from the option given below:"}, "options": [{"id": "f18ba6", "text": "Both Statement I and Statement II are false", "isCorrect": null, "_id": "69de4f592ee0e063d926f17e"}, {"id": "d3330a", "text": "Statement I is false but Statement II is true", "isCorrect": null, "_id": "69de4f592ee0e063d926f17f"}, {"id": "1c84c6", "text": "Statement I is true but Statement II is false", "isCorrect": null, "_id": "69de4f592ee0e063d926f180"}, {"id": "9df7ce", "text": "Both Statement I and Statement II are true", "isCorrect": null, "_id": "69de4f592ee0e063d926f181"}], "questionLabels": []}, {"_id": "69de4f592ee0e063d926f182", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "An element ' \\(E^{\\prime}\\) has the ionisation enthalpy value of \\(374 \\mathrm{~kJ} \\mathrm{~mol}^{-1}\\). ' \\(E\\) ' reacts with elements \\(\\mathrm{A}, \\mathrm{B}, \\mathrm{C}\\) and D with electron gain enthalpy values of \\(-328,-349,-325\\) and \\(-295 \\mathrm{~kJ} \\mathrm{~mol}^{-1}\\), respectively. The correct order of the products EA, EB, EC and ED in terms of ionic character is :"}, "options": [{"id": "1df51a", "text": "\\(\\mathrm{ED}\\gt\\mathrm{EC}\\gt\\mathrm{EB}\\gt\\mathrm{EA}\\)", "isCorrect": null, "_id": "69de4f592ee0e063d926f183"}, {"id": "febc61", "text": "\\(\\mathrm{EA}\\gt\\mathrm{EB}\\gt\\mathrm{EC}\\gt\\mathrm{ED}\\)", "isCorrect": null, "_id": "69de4f592ee0e063d926f184"}, {"id": "6820ea", "text": "\\(\\mathrm{EB}\\gt\\mathrm{EA}\\gt\\mathrm{EC}\\gt\\mathrm{ED}\\)", "isCorrect": null, "_id": "69de4f592ee0e063d926f185"}, {"id": "2254f2", "text": "\\(\\mathrm{ED}\\gt\\mathrm{EC}\\gt\\mathrm{EA}\\gt\\mathrm{EB}\\)", "isCorrect": null, "_id": "69de4f592ee0e063d926f186"}], "questionLabels": []}, {"_id": "69de4f592ee0e063d926f187", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "The correct order of first ionization enthalpy values of the following elements is :\n(A) \\(\\mathrm{O}\\)\n(B) \\(\\mathrm{N}\\)\n(C) \\(\\mathrm{Be}\\)\n(D) \\(\\mathrm{F}\\)\n(E) \\(\\mathrm{B}\\)\nChoose the correct answer from the options given below :"}, "options": [{"id": "af3c7c", "text": "E \\( < \\) C \\( < \\) A \\( < \\) B \\( < \\) D", "isCorrect": null, "_id": "69de4f592ee0e063d926f188"}, {"id": "8a04ea", "text": "C \\( < \\) E \\( < \\) A \\( < \\) B \\( < \\) D", "isCorrect": null, "_id": "69de4f592ee0e063d926f189"}, {"id": "a7fff3", "text": "B \\( < \\) D \\( < \\) C \\( < \\) E \\( < \\) A", "isCorrect": null, "_id": "69de4f592ee0e063d926f18a"}, {"id": "859b3c", "text": "A \\( < \\) B \\( < \\) D \\( < \\) C \\( < \\) E", "isCorrect": null, "_id": "69de4f592ee0e063d926f18b"}], "questionLabels": []}, {"_id": "69de4f592ee0e063d926f18c", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "The correct order of the first ionization enthalpy is"}, "options": [{"id": "95e2a0", "text": "\\(\\mathrm{Al} > \\mathrm{Ga} > \\mathrm{Tl}\\)", "isCorrect": null, "_id": "69de4f592ee0e063d926f18d"}, {"id": "ae7192", "text": "\\(\\mathrm{Ga} > \\mathrm{Al} > \\mathrm{B}\\)", "isCorrect": null, "_id": "69de4f592ee0e063d926f18e"}, {"id": "70b7b9", "text": "\\(\\mathrm{Tl} > \\mathrm{Ga} > \\mathrm{Al}\\)", "isCorrect": null, "_id": "69de4f592ee0e063d926f18f"}, {"id": "309e05", "text": "\\(\\mathrm{B} > \\mathrm{Al} > \\mathrm{Ga}\\)", "isCorrect": null, "_id": "69de4f592ee0e063d926f190"}], "questionLabels": []}, {"_id": "69de4f592ee0e063d926f191", "type": "singleCorrect", "chapters": ["60d3035eaf049203d85366a4"], "topics": ["60e2fada66f9ce3f243b477e"], "concepts": ["60e2fb9d66f9ce3f243b52dc"], "question": {"text": "The elements of Group 13 with highest and lowest first io