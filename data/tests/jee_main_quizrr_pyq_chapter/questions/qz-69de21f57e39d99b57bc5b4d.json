ebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-2f7083dfce912766.png?alt=media&v=stem2\" style=\"width: 262px; height: 172px;\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-2f7083dfce912766.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-2f7083dfce912766.png\">","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-f5cf287ef5375e8a.png?alt=media&v=stem2\" style=\"width: 273px; height: 136px;\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-f5cf287ef5375e8a.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-f5cf287ef5375e8a.png\">","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-e530ea9366ad9a2d.png?alt=media&v=stem2\" style=\"width: 355px; height: 139px;\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-e530ea9366ad9a2d.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-e530ea9366ad9a2d.png\">"],"answer":0,"answers":[0],"questionType":"singleCorrect","subject":"Chemistry","chapter":"Hydrocarbons","exam":"JEE Main","source":"Quantrex PYQ Chapterwise","solution":"<p>During the reaction, first addition of water takes place according to Markownikoff's rule, alcohol is formed, ${CrO}_{3}$ acts as an oxidising agents which converts alcohol into ketone, then Wolf Kishner reduction occurs.</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-5f2ad7ce1c6ddf07.png?alt=media&v=stem2\" style=\"width: 600px; height: 266px;\" / data-qx-orig-src=\"/assets/diagrams/qx-book-5f2ad7ce1c6ddf07.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-5f2ad7ce1c6ddf07.png\"></p><p>Hence option A is the answer.</p>","_bank":"quizrr_pyq_chapter","_testId":"69de21f57e39d99b57bc5b4d"},{"id":"qz_69de4f7f2ee0e063d928f974","_quizrrId":"69de4f7f2ee0e063d928f974","q":"<p>The major product of the following reaction is</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-d181600101035f9d.png?alt=media&v=stem2\" style=\"width: 222px; height: 47px;\" / data-qx-orig-src=\"/assets/diagrams/qx-book-d181600101035f9d.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-d181600101035f9d.png\"></p>","options":["$C{H}_{3}CD\\left(I\\right)CHD ( Cl )$","$C{H}_{3}CD\\left(Cl\\right)CHD ( I )$","$C{H}_{3}C{D}_{2}CH\\left(Cl\\right) ( I )$","$C{H}_{3}C\\left(I\\right)\\left(Cl\\right)CH{D}_{2}$"],"answer":3,"answers":[3],"questionType":"singleCorrect","subject":"Chemistry","chapter":"Hydrocarbons","exam":"JEE Main","source":"Quantrex PYQ Chapterwise","solution":"<p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-8d0cf764cafef906.png?alt=media&v=stem2\" style=\"width: 610px; height: 332px;\" / data-qx-orig-src=\"/assets/diagrams/qx-book-8d0cf764cafef906.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-8d0cf764cafef906.png\"><br />Addition according to Markovnikov’s Rule</p>","_bank":"quizrr_pyq_chapter","_testId":"69de21f57e39d99b57bc5b4d"},{"id":"qz_69de4f7f2ee0e063d928f979","_quizrrId":"69de4f7f2ee0e063d928f979","q":"<p>Identify product A and product B</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-25c62a1681c79e63.png?alt=media&v=stem2\" style=\"width: 541px; height: 189px;\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-25c62a1681c79e63.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-25c62a1681c79e63.png\"></p>","options":["<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-1df149224e014549.png?alt=media&v=stem2\" style=\"width: 399px; height: 242px;\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-1df149224e014549.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-1df149224e014549.png\">","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-05ada752fb07ade8.png?alt=media&v=stem2\" style=\"width: 380px; height: 253px;\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-05ada752fb07ade8.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-05ada752fb07ade8.png\">","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-a70feba324f80882.png?alt=media&v=stem2\" style=\"width: 480px; height: 186px;\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-a70feba324f80882.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-a70feba324f80882.png\">","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-68c8f65e667dc361.png?alt=media&v=stem2\" style=\"width: 450px; height: 248px;\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-68c8f65e667dc361.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-68c8f65e667dc361.png\">"],"answer":3,"answers":[3],"questionType":"singleCorrect","subject":"Chemistry","chapter":"Hydrocarbons","exam":"JEE Main","source":"Quantrex PYQ Chapterwise","solution":"<p>The allylic position is a carbon position present adjacent to the carbon-carbon double bonds. The allylic carbon is attached to a carbon atom that forms a double bond with a different carbon atom. A substitution could be a reaction during which a group in an organic molecule is replaced with another group.</p><p>When the halogen concentration is low enough, alkenes containing allylic hydrogen undergo substitution at the allylic position rather than addition at the double bond. The product is an allylic halide (halogen on carbon next to double bond carbons), which is acquired through a radical chain mechanism.</p><p>When cyclohexene reacts with Chlorine in the presence of ${CCl}_{4}$, the electrophilic addition reaction takes place at double bond, which results in a dichloro product, here it is $1, 2 -$dicholorocyclohexane.</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-d8819b75272e824a.png?alt=media&v=stem2\" style=\"width: 600px; height: 306px;\" / data-qx-orig-src=\"/assets/diagrams/qx-book-d8819b75272e824a.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-d8819b75272e824a.png\"></p><p>Hence, the correct answer is D.</p>","_bank":"quizrr_pyq_chapter","_testId":"69de21f57e39d99b57bc5b4d"},{"id":"qz_69de4f7f2ee0e063d928f97e","_quizrrId":"69de4f7f2ee0e063d928f97e","q":"Which compound would give 3-methyl-6oxoheptanal upon ozonolysis?","options":["<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-27923f2dd7fce1fd.png?alt=media&v=stem2\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-27923f2dd7fce1fd.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-27923f2dd7fce1fd.png\"><br/>","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-bb6b69fabb6ae0a2.png?alt=media&v=stem2\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-bb6b69fabb6ae0a2.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-bb6b69fabb6ae0a2.png\"><br/>","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-0ff632f15b4592c8.png?alt=media&v=stem2\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-0ff632f15b4592c8.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-0ff632f15b4592c8.png\"><br/>","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-f7a0c6b32893204b.png?alt=media&v=stem2\"/ data-qx-orig-src=\"/assets/diagrams/qx-book-f7a0c6b32893204b.png\" data-qx-storage-src=\"/assets/diagrams/qx-book-f