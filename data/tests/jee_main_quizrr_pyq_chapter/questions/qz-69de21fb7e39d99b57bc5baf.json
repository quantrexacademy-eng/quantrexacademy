o/questions%2Ffigs%2Fdiagrams%2Fqx-book-ba1e7f805d695cca.png?alt=media&v=qxmd265\" style=\"width: 253px; height:auto;max-width:100%;display:block;background:#fff;\" data-qx-orig-src=\"/assets/diagrams/qx-book-ba1e7f805d695cca.png\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-ba1e7f805d695cca.png?alt=media&v=qxmd265\" onerror=\"if(window.QxOwnedFigs&&QxOwnedFigs.retryOnError)QxOwnedFigs.retryOnError(this)\" class=\"qx-pool-fig qx-no-wm qx-sol-fig\" decoding=\"async\" loading=\"eager\">"],"answer":3,"answers":[3],"questionType":"singleCorrect","subject":"Chemistry","chapter":"Biomolecules","exam":"JEE Main","source":"Quantrex PYQ Chapterwise","solution":"<p>The structure of Tyrosine amino acid is</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-677ab05f7a93d493.png?alt=media&v=qxmd265\" style=\"width: 287px; height:auto;max-width:100%;display:block;background:#fff;\" data-qx-orig-src=\"/assets/diagrams/qx-book-677ab05f7a93d493.png\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-677ab05f7a93d493.png?alt=media&v=qxmd265\" onerror=\"if(window.QxOwnedFigs&&QxOwnedFigs.retryOnError)QxOwnedFigs.retryOnError(this)\" class=\"qx-pool-fig qx-no-wm qx-sol-fig\" decoding=\"async\" loading=\"eager\"></p>\n,","_bank":"quizrr_pyq_chapter","_testId":"69de21fb7e39d99b57bc5baf","_resolvedFrom":"quizrr_submit"},{"id":"qz_69de4f822ee0e063d9292f3d","_quizrrId":"69de4f822ee0e063d9292f3d","q":"<p>& The correct observation in the following reaction is:</p><p>$Sucrose\\mathop{→}_{Cleavage ( Hydrolysis )}^{Glycosidicbond}A + B\\mathop{→}_{Reagent}^{Seliwanoff} ?$</p>","options":["& Formation of blue colour","& Gives no colour","& Formation of red colour","& Formation of violet colour"],"answer":0,"answers":[0],"questionType":"singleCorrect","subject":"Chemistry","chapter":"Biomolecules","exam":"JEE Main","source":"Quantrex PYQ Chapterwise","solution":"<p>Seliwanoff reagent$\\to[$Resorcinol$+$ Conc. $HCl ]$& </p><p>Seliwanoff's test is a chemical test which distinguishes between aldose and ketose sugars. If the sugar contains a ketone group, it is a ketose. If a sugar contains an aldehyde group, it is an aldose.</p><p>& Ketoses show red colour with Seliwanoff Reagent.</p>\n!","_bank":"quizrr_pyq_chapter","_testId":"69de21fb7e39d99b57bc5baf"},{"id":"qz_69de4f822ee0e063d9292f42","_quizrrId":"69de4f822ee0e063d9292f42","q":"Which one of the following compounds contains $\\beta - {C}_{1} - {C}_{4}$ glycosidic linkage ?","options":["Sucrose","Amylose","Lactose","Maltose"],"answer":0,"answers":[0],"questionType":"singleCorrect","subject":"Chemistry","chapter":"Biomolecules","exam":"JEE Main","source":"Quantrex PYQ Chapterwise","solution":"- Maltose is composed of two glucose units.\n- Sucrose has glycosidic linkage between $\\mathrm{C}_1$ of $\\alpha$-glucose and $C_2$ of $\\beta$-fructose.\n- Lactose is composed of galactose and glucose\n- Amylose has glycosidic linkage between $C_1$ of $\\alpha$-glucose $C_4$ of $\\alpha$-glucose.","_bank":"quizrr_pyq_chapter","_testId":"69de21fb7e39d99b57bc5baf"},{"id":"qz_69de4f822ee0e063d9292f47","_quizrrId":"69de4f822ee0e063d9292f47","q":"Which of the following is correct structure of $\\alpha$-anomer of maltose?","options":["<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-10b100cf982d47a9.png?alt=media&v=qxmd265\" style=\"width: 336px; height:auto;max-width:100%;display:block;background:#fff;\" data-qx-orig-src=\"/assets/diagrams/qx-book-10b100cf982d47a9.png\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-10b100cf982d47a9.png?alt=media&v=qxmd265\" onerror=\"if(window.QxOwnedFigs&&QxOwnedFigs.retryOnError)QxOwnedFigs.retryOnError(this)\" class=\"qx-pool-fig qx-no-wm qx-sol-fig\" decoding=\"async\" loading=\"eager\">","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-2f2a1e8185dd2d33.png?alt=media&v=qxmd265\" style=\"width: 336px; height:auto;max-width:100%;display:block;background:#fff;\" data-qx-orig-src=\"/assets/diagrams/qx-book-2f2a1e8185dd2d33.png\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-2f2a1e8185dd2d33.png?alt=media&v=qxmd265\" onerror=\"if(window.QxOwnedFigs&&QxOwnedFigs.retryOnError)QxOwnedFigs.retryOnError(this)\" class=\"qx-pool-fig qx-no-wm qx-sol-fig\" decoding=\"async\" loading=\"eager\">","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-bea723b672ec7dca.png?alt=media&v=qxmd265\" style=\"width: 336px; height:auto;max-width:100%;display:block;background:#fff;\" data-qx-orig-src=\"/assets/diagrams/qx-book-bea723b672ec7dca.png\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-bea723b672ec7dca.png?alt=media&v=qxmd265\" onerror=\"if(window.QxOwnedFigs&&QxOwnedFigs.retryOnError)QxOwnedFigs.retryOnError(this)\" class=\"qx-pool-fig qx-no-wm qx-sol-fig\" decoding=\"async\" loading=\"eager\">","<img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-852740f80888c3c5.png?alt=media&v=qxmd265\" style=\"width: 336px; height:auto;max-width:100%;display:block;background:#fff;\" data-qx-orig-src=\"/assets/diagrams/qx-book-852740f80888c3c5.png\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-852740f80888c3c5.png?alt=media&v=qxmd265\" onerror=\"if(window.QxOwnedFigs&&QxOwnedFigs.retryOnError)QxOwnedFigs.retryOnError(this)\" class=\"qx-pool-fig qx-no-wm qx-sol-fig\" decoding=\"async\" loading=\"eager\">"],"answer":0,"answers":[0],"questionType":"singleCorrect","subject":"Chemistry","chapter":"Biomolecules","exam":"JEE Main","source":"Quantrex PYQ Chapterwise","solution":"<p>$\\alpha$ -ANOMER OF MALTOSE</p><p>maltose is disaccharides of $\\alpha$ -$D$- glucopyranose by ${C}_{1} - {C}_{4}$ glycosidic linkage</p><p><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-fe545bd26902917c.png?alt=media&v=qxmd265\" style=\"width: 285px; height:auto;max-width:100%;display:block;background:#fff;\" data-qx-orig-src=\"/assets/diagrams/qx-book-fe545bd26902917c.png\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-fe545bd26902917c.png?alt=media&v=qxmd265\" onerror=\"if(window.QxOwnedFigs&&QxOwnedFigs.retryOnError)QxOwnedFigs.retryOnError(this)\" class=\"qx-pool-fig qx-no-wm qx-sol-fig\" decoding=\"async\" loading=\"eager\"></p><p>Maltose or malt sugar is a disaccharide composed of two glucose molecules connected with an alpha (1,4) glycosidic bond.</p><p>Maltose is a reducing sugar. It's two glucose molecules must be linked in such a way as to leave one anomeric carbon that can open to form an aldehyde group.</p>\n~","_bank":"quizrr_pyq_chapter","_testId":"69de21fb7e39d99b57bc5baf","_resolvedFrom":"official_bank_multiSame"},{"id":"qz_69de4f822ee0e063d9292f4c","_quizrrId":"69de4f822ee0e063d9292f4c","q":"Which of the following statements is not true about sucrose?","options":["It is also named as invert sugar.","It is a non-reducing sugar.","The glycosidic linkage is present Between ${C}_{1}$ of $\\alpha$ -glucose and ${C}_{1}$ of $\\beta$ -fructose.","On hydrolysis, it produces glucose and fructose."],"answer":2,"answers":[2],"questionType":"singleCorrect","subject":"Chemistry","chapter":"Biomolecules","exam":"JEE Main","source":"Quantrex PYQ Chapterwise","solution":"Sucrose is a disaccharide which is formed due to glycosidic linkage between $C1$ of $\\alpha -$ glucose and ${C}_{2}$ of $\\beta -$ fructose.<br /><img src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-b3910de26ab905f4.png?alt=media&v=qxmd265\" style=\"width: 500px; height:auto;max-width:100%;display:block;background:#fff;\" data-qx-orig-src=\"/assets/diagrams/qx-book-b3910de26ab905f4.png\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fdiagrams%2Fqx-book-b3910de26ab905f4.png?alt=media&v=qxmd265\" onerror=\"if(window.QxOwnedFigs&&QxOwnedFigs.retryOnError)QxOwnedFigs.retryOnError(this)\" class=\"qx-pool-fig qx-no-wm qx-sol-fig\" decoding=\"async\" loading=\"eager\"><br />Sucrose also named as invert sugar, and it is a non-reducing sugar.","_bank":"quizrr_pyq_chapter","_testId":"69de21fb7e39d99b57bc5baf"},{"id":"qz_69de4f822ee0e063d9292f51","_quizrrId":"69de4f822ee0e063d9292f51","q":"Given below are two statements:<br /><strong>Statement I :</strong> D-(+)-glucose $+\\mathrm{D}-(+)$ fructose $\\xrightarrow{-\\mathrm{H}_2 \\mathrm{O}}$ sucrose <br><strong>Statement II :</strong> Invert sugar is formed during sucrose hydrolysis.<br />In the light of the above statements, choose the <em>correct</em> answer from the options given below -","options":["Both Statement I and Statement II are true.","Statement I is false but Statement II are true.","Statement I is true but Statement II is false.","Both Statement I and Statement II are false."],"answer":1,"answers":[1],"questionType":"singleCorrect","subject":"Chemistry","chapter":"Biomolecules","exam":"JEE Main","source":"Quantrex PYQ Chapterwise","solution":"On hydrolysis of sucrose gives D-(+)-glucose and D-(-)-fructose while in St. (1) D-(+)-fructose is given evince St-(1) is incorrect.<br /><strong>St. II</strong> - It is correct because sucrose on hydrolysis gives invert sugar","_bank":"quizrr_pyq_chapter","_testId":"69de21fb7e39d99b57bc5baf"}]}