com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2Fjeb0v30uIPQXPk6ymp3tyyigOGvFEB3DZZM-BsqufZo.original.fullsize.png?alt=media\">","difficulty":"Medium","source":"BITSAT 2021","_marksId":"64c0e8256f5bfc7ab78aeafe","answers":[1],"questionType":"singleCorrect"},{"id":17254,"subject":"Chemistry","chapter":"Alcohols Phenols and Ethers","exam":"Engineering","examName":"BITSAT","q":"On reaction with sodium, 1 mol of a compound $\\mathrm{X}$ gives $1 \\mathrm{~mol}$ of $\\mathrm{H}_{2} .$ Which one of the following compounds might be $X ?$","options":["$\\mathrm{CH}_{3} \\mathrm{CH}_{2} \\mathrm{CH}=\\mathrm{CH}_{2}$","$\\mathrm{CH}_{3} \\mathrm{COOCH}_{2} \\mathrm{CH}_{3}$","$\\mathrm{CH}_{3} \\mathrm{CH}_{2} \\mathrm{CH}_{2} \\mathrm{OH}$","$\\mathrm{CH}_{2}(\\mathrm{OH}) \\mathrm{CH}_{2} \\mathrm{CH}_{2} \\mathrm{CH}_{2} \\mathrm{OH}$"],"answer":3,"solution":"Since 1 mole of compound Xreacts with Na to evolve 1 mole of $\\mathrm{H}_{2}$ gas, therefore the compound should have 2 active hydrogen atoms per mole which is possible only in option $d$.\r\n\r\n$\\begin{array}{l}\r\n\r\n\\mathrm{CH}_{2} \\mathrm{OHCH}_{2} \\mathrm{CH}_{2} \\mathrm{CH}_{2} \\mathrm{OH}+2 \\mathrm{Na} \\\\\r\n\r\n\\longrightarrow \\mathrm{NaOCH}_{2} \\mathrm{CH}_{2} \\mathrm{CH}_{2} \\mathrm{CH}_{2} \\mathrm{ONa}+2 \\mathrm{H}\r\n\r\n\\end{array}$","difficulty":"Easy","source":"BITSAT 2020","_marksId":"64c0e8166f5bfc7ab78aea7c"},{"id":17255,"subject":"Chemistry","chapter":"Alcohols Phenols and Ethers","exam":"Engineering","examName":"BITSAT","q":"<p>Which of the following is/are aromatic alcohol?</p><p><img height=\"135\" src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fbitsat%252F591a1fbb-2da1-4cab-ac36-9f85554972c2-image.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2F591a1fbb-2da1-4cab-ac36-9f85554972c2-image.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2F591a1fbb-2da1-4cab-ac36-9f85554972c2-image.png?alt=media\" width=\"455\" /></p>","options":["<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>,</mo><mo> </mo><mi>II</mi><mo>,</mo><mo> </mo><mi>III</mi><mo>,</mo><mo> </mo><mi>IV</mi></math>","<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>III</mi></math>","<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>IV</mi></math>","Only <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi></math>"],"answer":1,"solution":"<p>The aromatic alcohols are those compounds in which the hydroxyl group is not directly attached to the nucleus but is linked to a carbon atom situated in a side-chain.</p><p>The compound<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mi mathvariant=\"normal\">I</mi></math> and compound<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mi>II</mi></math> are the phenols, these are not the aromatic alcohols as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mi>OH</mi></math> group is directly attached to benzene ring.</p><p>The compounds <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi><mo> </mo><mtext>and</mtext><mo> </mo><mi>III</mi></math> are benzyl alcohols and these are aromatic alcohols as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mi>OH</mi></math> group is attached to the carbon atom which itself attached to benzene ring.</p><p> </p>","difficulty":"Easy","source":"BITSAT 2019","_marksId":"64c0e8066f5bfc7ab78ae9f0"},{"id":17256,"subject":"Chemistry","chapter":"Alcohols Phenols and Ethers","exam":"Engineering","examName":"BITSAT","q":"Which of the following reactants is used for the preparation of ethyl benzene, where anhy. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>AlCl</mi><mn>3</mn></msub></math> is a catalyst?","options":["<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><mo>·</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>·</mo><mi>OH</mi><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math>","<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><mo>-</mo><mi>CH</mi><mo>=</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math>","<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">C</mi><mo>=</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math>","<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><mo>-</mo><msub><mi>CH</mi><mn>3</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math>"],"answer":2,"solution":"<p>Fridel crafts Alkylation of Benzene takes place when ALkyl halide reacted with Benzene in presence of Anhydrous <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>AlCl</mi><mn>3</mn></msub></math>​. </p><p>Now Alkenes can form Alkyl Benzene in Industrial process. The process involves the reaction of Benzene and Ethylene in presence of an Anhydrous <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>AlCl</mi><mn>3</mn></msub></math>catalyst promoted by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>HCl</mi></math>.</p><p>The <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">C</mi><mo>=</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math> on reaction produce ethyl benzene as follows</p><p><img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fbitsat%252Ff9e33fd5-2ade-48d9-87b1-ea9d74edfc6d-image.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2Ff9e33fd5-2ade-48d9-87b1-ea9d74edfc6d-image.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2Ff9e33fd5-2ade-48d9-87b1-ea9d74edfc6d-image.png?alt=media\" style=\"width: 565px; height: 189px;\" /></p>","difficulty":"Medium","source":"BITSAT 2019","_marksId":"64c0e8086f5bfc7ab78aea02"},{"id":17257,"subject":"Chemistry","chapter":"Alcohols Phenols and Ethers","exam":"Engineering","examName":"BITSAT","q":"<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fbitsat%252FukT0-8k5YGVPdc5dtHWqvLHcUzt_9MNsq0wF7JbCRwc.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2FukT0-8k5YGVPdc5dtHWqvLHcUzt_9MNsq0wF7JbCRwc.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2FukT0-8k5YGVPdc5dtHWqvLHcUzt_9MNsq0wF7JbCRwc.original.fullsize.png?alt=media\"