XwWyjcPieTaY2aLHc4.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2FUxGpTB0zlK2tNKPe8q7QtZVHOXwWyjcPieTaY2aLHc4.original.fullsize.png?alt=media\">","difficulty":"Easy","source":"BITSAT 2013","_marksId":"64c0e7b36f5bfc7ab78ae717"},{"id":17629,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Engineering","examName":"BITSAT","q":"Which of the following is not considered as an organometallic compound?","options":["cis-platin","Ferrocene","Zeise's salt","Grignard reagent"],"answer":0,"solution":"The structural formula of cis-platin is\n<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fbitsat%252F2HhDl9zEykihnvpLm1nM8qK_H2YN2VpKmNjtcXeUCP0.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2F2HhDl9zEykihnvpLm1nM8qK_H2YN2VpKmNjtcXeUCP0.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2F2HhDl9zEykihnvpLm1nM8qK_H2YN2VpKmNjtcXeUCP0.original.fullsize.png?alt=media\"><br>\nSince no carbon is involved it is not a\norganometallic compound.","difficulty":"Medium","source":"BITSAT 2011","_marksId":"64c0e7946f5bfc7ab78ae61b"},{"id":17630,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Engineering","examName":"BITSAT","q":"In which of the following conversions, phosphorus pentachloride is used as the reagent?","options":["$\\mathrm{H}_{2} \\mathrm{C}=\\mathrm{CH}_{2} \\longrightarrow \\mathrm{CH}_{3} \\mathrm{CH}_{2} \\mathrm{Cl}$","$\\mathrm{CH}_{3} \\mathrm{CH}_{2} \\mathrm{OH} \\longrightarrow \\mathrm{CH}_{3} \\mathrm{CH}_{2} \\mathrm{Cl}$","$\\mathrm{H}_{3} \\mathrm{C}-\\mathrm{O}-\\mathrm{CH}_{3} \\longrightarrow \\mathrm{CH}_{3} \\mathrm{Cl}$","$\\mathrm{CH} \\equiv \\mathrm{CH} \\longrightarrow \\mathrm{CH}_{2}=\\mathrm{CHCl}$"],"answer":1,"solution":"When ethyl alcohol is treated with $\\mathrm{PCl}_{5}$, then ethyl chloride is formed.\n\n\\begin{aligned}\n\\mathrm{CH}_{3} \\mathrm{CH}_{2}-\\mathrm{OH} &+\\mathrm{PCl}_{5} \\longrightarrow_{\\Delta} \\\\\n& \\mathrm{CH}_{3} \\mathrm{CH}_{2}-\\mathrm{Cl}+\\mathrm{HCl}+\\mathrm{POCl}_{3}\n\\end{aligned}\n","difficulty":"Easy","source":"BITSAT 2010","_marksId":"64c0e7876f5bfc7ab78ae5a0"},{"id":17631,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Engineering","examName":"BITSAT","q":"Match List I (Reaction) with List II (Reagent) and select the correct answer using the codes given below the lists:\n<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fbitsat%252F8hVpQ4ARAN3Q9tIOSzpXg0LxITwnkhyilk1Ki2kFkt0.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2F8hVpQ4ARAN3Q9tIOSzpXg0LxITwnkhyilk1Ki2kFkt0.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fbitsat%2F8hVpQ4ARAN3Q9tIOSzpXg0LxITwnkhyilk1Ki2kFkt0.original.fullsize.png?alt=media\">","options":["$\\quad \\mathrm{I}-\\mathrm{A}, \\mathrm{II}-\\mathrm{B}, \\mathrm{III}-\\mathrm{C}, \\mathrm{IV}-\\mathrm{B}$","$\\quad \\mathrm{I}-\\mathrm{D}, \\mathrm{II}-\\mathrm{C}, \\mathrm{III}-\\mathrm{A}, \\mathrm{IV}-\\mathrm{B}$","$\\quad \\mathrm{I}-\\mathrm{C}, \\mathrm{II}-\\mathrm{D}, \\mathrm{III}-\\mathrm{A}, \\mathrm{IV}-\\mathrm{B}$","$\\quad \\mathrm{I}-\\mathrm{B}, \\mathrm{II}-\\mathrm{A}, \\mathrm{III}-\\mathrm{D}, \\mathrm{IV}-\\mathrm{C}$"],"answer":2,"solution":"No Solution available","difficulty":"Hard","source":"BITSAT 2010","_marksId":"64c0e7876f5bfc7ab78ae5a1"},{"id":17632,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Engineering","examName":"BITSAT","q":"Which of the following order is not correct?","options":["$\\mathrm{MeBr}\\gt \\mathrm{Me}_{2} \\mathrm{CHBr}\\gt \\mathrm{Me}_{3} \\mathrm{CBr}\\gt \\mathrm{Et}_{3} \\mathrm{CBr}\\left(\\mathrm{S}_{\\mathrm{N}} 2\\right)$","$\\mathrm{Me}_{3} \\mathrm{CBr}\\gt \\mathrm{Me}_{2} \\mathrm{CHBr}\\gt \\mathrm{Me}_{2} \\mathrm{CH.CH}_{2} \\mathrm{Br}\\gt \\mathrm{MeCH}_{2} \\mathrm{CH}_{2} \\mathrm{CH}_{2} \\mathrm{Br} .\\left(\\mathrm{E}_{2}\\right)$","$\\mathrm{PhCH}_{2} \\mathrm{Br}\\gt \\mathrm{Ph} \\mathrm{CHBrMe}\\gt \\mathrm{PhCBrMe}_{2}\\gt \\operatorname{PhCBrMePh}\\left(\\mathrm{S}_{\\mathrm{N}} 1\\right)$","$\\mathrm{MeI}\\gt \\mathrm{MeBr}\\gt \\mathrm{MeCl}\\gt \\mathrm{MeF}\\left(\\mathrm{S}_{\\mathrm{N}} 2\\right)$"],"answer":2,"solution":"The more is the stability of intermediate carbonium ion, the more is the chance of $\\mathrm{S}_{\\mathrm{N}} 1$ mechanism. The intermediates obtained will be \n$\\mathrm{Ph}^{+} \\mathrm{C} \\mathrm{H}_{2}(\\mathrm{i}), \\mathrm{Ph} \\mathrm{C} \\mathrm{H}-\\mathrm{Me}(\\mathrm{ii})\\mathrm{Ph} \\mathrm{C}-\\mathrm{Me}_{2}\\left(\\right.$ iii) $, \\mathrm{Ph} \\mathrm{C}^{+} \\mathrm{MePh}$ (iv)\nThe stabilty is of the order iv $\\gt \\mathrm{iii}\\gt \\mathrm{ii}\\gt \\mathrm{i}$","difficulty":"Hard","source":"BITSAT 2009","_marksId":"64c0e7796f5bfc7ab78ae522"}]}