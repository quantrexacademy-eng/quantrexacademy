c{5}{2}\\right), E \\rightarrow\\left(3, \\frac{7}{2}\\right)\n\\end{array}\n$<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fkvpy%252FfpQU9zxEPR5T3ySAVGazcfcoH_RrBwLwFwAGmCW2Gy4.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2FfpQU9zxEPR5T3ySAVGazcfcoH_RrBwLwFwAGmCW2Gy4.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2FfpQU9zxEPR5T3ySAVGazcfcoH_RrBwLwFwAGmCW2Gy4.original.fullsize.png?alt=media\">$ \\\\ \narea under $f(x)=4\\begin{aligned} \\text { shaded area } &=\\text { area of trapezium DEFG }-\\text { area under } \\mathrm{f}(\\mathrm{x}) \\\\ &=\\frac{1}{2}\\left(\\frac{5}{2}+\\frac{7}{2}\\right) \\times 2-4 \\\\ &=6-4=2 \\end{aligned}$","difficulty":"Medium","source":"KVPY 2010 (SB/SX)","_marksId":"6174d21336851702e1c427d7"},{"id":51516,"subject":"Mathematics","chapter":"Area Under Curves","exam":"Engineering","examName":"KVPY","q":"The area bounded by the curve $y=\\frac{1}{4}\\left|4-x^{2}\\right|$ and $y=7-|x|$ is","options":["18","32","36","64"],"answer":1,"solution":"<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fkvpy%252F6fq40cy3D5P1m6NJR0uaCfEriOKzNkovS79RUE-aNXY.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2F6fq40cy3D5P1m6NJR0uaCfEriOKzNkovS79RUE-aNXY.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2F