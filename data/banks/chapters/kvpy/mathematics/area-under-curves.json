A</mi><mn>1</mn></msub></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\"><msub><mi>A</mi><mn>2</mn></msub></mfenced><mo><</mo><mfenced open=\"|\" close=\"|\"><msub><mi>A</mi><mn>3</mn></msub></mfenced></math>","<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\"><msub><mi>A</mi><mn>1</mn></msub></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\"><msub><mi>A</mi><mn>3</mn></msub></mfenced><mo>></mo><mfenced open=\"|\" close=\"|\"><msub><mi>A</mi><mn>2</mn></msub></mfenced></math>"],"answer":2,"solution":"<p>Area of region defined by </p>\n<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>A</mi><mn>1</mn></msub><mo>=</mo><mfenced close=\"}\" open=\"{\"><mtable columnalign=\"right\"><mtr><mtd><mo>(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>)</mo><mo>:</mo><mi>x</mi><mo>≥</mo><mn>0</mn><mo>,</mo><mi>y</mi><mo>≥</mo><mn>0</mn><mo>,</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd><mo>-</mo><msup><mi>y</mi><mn>2</mn></msup><mo>></mo><mn>1</mn><mo>></mo><mi>x</mi><mo>+</mo><mi>y</mi></mtd></mtr></mtable></mfenced></math> is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><msub><mi>A</mi><mn>1</mn></msub></mfenced></math>.</p>\n<p><img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fkvpy%252Ff290bd64-480a-46cb-bf28-e237e195506d-image.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2Ff290bd64-480a-46cb-bf28-e237e195506d-image.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2Ff290bd64-480a-46cb-bf28-e237e195506d-image.png?alt=media\"/></p>\n<p>Similarly, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><msub><mi>A</mi><mn>2</mn></msub></mfenced></math> is the area of region defined by </p>\n<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>A</mi><mn>2</mn></msub><mo>=</mo><mfenced close=\"}\" open=\"{\"><mrow><mfenced><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></mfenced><mo>:</mo><mi>x</mi><mo>≥</mo><mn>0</mn><mo>,</mo><mi>y</mi><mo>≥</mo><mn>0</mn><mo>,</mo><mi>x</mi><mo>+</mo><mi>y</mi><mo>></mo><mn>1</mn><mo>></mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup></mrow></mfenced></math></p>\n<p>Here, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><msub><mi>A</mi><mn>1</mn></msub></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\"><msub><mi>A</mi><mn>2</mn></msub></mfenced></math></p>\n<p><img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fkvpy%252Fcd1d38fa-93b0-40a8-ad81-0edf5cf8bdbb-image.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2Fcd1d38fa-93b0-40a8-ad81-0edf5cf8bdbb-image.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2Fcd1d38fa-93b0-40a8-ad81-0edf5cf8bdbb-image.png?alt=media\"/></p>\n<p>and area <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><msub><mi>A</mi><mn>3</mn></msub></mfenced></math> is the area of region defined by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>A</mi><mn>3</mn></msub><mo>=</mo><mfenced close=\"}\" open=\"{\"><mrow><mfenced><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></mfenced><mo>:</mo><mi>x</mi><mo>≥</mo><mn>0</mn><mo>,</mo><mi>y</mi><mo>≥</mo><mn>0</mn><mo>,</mo><mi>x</mi><mo>+</mo><mi>y</mi><mo>></mo><mn>1</mn><mo>></mo><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><msup><mi>y</mi><mn>3</mn></msup></mrow></mfenced></math><br/>\nthen <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><msub><mi>A</mi><mn>3</mn></msub></mfenced><mo>></mo><mfenced close=\"|\" open=\"|\"><msub><mi>A</mi><mn>2</mn></msub></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\"><msub><mi>A</mi><mn>1</mn></msub></mfenced></math></p>\n<p><img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fkvpy%252F725dd6b5-a6a2-4718-80ed-e7eeffbe5042-image.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2F725dd6b5-a6a2-4718-80ed-e7eeffbe5042-image.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2F725dd6b5-a6a2-4718-80ed-e7eeffbe5042-image.png?alt=media\"/></p>","difficulty":"Medium","source":"KVPY 2019 (SB/SX)","_marksId":"614da7089366ef096baadf93"},{"id":51520,"subject":"Mathematics","chapter":"Area Under Curves","exam":"Engineering","examName":"KVPY","q":"Consider the regions $\\mathrm{A}=\\left\\{(\\mathrm{x}, \\mathrm{y}) \\mid \\mathrm{x}^{2}+\\mathrm{y}^{2} \\leq 100\\right\\}$ and $=\\{(\\mathrm{x}, \\mathrm{y}) \\mid \\sin (\\mathrm{x}+\\mathrm{y})\\gt 0\\}$ in the plane. Then the area of the region $\\mathrm{A} \\cap \\mathrm{B}$ is-","options":["$10 \\pi$","100","$100 \\pi$","$50 \\pi$"],"answer":3,"solution":"$\\quad \\mathrm{x}^{2}+\\mathrm{y}^{2} \\leq 100 \\rightarrow$ inside of a circle\n\n\\begin{array}{l}\n\\sin (x+y)>0 \\\\\nx+y \\in(0, \\pi) \\cup(2 \\pi, 3 \\pi) \\ldots \\ldots \\\\\nx+y=c \\rightarrow \\text { equation of a line }\n\\end{array}\n$<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app