xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mi>n</mi></msub><mo>=</mo><munderover><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><msup><mi>k</mi><mo>'</mo></msup></msqrt></mfrac><mo> </mo><mtext> for </mtext><mi>n</mi><mo>≥</mo><mn>1</mn></math><br />\nThen <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>n</mi><mo>→</mo><mo>∞</mo></mrow></munder><msub><mi mathvariant=\"normal\">s</mi><mi>n</mi></msub></math>","options":["does not exist","exists and lies in the interval <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>)</mo></math>","exists and lies in the interval <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>[</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>)</mo></math>","exists and lies in the interval <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>[</mo><mn>2</mn><mo>,</mo><mo>∞</mo><mo>)</mo></math>"],"answer":2,"solution":"Since, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mi>n</mi></msqrt></mfrac><mo>≤</mo><munderover><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mi>k</mi></msqrt></mfrac><mo>≤</mo><munderover><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>0</mn></msqrt></mfrac></math><br />\n<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><munder><mi>lim</mi><mrow><mi>n</mi><mo>→</mo><mo>∞</mo></mrow></munder><mfrac><mi>n</mi><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mi>n</mi></msqrt></mfrac><mo>≤</mo><munder><mi>lim</mi><mrow><mi>n</mi><mo>→</mo><mo>∞</mo></mrow></munder><msub><mi>S</mi><mi>n</mi></msub><mo>≤</mo><munder><mi>lim</mi><mrow><mi>n</mi><mo>→</mo><mo>∞</mo></mrow></munder><mfrac><mi>n</mi><msqrt><msup><mi>n</mi><mn>2</mn></msup></msqrt></mfrac></math><br />\n<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mn>1</mn><mo>≤</mo><munder><mi>lim</mi><mrow><mi>n</mi><mo>→</mo><mo>∞</mo></mrow></munder><msub><mi>S</mi><mi>n</mi></msub><mo>≤</mo><mn>1</mn></math><br />\n<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><munder><mi>lim</mi><mrow><mi>n</mi><mo>→</mo><mo>∞</mo></mrow></munder><msub><mi>S</mi><mi>n</mi></msub><mo>≤</mo><mn>1</mn></math>","difficulty":"Medium","source":"KVPY 2020 (SB/SX)","_marksId":"614da75111e47d9d9c59377a"},{"id":51717,"subject":"Mathematics","chapter":"Limits","exam":"Engineering","examName":"KVPY","q":"Let $\\mathrm{n}$ be the smallest positive integer such that $1+\\frac{1}{2}+\\frac{1}{3}+\\ldots \\ldots+\\frac{1}{\\mathrm{n}} \\geq 4$\nWhich one of the following statements is true?","options":["$20 \\lt  \\mathrm{n} \\leq 60$","$60 \\lt  \\mathrm{n} \\leq 80$","$80 \\lt  \\mathrm{n} \\leq 100$","$100 \\lt  \\mathrm{n} \\leq 120$"],"answer":0,"solution":"$\\begin{array}{l}\n1+x \\lt  1+x+\\frac{x^{2}}{2 !}+\\frac{x^{3}}{3 !}+\\ldots \\ldots \\ldots \\\\\n1+x \\lt  e^{x}\n\\end{array}\n$\\ln (1+x) < x\\mathrm{x}=\\frac{1}{\\mathrm{y}}\\ln \\left(1+\\frac{1}{y}\\right) < \\frac{1}{y}\\ln (y+1)-\\ln y < \\frac{1}{y}$\nput $\\mathrm{y}=1\\ln (2)-\\ln (1) < \\frac{1}{1}$\nput $=y=2\\ln 3-\\ln 2 < \\frac{1}{2}$\nput $=y=3\\ln 4-\\ln 3 < \\frac{1}{3}$\nput $y=n\\ln (n+1)-\\ln n < \\frac{1}{4}\\ln (n+1)-\\ln (1) < 1+\\frac{1}{2}+\\frac{1}{3}+\\ldots \\frac{1}{n}\\ln (n+1) \\leq 4n \\leq e^{4}-1n \\leq 60","difficulty":"Medium","source":"KVPY 2017 (19 Nov SB/SX)","_marksId":"6174d213dd2d1eeece4c60f6"},{"id":51718,"subject":"Mathematics","chapter":"Limits","exam":"Engineering","examName":"KVPY","q":"The value of the limit\n\n\\lim _{x \\rightarrow 0}\\left(\\frac{x}{\\sin x}\\right)^{6 / x^{2}}\n\nis","options":["e","$\\mathrm{e}^{-1}$","$\\mathrm{e}^{-1 / 6}$","$\\mathrm{e}^{6}$"],"answer":0,"solution":"$\\lim _{x \\rightarrow 0}\\left(\\frac{x}{\\sin x}\\right)^{6 / x^{2}}e^{\\lim _{x \\rightarrow 0} \\frac{6}{x^{2}}\\left(\\frac{x-\\sin x}{\\sin }\\right)}\\lim _{x \\rightarrow 0} \\frac{6}{x^{2}}\\left(\\frac{x-\\left(x-\\frac{x^{3}}{3}\\right)}{x}\\right)=\\mathrm{e}$","difficulty":"Medium","source":"KVPY 2015 (SB/SX)","_marksId":"6174d21377779adb0b55c2ab"},{"id":51719,"subject":"Mathematics","chapter":"Limits","exam":"Engineering","examName":"KVPY","q":"Let $f: R \\rightarrow R$ be a function such that $\\lim _{x \\rightarrow \\infty} f(x)=M\\gt 0$. Then which of the following is false?","options":["$\\lim _{x \\rightarrow \\infty} x \\sin (1 / x) f(x)=M$","$\\lim _{x \\rightarrow \\infty} \\sin (f(x))=\\sin M$","$\\lim _{x \\rightarrow \\infty} x \\sin \\left(e^{-x}\\right) f(x)=M$","$\\lim _{x \\rightarrow \\infty} \\frac{\\sin x}{x} \\cdot f(x)=0$"],"answer":2,"solution":"$\\lim _{x \\rightarrow \\infty} x \\sin \\left(e^{-x}\\right) f(x)=\\lim _{x \\rightarrow \\infty} \\frac{\\sin \\left(e^{-x}\\right)}{e^{-x}} \\frac{x}{e^{x}} f(x)=1 \\times(0) \\times M=0$","difficulty":"Medium","source":"KVPY 2013 (SB/SX)","_marksId":"6174d2132cb1308dc265f498"},{"id":51720,"subject":"Mathematics","chapter":"Limits","exam":"Engineering","examName":"KVPY","q":"Let $\\mathrm{x}_{\\mathrm{n}}=\\left(2^{\\mathrm{n}}+3^{\\mathrm{n}}\\right)^{1 / 2 \\mathrm{n}}$ for all natural numbers $\\mathrm{n}$. Then","options":["$\\lim _{n \\rightarrow \\infty} x_{n}=\\infty$","$\\lim _{n \\rightarrow \\infty} x_{n}=\\sqrt{3}$","$\\lim _{n \\rightarrow \\infty} x_{n}=\\sqrt{3}+\\sqrt{2}$","$\\lim _{n \\rightarrow \\infty} x_{n}=\\sqrt{5}$"],"answer":1,"solution":"$\\lim _{n \\rightarrow \\infty}\\left(3^{n}\\right)^{1 / 2 n}\\left(\\left(\\frac{2}{3}\\right)^{n}+1\\right)^{1 / 2 n}$\nPut $\\lim _{n \\rightarrow \\infty} \\sqrt{3}$","difficulty":"Medium","source":"KVPY 2017 (5 Nov SB/SX)","_marksId":"6174d213c502a176b93c9894"}]}