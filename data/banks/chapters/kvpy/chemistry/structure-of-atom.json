0-ad4c-9cafbfde0914-image.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2Fcfb2c74f-17b9-49f0-ad4c-9cafbfde0914-image.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fkvpy%2Fcfb2c74f-17b9-49f0-ad4c-9cafbfde0914-image.png?alt=media\"/>"],"answer":1,"solution":"The ideal body which emits and adsorbs radiations of all frequencies is called a black body and the radiation emitted by such a body is called black body radiation. The exact frequency distribution of the emitted radiation from black body depends only on its temperature. At a given temperature intensity of radiation emitted increases with decrease of wavelength, reaches a maximum value at a given wavelength and then starts decreasing with further decrease of wavelength.","difficulty":"Medium","source":"KVPY 2018 (SB/SX)","_marksId":"614da68c84bf1eb10e7a46aa"},{"id":51443,"subject":"Chemistry","chapter":"Structure of Atom","exam":"Engineering","examName":"KVPY","q":"The correct statements among the following. i. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>E</mi><mrow><mn>2</mn><mi>s</mi></mrow></msub><mo>(</mo><mi mathvariant=\"normal\">H</mi><mo>)</mo><mo>></mo><msub><mi>E</mi><mrow><mn>2</mn><mi>s</mi></mrow></msub><mo>(</mo><mi>Li</mi><mo>)</mo><mo><</mo><msub><mi>E</mi><mrow><mn>2</mn><mi>s</mi></mrow></msub><mo>(</mo><mi>Na</mi><mo>)</mo><mo>></mo><msub><mi>E</mi><mrow><mn>2</mn><mi>δ</mi></mrow></msub><mo>(</mo><mi mathvariant=\"normal\">K</mi><mo>)</mo></math><br />\nii. The maximum number of electrons in the shell with principal quantum number <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> is equal to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msup><mi>n</mi><mn>2</mn></msup></math><br />\niii. Extra stability of half-filled subshell is due to smaller exchange energy.<br />\niv. Only two electrons, irrespective of their spin, may exist in the same orbital are.<br />\n ","options":["i and ii<br />\n ","ii and iii<br />\n ","iii and iv<br />\n ","<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">i</mi></math> and iv"],"answer":0,"solution":"(i) Energy of the 2sorbital of different elements decreases as nuclear charge (equal to atomic number) of atom increases.<br />\n(ii) There are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>n</mi><mn>2</mn></msup></math> orbitals in a shell with principal quantum number <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>. $\\therefore$ total number of electrons <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>2</mn><msup><mi>n</mi><mn>2</mn></msup></math>.<br />\n(iii) Extra stability of half-fillec. urbitals is due to greater exchange energy.<br />\n(iv) For two electrons will be in the same orbital, their spin quantum numbers must be different.<br />\nIt is not irrespective of their spin.","difficulty":"Medium","source":"KVPY 2019 (SA)","_marksId":"614da48632c85ac2fef95fa4"},{"id":51444,"subject":"Chemistry","chapter":"Structure of Atom","exam":"Engineering","examName":"KVPY","q":"A $20 \\mathrm{~g}$ object is moving with velocity $100 \\mathrm{~ms}^{-1}$. The de Broglie wavelength (in $\\mathrm{m}$ ) of the object is [Planck's constant $\\left.\\mathrm{h}=6.626 \\times 10^{-34} \\mathrm{~J} \\mathrm{~s}\\right]$","options":["$3.313 \\times 10^{-34}$","$6.626 \\times 10^{-34}$","$3.313 \\times 10^{-31}$","$6.626 \\times 10^{-31}$"],"answer":0,"solution":"$\\lambda=\\frac{h}{m v}=\\frac{6.626 \\times 10^{-31}}{20 \\times 10^{-3} \\times 100}=3.313 \\times 10^{-34}$","difficulty":"Medium","source":"KVPY 2017 (5 Nov SA)","_marksId":"6174d21326e600ba6620d77e"},{"id":51445,"subject":"Chemistry","chapter":"Structure of Atom","exam":"Engineering","examName":"KVPY","q":"Among the following, the correct statement about cathode ray discharge tube is<br />\n<br />\n ","options":[" the electrical discharge can only be observed at high pressure and at low voltage.","in the absence of external electrical or magnetic field, cathode rays travel in straight lines.<br />\n ","the characteristics of cathode rays depend upon the material of electrodes.<br />\n ","the characteristics of cathode rays depend upon the gas present in the cathode ray tube."],"answer":1,"solution":"Cathode ray is observed only at low pressure and high voltage, which travel in straight line in the absence of electrical and magnetic fields. Characteristics of cathode rays are independent of the material of electrode or the gas present in the tube.","difficulty":"Medium","source":"KVPY 2019 (SA)","_marksId":"614da48666f3aa184957d48a"},{"id":51446,"subject":"Chemistry","chapter":"Structure of Atom","exam":"Engineering","examName":"KVPY","q":"For a $4 p$ orbital, the number of radial and angular nodes, respectively, are","options":["3,2","1,2","2,4","2,1"],"answer":3,"solution":"no. of radial node $=\\mathrm{n}-\\ell-1=4-1-1=2$\nno. of angular node $=\\ell=1$","difficulty":"Medium","source":"KVPY 2017 (5 Nov SB/SX)","_marksId":"6174d213017e4ee4d2cfad72"},{"id":51447,"subject":"Chemistry","chapter":"Structure of Atom","exam":"Engineering","examName":"KVPY","q":"The metal ion with total number of electrons same as $S^{2}$ is","options":["$\\mathrm{N}^{\\mathrm{a}+}$","$\\mathrm{Ca}^{2+}$","$\\mathrm{Mg}^{2+}$","$\\mathrm{Sr}^{2+}$"],"answer":1,"solution":"$\\mathrm{S}^{-2}$ has 18 electrons $\\&$ so $\\mathrm{Ca}^{+2}$ ion are having","difficulty":"Medium","source":"KVPY 2017 (5 Nov SA)","_marksId":"6174d2137843f0763f44d730"},{"id":51448,"subject":"Chemistry","chapter":"Structure of Atom","exam":"Engineering","examName":"KVPY","q":"$\\mathrm{C}_{60}$ emerging from a source at a speed (v) has a de Broglie wavelength of $11.0 Å$. The value of $\\mathrm{v}\\left(\\mathrm{inm} \\mathrm{s}^{-1}\\right.$ ) is closest to\n[Planck's constant $\\left.h=6.626 \\times 10^{-34} \\mathrm{~J} \\mathrm{~s}\\right]$","options":["$0.5$","$2.5$","$5.0$","30"],"answer":0,"solution":"$\\lambda=\\frac{\\mathrm{h}}{\\mathrm{mv}} \\Rightarrow \\mathrm{v}=\\frac{\\mathrm{h}}{\\mathrm{m} \\cdot \\lambda}=\\frac{6.62 \\times 10^{-34}}{720 \\times 10^{-3} \\times 11 \\times 10^{-10}}$","difficulty":"Medium","source":"KVPY 2017 (19 Nov SA)","_marksId":"6174d2133aad5a52ade691d6"},{"id":51449,"subject":"Chemistry","chapter":"Structure of Atom","exam":"Engineering","examName":"KVPY","q":"In the nuclear reaction ${ }_{90}^{23} \\mathrm{Th} \\rightarrow{ }_{91}^{234} \\mathrm{~Pa}+\\mathrm{X} . \\mathrm{X}$ is-","options":["${ }_{-1}^{0} \\mathrm{e}$","${ }_{1}^{0} \\mathrm{e}$","$\\mathrm{H}$","${ }_{1}^{2} \\mathrm{H}$"],"answer":0,"solution":"${ }_{90}^{234} \\mathrm{Th} \\longrightarrow{ }_{91}^{234} \\mathrm{~Pa}+_{-1} \\mathrm{e}^{0}$","difficulty":"Medium","source":"KVPY 2010 (SB/SX)","_marksId":"6174d21332462d751d651def"}]}