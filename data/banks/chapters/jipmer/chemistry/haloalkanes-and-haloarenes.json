.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2F8wQv6ZV2IjIBuw0QuyrPDvvgJMAAoNtKTggf5b-MX0E.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2F8wQv6ZV2IjIBuw0QuyrPDvvgJMAAoNtKTggf5b-MX0E.original.fullsize.png?alt=media\"/><br/>","difficulty":"Medium","source":"JIPMER 2018","_marksId":"66d58650a75f05ee8564ff94","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]},{"id":45694,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Medical","examName":"JIPMER","q":"$\\mathrm{CH}_3-\\mathrm{CH}_2-\\mathrm{CH}_2-\\mathrm{Br} \\xrightarrow{\\text { Alc. } \\mathrm{KOH}}$ Final product is","options":["propene","propanol","cyclopropane","propane-1, 2-diol"],"answer":0,"solution":"When haloalkane containing $\\beta$-hydrogen atom is heated with alc. KOH solution, then alkene is formed\n$\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{CH}_2 \\mathrm{Br} \\xrightarrow{\\text { alc. } \\mathrm{KOH}} \\mathrm{CH}_3 - \\underset{\\text { Propene }}{\\mathrm{CH}}=\\mathrm{CH}_2$\nIn this reaction, hydrogen is elimated from $\\beta$-carbon and the halogen is lost from $\\alpha$-carbon atom. As a result, an alkene is formed as a product.\nDue to the involvement of elimination of $\\beta$ -hydrogen atom, the process is often called $\\beta$-elimination.","difficulty":"Easy","source":"JIPMER 2019","_marksId":"66d5865ea75f05ee85650011","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]},{"id":45695,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Medical","examName":"JIPMER","q":"$t$-butyl chloride preferably undergo hydrolysis by","options":["$\\mathrm{S}_{\\mathrm{N}} 1$ mechanism","$\\mathrm{S}_{\\mathrm{N}} 2$ mechanism","Any of (a) and (b)","None of these"],"answer":0,"solution":"Tertiary halide preferentially undergo $\\mathrm{S}_{\\mathrm{N}} 1$ substitution as they can give stable carbocation.\n<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fjipmer%252FmpUGs6wcNGx7rIHUJkWBTsYy8tRabs6eTwlv06uoPM4.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2FmpUGs6wcNGx7rIHUJkWBTsYy8tRabs6eTwlv06uoPM4.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2FmpUGs6wcNGx7rIHUJkWBTsYy8tRabs6eTwlv06uoPM4.original.fullsize.png?alt=media\"/><br/>","difficulty":"Easy","source":"JIPMER 2009","_marksId":"66d585a7a75f05ee8564f976","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]},{"id":45696,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Medical","examName":"JIPMER","q":"$\\mathrm{CH}_3 \\mathrm{CHCl}_2$, on hydrolysis, will give","options":["$\\mathrm{CH}_3 \\mathrm{CHO}$","$\\mathrm{CH}_3 \\mathrm{COOH}$","$\\mathrm{CHCl}_3$","$\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{OH}$"],"answer":0,"solution":"gem dihalides, on hydrolysis, give carbonyl compounds\n<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fjipmer%252FVm2rtqDdC9FHRYY3-TqCwm6CoTmPisou4g5TENXGv5s.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2FVm2rtqDdC9FHRYY3-TqCwm6CoTmPisou4g5TENXGv5s.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2FVm2rtqDdC9FHRYY3-TqCwm6CoTmPisou4g5TENXGv5s.original.fullsize.png?alt=media\"/><br/>","difficulty":"Medium","source":"JIPMER 2004","_marksId":"66d58540a75f05ee8564f5ac","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]},{"id":45697,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Medical","examName":"JIPMER","q":"Iodoform gives a precipitate with $\\mathrm{AgNO}_3$ on heating but chloroform does not because","options":["C - I bond in iodoform is weak and $\\mathrm{C}-\\mathrm{Cl}$ bond in chloroform is strong","chloroform is covalent","iodoform is ionic","None of the above"],"answer":0,"solution":"On heating $\\mathrm{C}-\\mathrm{I}$ bond in $\\mathrm{CHI}_3$ breaks, but $\\mathrm{C}-\\mathrm{Cl}$ bond in $\\mathrm{CHCl}_3$ does not break. Thus, $\\mathrm{AgNO}_3$ gives precipitate AgI with iodoform.","difficulty":"Easy","source":"JIPMER 2009","_marksId":"66d585a8a75f05ee8564f97d","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]},{"id":45698,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Medical","examName":"JIPMER","q":"When 2-methyl butyl bromide is treated with sodium ethoxide in ethanol, what will be the major product?","options":["2-methyl but-2-ene","3-methyl but-1-ene","2-methyl but-1-ene","2-methyl sodium-butoxide"],"answer":0,"solution":"When 2-methyl butyl bromide is treated with sodium ethoxide in ethanol, two alkenes are possible. The more substituted alkene, i.e. 2-methyl-2-butene is the major product.\n<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fjipmer%252F8h4L4CV4NTbtN12soaTHjBJKBjl84WTh64kYrtDI3rE.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2F8h4L4CV4NTbtN12soaTHjBJKBjl84WTh64kYrtDI3rE.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2F8h4L4CV4NTbtN12soaTHjBJKBjl84WTh64kYrtDI3rE.original.fullsize.png?alt=media\"/><br/><img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fjipmer%252Fkf-KFq_zM58gFluYCWyAO7D9wu9M3fzPbKxLBeECIhY.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2Fkf-KFq_zM58gFluYCWyAO7D9wu9M3fzPbKxLBeECIhY.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2Fkf-KFq_zM58gFluYCWyAO7D9wu9M3fzPbKxLBeECIhY.original.fullsize.png?alt=media\"/><br/>","difficulty":"Medium","source":"JIPMER 2016","_marksId":"66d58624a75f05ee8564fdf8","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]},{"id":45699,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Medical","examName":"JIPMER","q":"Among the following, the suitable reagent for Wurtz reaction is","options":["Na /alcohol","Na /ether","Zn/ether","Zn/alcohol"],"answer":1,"solution":"The suitable reagent for Wurtz reaction is $\\mathrm{Na} /$ ether. An ethereal solution of an alkyl halide is treated with sodium to produce higher alkanes. This reaction involves the formation of new $\\mathrm{C}-\\mathrm{C}$ bond. e.g.\n$\\underset{\\text { Ethyl bromide }}{\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{Br}+2 \\mathrm{Na}}+\\mathrm{CH}_3 \\mathrm{Br} \\xrightarrow{\\text { Ether }} \\underset{\\text { Propane }}{\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{CH}_3}$","difficulty":"Easy","source":"JIPMER 2018","_marksId":"66d58650a75f05ee8564ff8d","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]},{"id":45700,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Medical","examName":"JIPMER","q":"The best method for the conversion of an alcohol into an alkyl chloride is by treating the alcohol with","options":["$\\mathrm{PCl}_3$","$\\mathrm{PCl}_5$","$\\mathrm{SOCl}_2$ in presence of pyridine","dry HCl in the presence of anhydrous $\\mathrm{ZnCl}_2$"],"answer":2,"solution":"The best method for the conversion of an alcohol into an alkyl chloride is by treating the alcohol with $\\mathrm{SOCl}_2$ in the presence of pyridine.\n$R \\mathrm{OH}+\\mathrm{SOCl}_2 \\longrightarrow R \\mathrm{Cl}+\\mathrm{HCl}+\\mathrm{SO}_2$\nThe other products being gases escape leaving behind pure alkyl halide.","difficulty":"Medium","source":"JIPMER 2011","_marksId":"66d585cba75f05ee8564fabb","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]},{"id":45701,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Medical","examName":"JIPMER","q":"$R-\\mathrm{CH}_2-\\mathrm{CH}_2-\\mathrm{OH}$ can be converted into $R \\mathrm{CH}_2 \\mathrm{CH}_2 \\mathrm{COOH}$ by the following sequence of steps.","options":["$\\mathrm{PBr}_3, \\mathrm{KCN}, \\mathrm{H}_2 / \\mathrm{Pt}$","$\\mathrm{PBr}_3, \\mathrm{KCN}, \\mathrm{H}_3 \\mathrm{O}^{+}$","$\\mathrm{HCN}, \\mathrm{PBr}_3, \\mathrm{H}_3 \\mathrm{O}^{+}$","$\\mathrm{KCN}, \\mathrm{H}_3 \\mathrm{O}^{+}$"],"answer":1,"solution":"<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fjipmer%252FDws3wrdSfXUsJIe-wKw55AHc7Pifct8h89wSJtL8-zg.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2FDws3wrdSfXUsJIe-wKw55AHc7Pifct8h89wSJtL8-zg.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2FDws3wrdSfXUsJIe-wKw55AHc7Pifct8h89wSJtL8-zg.original.fullsize.png?alt=media\"/><br/>","difficulty":"Medium","source":"JIPMER 2015","_marksId":"66d58613a75f05ee8564fd59","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]},{"id":45702,"subject":"Chemistry","chapter":"Haloalkanes and Haloarenes","exam":"Medical","examName":"JIPMER","q":"<img src=\"/api/proxy-image?url=https%3A%2F%2Ffirebasestorage.googleapis.com%2Fv0%2Fb%2Fquantrexacademy-app.firebasestorage.app%2Fo%2Fquestions%252Ffigs%252Fpyq%252Fjipmer%252FqUPsHI6x8y909AYlmeYJOSoMYUZnGLWZCVRpHiiPzFA.original.fullsize.png%3Falt%3Dmedia&clean=1&v=wm2\" data-qx-orig-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2FqUPsHI6x8y909AYlmeYJOSoMYUZnGLWZCVRpHiiPzFA.original.fullsize.png?alt=media\" data-qx-storage-src=\"https://firebasestorage.googleapis.com/v0/b/quantrexacademy-app.firebasestorage.app/o/questions%2Ffigs%2Fpyq%2Fjipmer%2FqUPsHI6x8y909AYlmeYJOSoMYUZnGLWZCVRpHiiPzFA.original.fullsize.png?alt=media\"/>\nThe above reaction is known as","options":["aromatisation","pyrolysis","isomerisation","oxidation"],"answer":2,"solution":"$n$-alkanes, in presence of anhy. $\\mathrm{AlCl}_3 / \\mathrm{HCl}$ undergo isomerisation to form branched chain alkanes.","difficulty":"Medium","source":"JIPMER 2013","_marksId":"66d585eba75f05ee8564fbeb","questionType":"singleCorrect","type":"singleCorrect","_repairLog":["medical_cache_enrich"]}]}