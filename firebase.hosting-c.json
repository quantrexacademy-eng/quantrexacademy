{
  "hosting": {
    "public": "C:/Users/Admin/qx-hosting",
    "ignore": [
      "firebase.json",
      "firebase.hosting-fast.json",
      "firebase.hosting-c.json",
      "**/.*",
      "data/clean_shards/**",
      "**/.vercel/**",
      "**/node_modules/**",
      "**/*.py",
      "**/*.ps1",
      "**/*.bat",
      "**/package-lock.json"
    ],
    "headers": [
      {
        "source": "**/*.{js,css}",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
        ]
      },
      {
        "source": "**/*.{svg,png,jpg,jpeg,webp,woff,woff2,ico}",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "data/**/*.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/marks/question", "function": "marksQuestion" },
      { "source": "/api/proxy-image", "function": "proxyImage" },
      { "source": "/api/restore-image", "function": "proxyImage" },
      { "source": "/login", "destination": "/login.html" },
      { "source": "/app", "destination": "/app.html" },
      { "source": "/dashboard", "destination": "/app.html" }
    ]
  }
}