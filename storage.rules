rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Profile photos — user uploads own, public read
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // PDFs & book assets — logged-in users read, admin write via console
    match /pdfs/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /books/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // General images — public read
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /figures/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /questions/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /notes/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /formulae/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Teacher PDF folder — teachers upload, signed-in users read
    match /teacher_pdfs/{teacherId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(teacherId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isOwner(teacherId);
    }

    // Teacher video uploads — short lecture clips
    match /teacher_videos/{teacherId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(teacherId)
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if isOwner(teacherId);
    }
  }
}